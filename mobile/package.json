  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "react-dom": "19.2.3"
  },
  "_comentario_react_dom": "react-dom só serve aos testes de componente e exige a MESMA versão do react, que aqui é fixada pelo Expo. Antes vinha hoisteado da raiz; sem workspace, tem que ser pinado à mão junto com o react.",
  "scripts": {
    "start": "npm run i18n:compile && expo start",
    "android": "npm run i18n:compile && expo run:android",
    "ios": "npm run i18n:compile && expo run:ios",
    "//eas-build-post-install": "Hook do EAS, roda depois do install e ANTES do bundle. Sem ele o build falha em 'Unable to resolve module .../paraglide/messages': as pastas paraglide são GERADAS e gitignored, e o EAS copia só o que o git rastreia. Os outros scripts que compilam o i18n (test, pretypecheck, android) não são chamados por ele. São DUAS: a do app e a do @hangar/core, que o app importa — sem a segunda o bundle quebra em packages/core/src/plan.ts.",
    "eas-build-post-install": "npm run i18n:compile:core && npm run i18n:compile",
    "i18n:compile:core": "paraglide-js compile --project ../project.inlang --outdir ../packages/core/src/paraglide --strategy baseLocale",
    "web": "expo start --web",
    "pretypecheck": "npm run i18n:compile",
    "typecheck": "flock -w 900 /tmp/hangar-verificacao.lock tsc --noEmit",
    "test": "npm run i18n:compile && flock -w 900 /tmp/hangar-verificacao.lock vitest run",
    "i18n:compile": "paraglide-js compile --project ../project.inlang --outdir ./src/paraglide --strategy baseLocale",
    "prebuild": "expo prebuild --platform android"
  },
  "private": true
}

{
  "expo": {
    "name": "Hangar",
    "slug": "hangar",
    "scheme": "hangar",
    "version": "0.1.0",
    "runtimeVersion": "native-4",
    "updates": {
      "url": "https://u.expo.dev/9fd06001-323e-4b82-835f-6dfc3674236d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.hangar.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSLocalNetworkUsageDescription": "Conecta ao seu servidor Hangar na rede local.",
        "NSCameraUsageDescription": "Lê o QR de pareamento do servidor e tira fotos para anexar na conversa.",
        "NSMicrophoneUsageDescription": "Grava o ditado pro composer e usa o microfone nas chamadas de voz ao vivo.",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleDevelopmentRegion": "pt-BR",
        "CFBundleLocalizations": [
          "pt-BR",
          "en"
        ],
        "NSPhotoLibraryUsageDescription": "Mostra suas fotos recentes para anexar na conversa.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      }
    },
    "android": {
      "package": "com.hangar.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "*.ts.net",
              "port": "8443",
              "pathPrefix": "/convite/"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#141617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "Grava o ditado pro composer e usa o microfone nas chamadas de voz ao vivo.",
          "enableBackgroundRecording": true
        }
      ],
      "./plugins/withoutApsEnvironment",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Mostra suas fotos recentes para anexar na conversa.",
          "savePhotosPermission": "Salva imagens da conversa nas suas fotos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Lê o QR de pareamento do servidor e tira fotos para anexar na conversa.",
          "microphonePermission": "Grava o ditado pro composer e usa o microfone nas chamadas de voz ao vivo."
        }
      ],
      "./plugins/withPasteInput"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9fd06001-323e-4b82-835f-6dfc3674236d"
      }
    },
    "owner": "jeffer1312"
  }
}

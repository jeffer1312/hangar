{
  "name": "hangar-shell",
  "private": true,
  "version": "0.1.3",
  "description": "Janela nativa transparente do hangar",
  "main": "main.cjs",
  "author": "Jefferson Felizardo",
  "desktopName": "hangar.desktop",
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron main.cjs",
    "test": "node --test",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.hangar.shell",
    "productName": "Hangar",
    "artifactName": "hangar-${version}-${arch}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "settings.cjs",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    }
  }
}

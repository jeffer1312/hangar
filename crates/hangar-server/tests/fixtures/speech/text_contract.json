  "capture_program": "import json\nfrom app import narrar, config_sync_translate as tr, pensamento_pt as thought\ncases=['','  ','Ler como está',' LER COMO ESTA\\u001c','explica o código','ler como esta\\u200b']\nnormalize=['\\u200b\\ufeff  \"*T-1 — conferir*\"\\n\\nsegunda linha','\\n\\r\\n\\u001c\\u001d\\u0085\\u2028\\u2029 fim','\\u200c\\u200d\\u2060',' primeira\\n\\n\\n segunda ', 'primeira\\r\\nsegunda', 'primeira\\vsegunda\\f terceira']\nprovider_cases=[{}, {'groq_api_key':'fixture-groq'}, {'llm_api_key':'fixture-other','groq_api_key':'fixture-groq'}, {'transcription_base_url':'https://audio.invalid/v1','groq_api_key':'fixture-audio'}, {'llm_base_url':' https://text.invalid/v1/// ','llm_api_key':' fixture-key ','llm_model':' custom-model '}]\nproviders=[]\nfor config in provider_cases:\n narrar.runtime_config.get=lambda key: config.get(key)\n providers.append({'config':config,'expected':list(narrar._provedor())})\nchecks=[('Reads the file when the hook runs.','pt'),('Lê o arquivo quando o hook roda.','pt'),('Lê o arquivo quando o hook roda.','en'),('a','pt'),('', 'en'),('THE É\\u0301 e noname','en'),('é são para não','pt')]\nraws=['[\"texto\"]','```json\\n[\"texto\"]\\n```','```\\n[]\\n```','```json []',' ```\\n [\"um\"]\\n``` \\n']\nthought.chamar_chat=lambda system,prompt,**kwargs: 'traduzido:'+prompt\nthought_cases=[]\nfor value in ['', '  ', ' hello ', '\\u001chello\\u0085', 'x'*4001]:\n thought._cache.clear()\n thought._pausado_ate=0\n thought_cases.append({'input':value,'expected':thought.traduzir(value)})\ncapture={'instruction_cases':[{'input':v,'expected':narrar.eh_instrucao_padrao(v)} for v in cases],'normalization_cases':[{'input':v,'expected':narrar._normalizar_saida(v)} for v in normalize],'prompt_cases':[{'text':'texto selecionado','blocks':[],'instruction':'explique','expected':narrar.prompt_narrar('texto selecionado',[],'explique')},{'text':'ação','blocks':['const x = 1;', 'print(\"ação\")'],'instruction':'explica o código','expected':narrar.prompt_narrar('ação',['const x = 1;', 'print(\"ação\")'],'explica o código')}],'provider_cases':providers,'language_cases':[{'text':t,'language':l,'expected':tr._already_in(t,l)} for t,l in checks],'fence_cases':[{'input':r,'expected':tr._strip_fence(r)} for r in raws],'thought_cases':thought_cases}\n",

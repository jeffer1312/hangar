+/// What a frame redraws into the frame texture before presenting it.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum RenderPlan {
+    /// Nothing; the frame texture already holds the scene.
+    None,
+    Full,
+    Partial(PixelRect),
+}

diff -ruN -x .cargo_vcs_info.json -x .cargo-ok -x Cargo.lock -x Cargo.toml.orig gpui-pre-windows-0.3.7/src/directx_renderer/backdrop.rs gpui-pre-windows-0.3.7/src/directx_renderer/backdrop.rs

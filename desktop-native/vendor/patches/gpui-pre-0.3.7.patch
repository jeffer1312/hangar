+                2 => Just(SceneDamage::Unchanged),
+                5 => proptest::collection::vec(arbitrary_rect(), 0..6).prop_map(|rects| {
+                    let mut acc = DamageRects::default();
+                    for rect in rects {
+                        acc.add(rect);
+                    }

+            for rect in &rects {
+                acc.add(*rect);
+            }
+            let rects = acc.as_slice();
+            for (index, a) in rects.iter().enumerate() {
+                for b in &rects[index + 1..] {
+                    let overlap = a.intersect(b);
+                    prop_assert!(
+                        overlap.size.width.0 <= 0.0 || overlap.size.height.0 <= 0.0,
+                        "accumulator rects overlap: {a:?} and {b:?}",

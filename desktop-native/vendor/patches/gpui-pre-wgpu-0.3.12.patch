+/// When the regions nearly fill their bounding rectangle the plan collapses to it.
+fn plan_render_regions(
+    rects: &[Bounds<ScaledPixels>],
+    blur_footprints: &[ScissorRect],
+    target_width: u32,
+    target_height: u32,

+    fn draw_per_region(
+        pass: &mut wgpu::RenderPass<'_>,
+        regions: &[ScissorRect],
+        vertices: Range<u32>,
+        instances: Range<u32>,
+    ) {
+        if regions.is_empty() {
+            pass.draw(vertices, instances);
+        } else {
+            for region in regions {
+                pass.set_scissor_rect(region.x, region.y, region.width, region.height);
+                pass.draw(vertices.clone(), instances.clone());
+            }
+        }
+    }

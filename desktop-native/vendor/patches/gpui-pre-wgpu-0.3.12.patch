+    let mut regions: smallvec::SmallVec<[ScissorRect; 4]> = smallvec::SmallVec::new();
+    for rect in rects.iter().filter_map(|rect| ScissorRect::from_bounds(rect, target_width, target_height)) {
+        add_disjoint(&mut regions, rect);

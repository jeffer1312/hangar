+        let (row, cx) = open(cx);
+        settle(cx);
+        let before = bottom(&row, cx);
+        row.update(cx, |row, cx| {
+            row.state.update(cx, |state, cx| state.set_text(&format!("{}\n\nOne more block.", document()), cx));
+        });
+        cx.run_until_parked();
+        settle(cx);
+        assert!(bottom(&row, cx) > before);
+    }
+}

+        cx.update(crate::init);
+        let (_, cx) = cx.add_window_view(|_, _| ProseTable);
+        let cx: &mut VisualTestContext = cx;
+        cx.run_until_parked();
+        cx.update(|window, cx| {
+            let _ = window.draw(cx);
+        });
+

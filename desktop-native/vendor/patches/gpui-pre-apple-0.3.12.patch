+            .iter()
+            .position(|(s, _)| (*s - sigma).abs() < 0.01)
+        {
+            let entry = self.backdrop_kernels.remove(index);
+            let kernel = entry.1.clone();
+            self.backdrop_kernels.push(entry);
+            return kernel;
+        }
+        if self.backdrop_kernels.len() >= 4 {
+            self.backdrop_kernels.remove(0);
+        }
+        // SAFETY: `MPSImageGaussianBlur` takes a device and a float sigma; edge mode 1 is `MPSImageEdgeModeClamp`.
+        let kernel: Retained<AnyObject> = unsafe {
+            let alloc: Allocated<AnyObject> = msg_send![class!(MPSImageGaussianBlur), alloc];
+            let kernel: Retained<AnyObject> =
+                msg_send![alloc, initWithDevice: &*self.device, sigma: sigma];
+            let _: () = msg_send![&*kernel, setEdgeMode: 1usize];
+            kernel

+  if (quad_sdf(input.position.xy, blur.bounds, blur.corner_radii) > 0.) {
+    discard_fragment();
+  }
+  float2 uv = (input.position.xy - source_rect.xy) / source_rect.zw;
+  return source_texture.sample(source_sampler, uv);
+}

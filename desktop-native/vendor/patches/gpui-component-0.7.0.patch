+// Modified for Hangar: presentation is opt-in; interaction remains owned by the menu.
+/// Optional presentation for a popup menu's explicit parts.
+#[derive(Default)]
+pub struct PopupMenuAppearance {
+    surface: StyleRefinement,
+    list: StyleRefinement,
+    item: StyleRefinement,
+    separator: StyleRefinement,
+    item_height: Option<Pixels>,
+    label: Option<Box<dyn Fn(SharedString, &mut Window, &mut App) -> AnyElement>>,
+    key: Option<Box<dyn Fn(Kbd, &mut Window, &mut App) -> AnyElement>>,
+}
+
+impl PopupMenuAppearance {
+    /// Refine the outer surface, after the theme defaults.
+    pub fn surface_style(mut self, style: StyleRefinement) -> Self { self.surface = style; self }
+    /// Refine the items container, including its padding and gap.
+    pub fn list_style(mut self, style: StyleRefinement) -> Self { self.list = style; self }
+    /// Refine actionable rows, preserving their state styling.
+    pub fn item_style(mut self, style: StyleRefinement) -> Self { self.item = style; self }
+    /// Refine separators, after the theme defaults.
+    pub fn separator_style(mut self, style: StyleRefinement) -> Self { self.separator = style; self }
+    /// Set the standard row height and custom/submenu minimum height.

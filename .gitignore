# Python / uv
__pycache__/
*.pyc
.venv/
backend/.venv/

# Secrets / local env
.env
backend/.env
# peers de outros servidores (cp-send cross-server) — contém tokens
backend/peers.json
# launcher de projetos do painel — caminhos locais desta máquina (molde: projects.json.example)
backend/projects.json
# scripts de start/stop por projeto que NÃO devem morar no repo do projeto (ambiente-only)
backend/launchers/
# Sidecars da gravação do toggle de peer: .lock (flock do read-modify-write) e .tmp (escrita
# atômica). O .tmp carrega a malha INTEIRA de tokens enquanto existe — nunca pode ser commitado.
backend/peers.json.lock
backend/peers.json.*.tmp
# Mesmos sidecars pra gravação do projects.json (projects._mutate): flock + escrita atômica.
backend/projects.json.lock
backend/projects.json.*.tmp

# Generated plan/spec HTML (created by local hook)
docs/superpowers/**/*.html

# SDD progress ledger (scratch)
.superpowers/

.claude-pocket-uploads/

# Video analysis scratch (video-analyzer skill)
*.mp4
*.analysis/
*.frames/
# local backend log
server.log
backend/server.log

# Test coverage
backend/.coverage

# Design mocks / experimentos locais (nao fazem parte do app)
frontend/animation-plan.*
frontend/public/lottie/
frontend/public/lottie-mock.html
frontend/public/lottie2.html
frontend/public/motion-mock.html
frontend/public/stitch/
lottie-preview.html
splash-preview.html
robot-icon.png
analysis-checkpoints.md

# Planos/handoffs internos de desenvolvimento (rascunho local, fora do repo publico)
docs/superpowers/
docs/handoffs/

# Certificados TLS locais (Tailscale) — chave privada NUNCA no repo
*.ts.net.crt
*.ts.net.key

# Rascunho das sessoes de trabalho: prints de verificacao, mocks e audio que as sessoes geram pra
# mostrar resultado no celular. Nao sao artefato do projeto e enchiam o `git status` de ruido — com
# duas sessoes commitando na mesma arvore, ruido no status e o que faz um `git add` errado passar.
# `settings.json` fica de fora: esse e config do projeto e continua versionado.
.claude/
!.claude/settings.json

# Cache de build criado por engano na raiz (o vite/vitest do projeto roda em frontend/, e o
# frontend/.gitignore ja cobre o de la). Sem esta regra, um `npm`/`vite` rodado da raiz deixa um
# node_modules aparecendo como nao-rastreado.
node_modules/

# Worktrees locais do superpowers (git worktree add). Sem isto, o conteudo inteiro da worktree
# aparece como nao-rastreado no `git status` do repo principal.
.worktrees/

# Saida dos subagentes do Pi. Nao e fonte, e cresce sozinha: 40 MB medidos em 06/08/2026. Sem esta
# regra, um `git add -A` distraido leva tudo isso pro repo.
.pi-subagents/

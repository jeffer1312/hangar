#!/usr/bin/env bash
# Instalado por hangar (install.sh no Linux, install.ps1 no Windows) a partir de
# scripts/post-merge.hook - FONTE UNICA: nao edite a copia em .git/hooks, edite o arquivo do repo.
# hangar-post-merge-hook
# Re-aplica só o que o pull não atualiza sozinho (units, protocolo, deps, build do front).
# Nada aqui pede senha. Pra desligar: rm .git/hooks/post-merge
cd "$(git rev-parse --show-toplevel)" || exit 0
printf '\n\033[36m==>\033[0m hangar: aplicando a atualização (post-merge)\n'
# Git hook roda no bash do Git for Windows também, e lá quem atualiza é o install.ps1.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) powershell -ExecutionPolicy Bypass -File install.ps1 -Update ;;
  *)                    ./install.sh --update ;;
esac || {
  printf '\n'
  printf '\033[31m  ==============================================================\033[0m\n'
  printf '\033[31m  A ATUALIZACAO NAO RODOU.\033[0m\n'
  printf '  O que esta no ar continua no ar, com o codigo ANTERIOR — inclusive\n'
  printf '  a tela, que pode parecer normal por horas.\n'
  printf '  Rode na mao e leia o erro:\n'
  printf '      Windows:  powershell -ExecutionPolicy Bypass -File install.ps1 -Update\n'
  printf '      Linux:    ./install.sh --update\n'
  printf '\033[31m  ==============================================================\033[0m\n\n'
}

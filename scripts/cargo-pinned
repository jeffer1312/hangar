#!/usr/bin/env bash
# Roda o cargo do crates/ no target compartilhado da máquina (target-dir do ~/.cargo/config.toml)
# e só publica executáveis/biblioteca após o sucesso, em crates/target/<perfil>/ deste checkout,
# dentro da mesma trava. Quem executa fora do cargo (pytest, CP_RUST_SERVER_BIN) usa a cópia: o
# build de outra worktree reescreve o executável do target comum, nunca o deste checkout.
#
# Uso:  scripts/cargo-pinned build -p hangar-server [--release]
#       scripts/cargo-pinned test -p hangar-server --test it <filtro>
# Pega a trava da máquina (HANGAR_BUILD_LOCK, padrão /tmp/hangar-build.lock) sozinho: não envolva
# com outro flock nela, ou espera para sempre. Prioridade baixa; jobs e teto de memória saem da memória
# livre ao pegar a vez (CARGO_BUILD_JOBS explícito vence; HANGAR_BUILD_GB_POR_JOB, padrão 9).
# Argumentos do executável de teste (depois de `--`) não passam: o script acrescenta flags no fim.
set -euo pipefail

raiz="$(git rev-parse --show-toplevel)"
cd "$raiz/crates"
exec 9>"${HANGAR_BUILD_LOCK:-/tmp/hangar-build.lock}"
flock 9

metadata="$(mktemp)"
artifacts="$(mktemp)"
trap 'rm -f "$metadata" "$artifacts"' EXIT
cargo metadata --format-version 1 --no-deps > "$metadata"
alvo="$(jq -r .target_directory "$metadata")"
proprio="$(realpath -m "$raiz/crates/target")"

args=("$@")
if [[ "${1:-}" == build && " $* " != *" --workspace "* && " $* " == *" hangar-server "* && " $* " != *" hangar-auth "* ]]; then
    args+=(-p hangar-auth)
fi
target_arg=-1
target_inline=0
for ((i=0; i<${#args[@]}; i++)); do
    [[ "${args[i]}" == -- ]] && break
    if [[ "${args[i]}" == --target-dir && $((i+1)) -lt ${#args[@]} ]]; then
        target_arg=$((i+1)); alvo="${args[target_arg]}"
    elif [[ "${args[i]}" == --target-dir=* ]]; then
        target_arg=$i; target_inline=1; alvo="${args[i]#--target-dir=}"
    fi
done
alvo="$(realpath -m "$alvo")"
if [[ "$alvo" == "$proprio" ]]; then
    # O Cargo não pode escrever no par publicado antes de terminar a rodada.
    alvo="$proprio/.cargo-pinned-build"
    if (( target_arg >= 0 )); then
        if (( target_inline )); then args[target_arg]="--target-dir=$alvo"; else args[target_arg]="$alvo"; fi
    else
        export CARGO_TARGET_DIR="$alvo"
    fi
fi
bash "$raiz/scripts/cargo-freshness.sh" "$metadata" "$alvo"
# Cada job paralelo precisa caber na memória livre: o rustc do hangar_server é o maior do workspace.
gib=$((1024 * 1024))
folga=$((2 * gib))
por_job="${HANGAR_BUILD_GB_POR_JOB:-9}"
if [[ ! "$por_job" =~ ^[1-9][0-9]*$ ]]; then
    echo "cargo-pinned: HANGAR_BUILD_GB_POR_JOB=$por_job não é um inteiro positivo; usando 9" >&2
    por_job=9
fi
livre="$(awk '/^MemAvailable:/ {print $2}' "${HANGAR_MEMINFO:-/proc/meminfo}" 2>/dev/null || true)"
if [[ -n "${CARGO_BUILD_JOBS:-}" ]]; then
    jobs="$CARGO_BUILD_JOBS"
elif [[ -n "$livre" ]]; then
    jobs=$(( (livre - folga) / (por_job * gib) ))
    nucleos="$(nproc 2>/dev/null || echo 2)"
    (( jobs < 1 )) && jobs=1
    (( jobs > nucleos )) && jobs=$nucleos
else
    jobs=2
fi
# Passando do teto, o kernel recolhe primeiro a memória do próprio build, que fica lento no lugar das
# sessões. O swap continua comum a todos.
teto=()
alto=$(( ${livre:-0} - folga ))
(( alto < 4 * gib )) && alto=$((4 * gib))
escopo=(systemd-run --user --scope --quiet --collect -p "MemoryHigh=${alto}K")
# Escopo próprio sobrevive ao fim de quem chamou e seguraria a trava: ele morre junto com a unidade dela.
dono="$(sed -n 's#^0::.*/user@[0-9]*\.service/.*/\([^/]*\.\(scope\|service\)\)$#\1#p' /proc/self/cgroup 2>/dev/null || true)"
[[ -n "$dono" ]] && escopo+=(-p "BindsTo=$dono")
marca="$(mktemp -u)"
trap 'rm -f "$metadata" "$artifacts" "$marca"' EXIT
# A sonda leva os mesmos parâmetros e tem prazo: um systemd do usuário travado não pode segurar a trava.
if [[ -n "$livre" ]] && timeout 5 "${escopo[@]}" true >/dev/null 2>&1; then
    teto=("${escopo[@]}" -- bash -c 'touch "$0" && exec "$@"' "$marca")
    echo "cargo-pinned: -j $jobs, teto $((alto / gib)) GB de memória ($((livre / gib)) GB livres)" >&2
else
    echo "cargo-pinned: -j $jobs, sem teto de memória" >&2
fi
compila() {   # $@ = prefixo antes do nice: vazio ou o escopo com teto
    set +e
    "$@" nice -n 19 ionice -c 3 cargo "${args[@]}" -j "$jobs" --message-format=json-render-diagnostics |
        # No `cargo test` a saída dos testes vem misturada às mensagens do cargo: ela passa adiante.
        jq -rR --unbuffered '. as $l | (try fromjson catch null) as $j
            | if ($j | type) != "object" then "L\t" + $l
              elif $j.reason == "compiler-artifact" and $j.executable != null and ($j.profile.test | not)
              then "A\t" + ($j | tojson)
              elif $j.reason == "compiler-artifact" and $j.target.name == "hangar_auth" and ($j.target.crate_types | index("cdylib")) != null
              then "A\t" + ($j | tojson)
              else empty end' |
        while IFS= read -r l; do
            if [[ "$l" == L$'\t'* ]]; then printf '%s\n' "${l#L$'\t'}"; continue; fi
            printf '%s\n' "${l#A$'\t'}" >> "$artifacts"
        done
    statuses=("${PIPESTATUS[@]}")
    set -e
}
compila "${teto[@]}"
# A sonda passou mas o escopo não abriu (o cargo nem começou): compila de novo sem teto.
if (( ${#teto[@]} && statuses[0] != 0 )) && [[ ! -e "$marca" ]]; then
    echo "cargo-pinned: o escopo de memória não abriu; compilando sem teto" >&2
    compila
fi
(( statuses[0] == 0 )) || exit "${statuses[0]}"
for status in "${statuses[@]:1}"; do (( status == 0 )) || exit "$status"; done
python3 "$raiz/scripts/pin-auth-pair.py" --artifacts "$artifacts" --source-target "$alvo" --target-dir "$proprio" --workspace "$raiz/crates"

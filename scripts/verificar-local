#!/usr/bin/env bash
# Roda nesta máquina o que está ligado aos arquivos que o commit muda (o rápido, que as travas
# exigem) ou, com --completo, o que o CI rodaria para essas áreas, e grava o resultado pela árvore
# (tree sha) para a trava pre-push conferir. Windows roda por SSH numa VM (git config
# hangar.verificarWindows <host>), ao mesmo tempo que o Linux, só com arquivo de Windows no diff no
# rápido, e com teto de tempo (HANGAR_VERIFICAR_WINDOWS_MAX, 600 s; 2400 s no completo).
#
# Uso:  scripts/verificar-local                 HEAD, só o ligado aos arquivos mudados
#       scripts/verificar-local --completo      a bateria do CI para as áreas mudadas
#       scripts/verificar-local --commit <ref>  outro commit
#       scripts/verificar-local --base <ref>    o que mudou desde que saiu de <ref> (ex.: o PR inteiro)
#       scripts/verificar-local --tudo          todos os passos completos, mude o que mudar
#       scripts/verificar-local --so linux|windows
#       scripts/verificar-local --passos "a b"  só esses passos do plano (ex.: repetir um que falhou)
#       scripts/verificar-local --de-novo       repete os passos que já passaram nesta árvore
#       scripts/verificar-local --plano         só mostra o que rodaria
#       scripts/verificar-local --exigir <sha>  (pre-push) sai 1 se falta verificação
#
# Paralelismo: git config hangar.verificarProcessos <n> (ou HANGAR_VERIFICAR_PROCESSOS), padrão 4.
# Teto do crates/target da árvore fixa: HANGAR_VERIFICAR_TARGET_GB (padrão 40); passou, limpa.
# Com n > 1, os passos do Linux rodam em faixas paralelas (rust | backend | nativo | front e mobile |
# os leves), e n vale por faixa: o pytest e o vitest usam n processos e o cargo do preparo até n
# jobs. Com 1, tudo em fila, como antes. Memória disponível abaixo de HANGAR_VERIFICAR_MEM_GB
# (padrão 6) ao abrir uma faixa: ela espera a anterior terminar, com os mesmos passos.
#
# A árvore verificada é um clone fixo por máquina, não o checkout de quem chama: compila só o que
# mudou desde a última verificação, nunca mistura binário de outro checkout e deixa o checkout
# livre para editar enquanto roda. Uma verificação por vez na máquina (flock) e uma por vez na VM
# (mutex), em prioridade baixa. Cada passo que passa fica gravado para a árvore: a próxima rodada
# só repete o que falta.
set -uo pipefail

ESTADO="${XDG_STATE_HOME:-$HOME/.local/state}/hangar-verificacao"
FIXO="${HANGAR_VERIFICAR_ARVORE:-${XDG_CACHE_HOME:-$HOME/.cache}/hangar-verificacao/arvore}"
# Não é o /tmp/hangar-verificacao.lock: os scripts npm pegam aquele por dentro, e o mesmo arquivo
# aqui fora travaria o filho até o prazo.
TRAVA=/tmp/hangar-verificar-local.lock
VM_GIT=/c/hangar-verificacao/arvore
VM_WIN='C:/hangar-verificacao'

# Os mesmos do passo "Contenção e regressões" do server.yml: mudar lá exige mudar aqui.
RUNTIME_TESTS=(tests/test_runtime_process.py tests/test_runtime_queue_terminal_v2.py
    tests/test_runtime_terminal_fix.py tests/test_runtime_terminal_fix2.py
    tests/test_runtime_terminal_failure_policy.py tests/test_runtime_final_fixes.py
    tests/test_sidecar_coordination.py)

PROCESSOS_PADRAO=4

erro() { echo "verificar-local: $*" >&2; exit 2; }

# ── o que cada mudança pede ───────────────────────────────────────────────────────────────────

# Base padrão: o último commit da linha principal (primeiro pai) que já está num remoto. É o que o
# push leva, com merge incluso: o merge de outra branch muda o resultado e entra na conta.
base_padrao() {
    local c="$1" velho
    velho="$(git rev-list --first-parent "$c" --not --remotes)" || erro "não consegui listar os commits de $c"
    velho="${velho##*$'\n'}"
    if [[ -z "$velho" ]]; then echo "$c"; return; fi
    git rev-parse -q --verify "$velho^" 2>/dev/null || git hash-object -t tree /dev/null
}

# Imprime "linux: p1 p2" e "windows: p1" a partir da lista de arquivos no stdin.
classificar() {
    local f lin=() win=()
    local rust=0 back=0 front=0 mobile=0 nativo=0 wrap=0 status=0 pi=0 winback=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in
            crates/*|backend/tests/fixtures/*|plugins/hangar/hooks/*|\
            backend/app/adapters/claude_headless/cano.py|backend/tests/test_claude_headless_cano.py|\
            backend/app/runtime_process.py|backend/app/runtime_terminal.py|backend/app/runtime_coordinator.py|\
            backend/app/rust_server.py|backend/tests/test_runtime_*.py) rust=1 ;;
        esac
        # A suíte do backend lê quase o repositório inteiro (scripts, skills, plugins, docs, front).
        # Fica de fora só o que ela comprovadamente não lê. Workflow do CI não é código: quem o
        # confere é o próprio CI.
        case "$f" in
            desktop-native/*|docs/migracao-rust/*|docs/superpowers/*|site/*|.github/*) ;;
            *) back=1 ;;
        esac
        case "$f" in
            packages/*|frontend/*|messages/*|project.inlang/*|package.json|package-lock.json) front=1 ;;
        esac
        case "$f" in
            # Só mudança no próprio app: o CI não testa o mobile, e core e mensagens já passam pelo front.
            mobile/*) mobile=1 ;;
        esac
        case "$f" in
            desktop-native/*|crates/hangar-api/*|crates/hangar-workspace/*|crates/Cargo.toml|messages/*|VERSION) nativo=1 ;;
        esac
        case "$f" in
            scripts/shell/*|scripts/test-wrappers.sh|scripts/hangar-engine|scripts/install-claude-wrapper.sh|\
            scripts/verificar-local|scripts/test-verificar-local.sh|scripts/podar-target|scripts/test-podar-target.sh|\
            scripts/hook-pr-verificado.mjs|scripts/hooks/*) wrap=1 ;;
        esac
        case "$f" in
            scripts/*statusline*) status=1 ;;
        esac
        case "$f" in
            scripts/pi/*|scripts/test-pi-hangar-state.mjs) pi=1 ;;
        esac
        case "$f" in
            backend/*|*.ps1) winback=1 ;;
        esac
    done
    (( rust )) && lin+=(rust) && win+=(rust)
    (( back )) && lin+=(backend)
    (( front )) && lin+=(front)
    (( mobile )) && lin+=(mobile)
    (( nativo )) && lin+=(nativo)
    (( wrap )) && lin+=(shell)
    (( status )) && lin+=(statusline) && win+=(statusline)
    (( pi )) && lin+=(pi)
    (( winback && ! rust )) && win+=(runtime)
    echo "linux: ${lin[*]}"
    echo "windows: ${win[*]}"
}

TODOS_LINUX="rust backend front mobile nativo shell statusline pi"
TODOS_WINDOWS="rust statusline"
RAPIDOS="rust_rapido backend_rapido front_rapido mobile_rapido"

# O plano padrão, que as travas exigem: só o ligado aos arquivos mudados (cada passo `*_rapido` lê a
# lista); a bateria inteira é do CI e do `--completo`. Windows só com arquivo de Windows no diff.
classificar_rapido() {
    local f lin=() win=()
    local rust=0 back=0 front=0 mobile=0 nativo=0 wrap=0 status=0 pi=0 winback=0
    while IFS= read -r f; do
        [[ -z "$f" ]] && continue
        case "$f" in crates/*) rust=1 ;; esac
        case "$f" in backend/*) back=1 ;; esac
        case "$f" in packages/*|frontend/*|messages/*|project.inlang/*|package.json|package-lock.json) front=1 ;; esac
        case "$f" in mobile/*) mobile=1 ;; esac
        case "$f" in desktop-native/*|crates/hangar-api/*|crates/hangar-workspace/*|crates/Cargo.toml|messages/*) nativo=1 ;; esac
        case "$f" in
            scripts/shell/*|scripts/test-wrappers.sh|scripts/hangar-engine|scripts/install-claude-wrapper.sh|\
            scripts/verificar-local|scripts/test-verificar-local.sh|scripts/podar-target|scripts/test-podar-target.sh|\
            scripts/hook-pr-verificado.mjs|scripts/hooks/*) wrap=1 ;;
        esac
        case "$f" in scripts/*statusline*) status=1 ;; esac
        case "$f" in scripts/pi/*|scripts/test-pi-hangar-state.mjs) pi=1 ;; esac
        case "$f" in *.ps1|backend/app/procinfo.py|backend/app/atomico.py) winback=1 ;; esac
    done
    (( rust )) && lin+=(rust_rapido)
    (( back )) && lin+=(backend_rapido)
    (( front )) && lin+=(front_rapido)
    (( mobile )) && lin+=(mobile_rapido)
    (( nativo )) && lin+=(nativo)
    (( wrap )) && lin+=(shell)
    (( status )) && lin+=(statusline) && win+=(statusline)
    (( pi )) && lin+=(pi)
    (( winback )) && win+=(runtime)
    echo "linux: ${lin[*]}"
    echo "windows: ${win[*]}"
}

# ── passos (cwd = árvore fixa) ────────────────────────────────────────────────────────────────

# No Linux, o que os passos compilam e instalam vem do passo_preparo, que roda antes deles.
passo_rust() {
    (cd crates && cargo test --locked --workspace --no-fail-fast) || return 1
    if [[ "$SO" == linux ]]; then
        (cd backend && uv run pytest -q "${RUNTIME_TESTS[@]}") || return 1
        # Sem o binário a suíte pula os casos Rust e sairia verde: aqui a falta é erro, como no CI.
        local cano="$PWD/crates/target/debug/hangar-cano"
        [[ -x "$cano" ]] || { echo "hangar-cano não foi compilado em $cano"; return 1; }
        (cd backend && CP_RUST_CANO_BIN="$cano" uv run pytest -q tests/test_claude_headless_cano.py)
    else
        passo_runtime
    fi
}

# No Windows o CI só roda estes do pytest. A suíte inteira lá nem coleta (fcntl, os.geteuid), e
# testes com `tmux -L … kill-server` falariam com o psmux de verdade da VM.
passo_runtime() { (cd backend && uv run pytest -q "${RUNTIME_TESTS[@]}"); }

passo_backend() {   # só Linux: no Windows fica o passo_runtime
    local omp; omp="$(omp_de_teste)" || return 1
    local pytest=(pytest -q)
    # Um arquivo inteiro por processo: há testes com nome fixo de sessão tmux, que colidem
    # quando o mesmo arquivo se divide entre processos.
    (( PROCESSOS > 1 )) && pytest+=(-n "$PROCESSOS" --dist loadfile)
    # basetemp em disco: o omp extrai centenas de MB por caso (7 GB na suíte), e o /tmp pode ser tmpfs.
    mkdir -p "/var/tmp/hangar-verificacao-$USER"
    (cd backend && OMP_TEST_BIN="$omp" uv run "${pytest[@]}" --basetemp="/var/tmp/hangar-verificacao-$USER/pytest")
}

# Só Linux, antes dos outros: o único que compila e instala. Depois dele os passos só executam,
# então rodar em paralelo não deixa um cargo reescrever binário que outro passo está usando, nem o
# pytest chegar antes das sondas de contas.
passo_preparo() {
    local plano=" $PLANO " pid pids=() falhou=0
    (( PROCESSOS > CARGO_BUILD_JOBS )) && export CARGO_BUILD_JOBS="$PROCESSOS"
    # Rede e disco correm ao lado da compilação.
    local web=0 mobile=0
    [[ "$plano" == *" front "* || "$plano" == *" front_rapido "* ]] && web=1
    [[ "$plano" == *" mobile "* || "$plano" == *" mobile_rapido "* ]] && web=1 && mobile=1
    if (( web )); then
        { npm_ci_se_mudou package-lock.json npm ci --workspace=@hangar/core --workspace=frontend && \
            { (( ! mobile )) || npm_ci_se_mudou mobile/package-lock.json npm ci --prefix mobile; }; } &
        pids+=($!)
    fi
    if [[ "$plano" == *" backend "* || "$plano" == *" backend_rapido "* ]]; then
        omp_de_teste >/dev/null &
        pids+=($!)
    fi
    # Os rápidos compilam só o que usam, no próprio passo.
    if [[ "$plano" == *" rust "* || "$plano" == *" backend "* || "$plano" == *" backend_rapido "* ]]; then
        (cd backend && uv sync) || falhou=1
    fi
    if [[ "$plano" == *" rust "* ]]; then
        # O cano é o binário que o passo rust entrega ao pytest do cano.
        (cd crates && cargo build --locked -p hangar-server -p hangar-cano && \
            cargo test --locked --workspace --no-run) || falhou=1
    fi
    if [[ "$plano" == *" backend "* ]]; then
        # Os contratos e as sondas de contas que o pytest executa (ci.yml): as sondas são módulos do
        # executável de testes `it` do hangar-server.
        (cd crates && cargo build --locked -p hangar-server && \
            cargo build --locked -p hangar-workspace --example workspace_contract && \
            cargo test --locked -p hangar-server --no-run --test it) || falhou=1
    fi
    for pid in "${pids[@]}"; do wait "$pid" || falhou=1; done
    return $falhou
}

# Caminho do omp de versão fixa que o CI instala para as provas de extensão; sem ele, 20 casos
# falham. Baixa na primeira vez.
omp_de_teste() {
    local v omp
    v="$(grep -o 'releases/download/v[0-9.]*/omp-linux-x64' .github/workflows/ci.yml | head -1 | cut -d/ -f3)"
    # O nome do executável tem que ser `omp`: a extensão do Hangar decide se roda no omp ou no pi
    # pelo process.execPath (scripts/pi/lib/agent-context.ts), e link simbólico resolve pro alvo.
    omp="$VERIFICAR_CACHE/omp/$v/omp"
    if [[ ! -x "$omp" ]]; then
        local d; d="$(mktemp -d)"
        (cd "$d" && curl -fsSL --retry 3 -o omp-linux-x64 "https://github.com/can1357/oh-my-pi/releases/download/$v/omp-linux-x64" \
            && curl -fsSL --retry 3 -o SHA256SUMS.txt "https://github.com/can1357/oh-my-pi/releases/download/$v/SHA256SUMS.txt" \
            && sha256sum --check --ignore-missing --quiet SHA256SUMS.txt) || { rm -rf "$d"; echo "omp $v: download falhou" >&2; return 1; }
        install -Dm755 "$d/omp-linux-x64" "$omp" || { rm -rf "$d"; echo "omp $v: não consegui gravar $omp" >&2; return 1; }
        rm -rf "$d"
    fi
    echo "$omp"
}

npm_ci_se_mudou() {   # $1 = lockfile, $2.. = comando
    local lock="$1" marca; shift
    marca="$(dirname "$lock")/node_modules/.verificar-local-lock"
    if [[ "$(cat "$marca" 2>/dev/null)" != "$(sha256sum < "$lock")" ]]; then
        "$@" || return 1
        sha256sum < "$lock" > "$marca"
    fi
}

passo_front() {
    # Os vitest.config limitam a 2 forks para várias sessões não encherem a RAM ao mesmo tempo; aqui
    # a verificação roda sozinha na fila e pode usar os processos configurados.
    local vitest=()
    (( PROCESSOS > 2 )) && vitest=(-- --maxWorkers="$PROCESSOS")
    npm run check -w @hangar/core && npm run check -w frontend && \
        npm run test -w @hangar/core "${vitest[@]}" && npm run test -w frontend "${vitest[@]}" && \
        npm run build -w frontend
}

passo_mobile() {
    # O check do app compila as mensagens dele, não as do core; sem isto valem as da última rodada do front.
    npm run i18n:compile -w @hangar/core && npm run check:app && npm run test:app
}

# O nativo é outro workspace: fora do target do crates/, e num target só da árvore fixa. O
# `target-dir` global da máquina é o mesmo dos builds de quem programa: o passo esperava a trava dele.
passo_nativo() { (cd desktop-native && CARGO_TARGET_DIR="$PWD/target" cargo test --locked); }
passo_shell() {
    bash scripts/test-wrappers.sh || return 1
    [[ ! -f scripts/test-verificar-local.sh ]] || bash scripts/test-verificar-local.sh || return 1
    [[ ! -f scripts/test-podar-target.sh ]] || bash scripts/test-podar-target.sh
}
passo_statusline() {
    node --test scripts/test-configure-statusline.cjs || return 1
    [[ "$SO" == linux ]] && { bash scripts/test-statusline.sh || return 1; }
    return 0
}
passo_pi() { node scripts/test-pi-hangar-state.mjs; }

# ── passos rápidos: só o ligado aos arquivos mudados (ARQUIVOS, um por linha); o resto é do CI ──
# Chamam vitest/tsc direto, fora do flock global dos scripts npm: a fila daquele é a das suítes
# inteiras de todas as sessões, e o rápido roda poucos arquivos.
mudados() { grep -E "$1" <<< "$ARQUIVOS" || true; }

passo_rust_rapido() {
    local f dir nome args=() todos=0
    while IFS= read -r f; do
        case "$f" in
            crates/Cargo.toml|crates/Cargo.lock|crates/rust-toolchain.toml) todos=1 ;;
            crates/*/*)
                dir="${f#crates/}"; dir="${dir%%/*}"
                nome="$(sed -n 's/^name *= *"\(.*\)"/\1/p' "crates/$dir/Cargo.toml" 2>/dev/null | head -1)"
                [[ -n "$nome" && " ${args[*]} " != *" $nome "* ]] && args+=(-p "$nome") ;;
        esac
    done <<< "$(mudados '^crates/')"
    # Só o hangar-server é folha; crate de base muda quem depende dele.
    for nome in "${args[@]}"; do [[ "$nome" == -p || "$nome" == hangar-server ]] || todos=1; done
    (( todos )) && args=(--workspace)
    (( ${#args[@]} )) || { echo "nenhum crate mudou"; return 0; }
    (cd crates && cargo test --locked --no-fail-fast "${args[@]}")
}

# Os testes que mudaram e os que importam um módulo do app que mudou.
passo_backend_rapido() {
    local f m t testes=() inteiro=0
    while IFS= read -r f; do
        case "$f" in
            backend/tests/test_*.py) [[ -f "$f" ]] && testes+=("${f#backend/}") ;;
            backend/app/*.py)
                m="$(basename "$f" .py)"
                [[ "$m" == __init__ ]] && m="$(basename "$(dirname "$f")")"
                [[ "$m" == app ]] && { inteiro=1; continue; }
                # O teste com o nome do módulo pode chegar a ele por outro (app.api registra o router).
                [[ -f "backend/tests/test_${m}.py" ]] && testes+=("tests/test_${m}.py")
                # Quem importa o módulo: `app.x`, `from app import ... x` e a linha só com o nome dentro
                # de um import em várias linhas (`from app import (\n    x,`). A palavra solta pegava
                # quase a suíte inteira com nomes comuns ("transcript": 63 arquivos contra 14).
                while IFS= read -r t; do testes+=("$t"); done < <(cd backend && grep -lE -- \
                    "\\bapp(\\.[A-Za-z_]+)*\\.${m}\\b|from app(\\.[A-Za-z_.]+)? import [^#]*\\b${m}\\b|^[[:space:]]+${m},?[[:space:]]*(#.*)?\$" \
                    tests/test_*.py 2>/dev/null) ;;
            # Dependência, conftest e helper de teste valem para a suíte inteira.
            backend/pyproject.toml|backend/uv.lock|backend/tests/*.py) inteiro=1 ;;
        esac
    done <<< "$(mudados '^backend/')"
    (( inteiro )) && { echo "mudou o que vale para a suíte inteira: pytest completo"; passo_backend; return; }
    mapfile -t testes < <(printf '%s\n' "${testes[@]}" | grep . | sort -u)
    (( ${#testes[@]} )) || { echo "nenhum teste ligado aos arquivos mudados do backend"; return 0; }
    echo "pytest: ${testes[*]}"
    local omp; omp="$(omp_de_teste)" || return 1
    local pytest=(pytest -q)
    (( PROCESSOS > 1 )) && pytest+=(-n "$PROCESSOS" --dist loadfile)
    mkdir -p "/var/tmp/hangar-verificacao-$USER"
    (cd backend && OMP_TEST_BIN="$omp" uv run "${pytest[@]}" --basetemp="/var/tmp/hangar-verificacao-$USER/pytest-rapido" "${testes[@]}")
}

# Tipos só com .ts/.svelte ou mensagens no diff (chave removida quebra o m.<chave>()); testes, os
# que importam o que mudou.
passo_front_rapido() {
    local web f rel=() tipos=0 msgs=0
    web="$(mudados '^(frontend|packages/core)/')"
    [[ -n "$(mudados '^(messages|project\.inlang)/')" ]] && msgs=1
    grep -qE '\.(ts|svelte)$' <<< "$web" && tipos=1
    npm run i18n:compile -w frontend > /dev/null || return 1
    # Dependência ou configuração mudou: não há "relacionado", vale tudo (menos o build, que é do CI).
    if [[ -n "$(mudados '^(package(-lock)?\.json|(frontend|packages/core)/(package\.json|tsconfig[^/]*\.json|vite[^/]*\.ts|vitest[^/]*\.ts|svelte\.config\.js))$')" ]]; then
        (cd packages/core && npx tsc --noEmit -p tsconfig.json && npx vitest run) || return 1
        (cd frontend && npx svelte-check --tsconfig ./tsconfig.app.json --threshold error && npx vitest run)
        return
    fi
    if (( tipos || msgs )); then
        (cd packages/core && npx tsc --noEmit -p tsconfig.json) || return 1
        (cd frontend && npx svelte-check --tsconfig ./tsconfig.app.json --threshold error) || return 1
    fi
    while IFS= read -r f; do [[ -n "$f" && -f "$f" ]] && rel+=("$PWD/$f"); done <<< "$web"
    (( msgs )) && rel+=("$PWD/frontend/src/lib/i18nGuard.test.ts")
    (( ${#rel[@]} )) || return 0
    (cd packages/core && npx vitest related --run --passWithNoTests "${rel[@]}") || return 1
    # O core é reexportado inteiro pelo index: "relacionado" a um arquivo dele é quase todo teste do
    # front (mais de 40 min). Do front entram os arquivos que importam um nome que o diff do core
    # mudou (direto ou por quem o usa dentro do core), e o vitest acha os testes deles.
    local front=() core=() base_arg=() sel
    for f in "${rel[@]}"; do [[ "$f" == "$PWD"/frontend/* ]] && front+=("$f"); done
    # Do diff, apagados inclusive (o seletor os trata como "todo o front"); fora de src/ não se
    # sabe o que muda, e o índice vale por todo o front.
    while IFS= read -r f; do
        case "$f" in
            packages/core/src/*) core+=("$PWD/$f") ;;
            packages/core/*) core+=("$PWD/packages/core/src/index.ts") ;;
        esac
    done <<< "$web"
    [[ -n "${HANGAR_VERIFICAR_BASE:-}" ]] && base_arg=(--base "$HANGAR_VERIFICAR_BASE")
    if (( ${#core[@]} )); then
        sel="$(node scripts/core-front-tests.mjs "${base_arg[@]}" "${core[@]}")" || return 1
        [[ -n "$sel" ]] && mapfile -t -O "${#front[@]}" front <<< "$sel"
        echo "core mudou: $(grep -c . <<< "$sel") arquivos do front usam o que mudou"
    fi
    (( ${#front[@]} )) || return 0
    (cd frontend && npx vitest related --run --passWithNoTests "${front[@]}")
}

passo_mobile_rapido() {
    local app f rel=()
    app="$(mudados '^mobile/')"
    # O tsc do app lê o core: sem recompilar o dele, a árvore fixa guarda chaves de outra rodada.
    npm run i18n:compile:core --prefix mobile > /dev/null || return 1
    npm run i18n:compile --prefix mobile > /dev/null || return 1
    # Dependência ou configuração do app mudou: não há "relacionado", vale tudo.
    if [[ -n "$(mudados '^mobile/(package(-lock)?\.json|tsconfig[^/]*\.json|vitest[^/]*\.ts|babel\.config\.js|metro\.config\.js|app\.json|eas\.json|plugins/.*)$')" ]]; then
        (cd mobile && npx tsc --noEmit && npx vitest run)
        return
    fi
    if grep -qE '\.(ts|tsx)$' <<< "$app"; then (cd mobile && npx tsc --noEmit) || return 1; fi
    while IFS= read -r f; do [[ -n "$f" && -f "$f" ]] && rel+=("$PWD/$f"); done <<< "$app"
    (( ${#rel[@]} )) || return 0
    (cd mobile && npx vitest related --run --passWithNoTests "${rel[@]}")
}


# ── execução na árvore fixa (Linux em processo; Windows chega por `bash -s` via SSH) ──────────

# Ambiente parecido com o do runner: HOME vazio (nada lê ~/.claude, ~/.hangar nem o tmux real) e
# só o PATH das ferramentas. Caches de cargo/uv/npm continuam os da máquina.
ambiente_limpo() {
    local casa="$1" node_dir uv_dir codex_dir=""
    node_dir="${NODE_DIR:-$(dirname "$(realpath "$(command -v node)")")}"
    uv_dir="$(dirname "$(command -v uv)")"
    # O CI instala o codex no PATH; os contratos de contas precisam dele.
    # A pasta do link, não a do alvo: instalado pelo npm, o alvo é `codex.js` e lá não existe `codex`.
    command -v codex >/dev/null && codex_dir="$(dirname "$(command -v codex)"):"
    mkdir -p "$casa/tmux" "$casa/run"
    chmod 700 "$casa/run"
    LIMPO=(env -i
        HOME="$casa" USER="${USER:-$(id -un)}" LANG=C.UTF-8 TERM=dumb CI=1
        PATH="$node_dir:$uv_dir:$codex_dir${CARGO_HOME:-$HOME/.cargo}/bin:/usr/local/bin:/usr/bin:/bin"
        CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}" RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
        UV_CACHE_DIR="${UV_CACHE_DIR:-$HOME/.cache/uv}"
        UV_PYTHON_INSTALL_DIR="${UV_PYTHON_INSTALL_DIR:-$HOME/.local/share/uv/python}"
        npm_config_cache="${npm_config_cache:-$HOME/.npm}"
        TMUX_TMPDIR="$casa/tmux" XDG_RUNTIME_DIR="$casa/run"
        VERIFICAR_CACHE="$(dirname "$FIXO")" "${CARGO_ENV[@]}")
}

# Mata a árvore do passo se o disco cair abaixo de 2 GB: build cheio de saída já encheu a VM.
vigiar_disco() {   # $1 = pid do passo, $2 = log
    local livre
    while kill -0 "$1" 2>/dev/null; do
        livre="$(df -Pk . | awk 'NR==2 {print int($4/1048576)}')"
        if (( livre < 2 )); then
            echo "verificar-local: disco com ${livre} GB livres, passo interrompido" >> "$2"
            if [[ "$SO" == windows ]]; then taskkill //F //T //PID "$(cat "/proc/$1/winpid")" >/dev/null 2>&1
            else kill -- "-$1" 2>/dev/null; fi
            return
        fi
        sleep 10
    done
}

executar() {   # $1 = so, $2 = sha, $3 = bundle ("-" = sem bundle), resto = passos
    SO="$1"; local sha="$2" bundle="$3"; shift 3
    PROCESSOS="${HANGAR_VERIFICAR_PROCESSOS:-1}"; PLANO="$*"; ARQUIVOS="${HANGAR_VERIFICAR_ARQUIVOS:-}"
    preparar_arvore "$sha" "$bundle" || return $?
    if [[ "$SO" == windows ]]; then rodar_passos "$sha" "$@"; return; fi
    NODE_DIR="$(node_da_arvore)"
    rodar_em_faixas "$sha" "$@"
}

# Diretório do Node do .node-version da árvore (o mesmo do CI), pelo fnm quando o do PATH é outro:
# com outro, o jsdom do vitest fica sem localStorage e front e mobile quebram.
node_da_arvore() {
    local alvo atual
    # Árvore de antes do .node-version: a versão que o ci.yml dela declara.
    alvo="$({ tr -d '[:space:]v' < .node-version; } 2>/dev/null || \
        grep -m1 -oE 'node-version: *"?[0-9]+' .github/workflows/ci.yml 2>/dev/null | grep -oE '[0-9]+$')"
    atual="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null)"
    if [[ -n "$alvo" && "$atual" != "$alvo" ]] && command -v fnm >/dev/null && \
        fnm exec --using="$alvo" node -p 'require("path").dirname(process.execPath)' 2>/dev/null; then
        return
    fi
    [[ -n "$alvo" && "$atual" != "$alvo" ]] && \
        echo "verificar-local: o CI usa Node $alvo e aqui roda o ${atual:-nenhum}; front e mobile podem falhar só por isso." >&2
    dirname "$(realpath "$(command -v node)")"
}

# Sai 0 quando a memória disponível está abaixo do limite (HANGAR_VERIFICAR_MEM_GB, padrão 6). Sem
# leitura, conta como curta: a faixa espera em vez de arriscar o swap.
memoria_curta() {
    local kb
    kb="$(awk '/^MemAvailable:/ {print $2}' "${HANGAR_VERIFICAR_MEMINFO:-/proc/meminfo}" 2>/dev/null)"
    [[ -z "$kb" ]] || (( kb < ${HANGAR_VERIFICAR_MEM_GB:-6} * 1048576 ))
}

# Preparo e depois os passos em faixas; com PROCESSOS=1, uma faixa só, na ordem do plano. Imprime
# um resumo único, no formato do rodar_passos.
rodar_em_faixas() {   # $1 = sha, resto = passos
    local sha="$1" p f faixas=() web=() saidas
    shift
    saidas="$(mktemp -d)"
    rodar_passos "$sha" preparo > "$saidas/preparo" 2>&1 || { cat "$saidas/preparo"; rm -rf "$saidas"; return 1; }
    local carga=()
    for p in "$@"; do
        if (( PROCESSOS == 1 )); then web+=("$p")
        else
            # Duas faixas, não uma por passo: quatro passos pesados juntos levavam a máquina ao swap e
            # cada um ficava várias vezes mais lento. Os de cargo dividem uma (e a trava do cache de
            # pacotes); o resto, a outra. front e mobile juntos compilam as mensagens no mesmo lugar.
            case "$p" in
                rust|nativo|rust_rapido) carga+=("$p") ;;
                *) web+=("$p") ;;
            esac
        fi
    done
    (( ${#carga[@]} )) && faixas+=("${carga[*]}")
    (( ${#web[@]} )) && faixas+=("${web[*]}")
    local i pids=() falhou=0
    for i in "${!faixas[@]}"; do
        # Com a memória curta, a faixa seguinte espera a anterior: os mesmos passos, sem swap.
        if (( i > 0 )) && memoria_curta; then
            echo "verificar-local: memória livre abaixo de ${HANGAR_VERIFICAR_MEM_GB:-6} GB, faixa $i espera a anterior" >&3
            for p in "${pids[@]}"; do wait "$p" || falhou=1; done
            pids=()
        fi
        # shellcheck disable=SC2086
        rodar_passos "$sha" ${faixas[$i]} > "$saidas/faixa-$i" 2>&1 &
        pids+=($!)
    done
    for p in "${pids[@]}"; do wait "$p" || falhou=1; done
    for f in "$saidas"/faixa-*; do sed -n '/^--- /,/^=== resumo/{/^=== resumo/!p}' "$f"; done
    echo "=== resumo $SO ${sha:0:10}"
    for f in "$saidas"/faixa-*; do sed -n '/^=== resumo/,$p' "$f" | tail -n +2; done
    rm -rf "$saidas"
    return $falhou
}

# Deixa a árvore fixa no commit e entra nela (cwd).
preparar_arvore() {   # $1 = sha, $2 = bundle ("-" = sem bundle); usa $SO
    local sha="$1" bundle="$2" dir
    if [[ "$SO" == windows ]]; then dir="$VM_GIT"; LOGS="${VM_GIT%/*}/logs"; else dir="$FIXO"; LOGS="$ESTADO/logs"; fi
    mkdir -p "$LOGS"
    if [[ ! -d "$dir/.git" ]]; then git init -q "$dir" || return 2; fi
    cd "$dir" || return 2
    if [[ "$bundle" != - ]]; then
        git fetch -q --no-tags "$bundle" +refs/verificar/alvo:refs/verificar/alvo || return 2
        rm -f "$bundle"
    elif [[ -n "${ORIGEM:-}" ]]; then
        git fetch -q --no-tags "$ORIGEM" "$sha" || return 2
    fi
    # Sem -x: node_modules, target e .venv ficam e são o que deixa a próxima rodada incremental.
    git checkout -q --force --detach "$sha" && git clean -ffdq || return 2
    unset CARGO_TARGET_DIR
    # A depuração reduzida vem do perfil dev do crates/Cargo.toml: as mesmas flags de quem programa,
    # sem uma segunda cópia de cada artefato.
    # Teste do `it` lança tmux, cano e servidores falsos: com uma thread por núcleo, a máquina vai ao
    # swap e os testes de prazo falham por carga, não por defeito.
    CARGO_ENV=(CARGO_BUILD_JOBS=4 RUST_TEST_THREADS=4)
    # Os testes procuram os binários em crates/target; um `target-dir` no ~/.cargo/config.toml da
    # máquina mandaria o build para outro lugar. A variável vence a configuração, e só chega aos
    # passos pela lista do `env -i`.
    if [[ "$SO" != windows ]]; then CARGO_ENV+=(CARGO_TARGET_DIR="$PWD/crates/target"); fi
    # Cada commit deixa artefatos com hash novo que nenhum build seguinte usa, e o target só cresce
    # (52 GB em três dias). As cópias velhas saem a cada rodada (podar-target); passou do teto mesmo
    # assim, poda (ver podar_target) e o disco não enche.
    if [[ "$SO" == linux ]]; then
        [[ ! -d crates/target ]] || "$(dirname "$SCRIPT")/podar-target" crates/target >&3
        podar_target crates/target $(( ${HANGAR_VERIFICAR_TARGET_GB:-40} * 1048576 )) >&3
        podar_target desktop-native/target $(( ${HANGAR_VERIFICAR_TARGET_GB:-40} * 1048576 / 2 )) >&3
    fi
    local livre minimo=4
    livre="$(df -Pk . | awk 'NR==2 {print int($4/1048576)}')"
    if (( livre < minimo )); then
        echo "=== resumo $SO ${sha:0:10}"
        echo "  FALHOU  disco: só ${livre} GB livres em $dir (mínimo ${minimo} GB)"
        return 1
    fi
}

rodar_passos() {   # $1 = sha, resto = passos; cwd = árvore preparada
    local sha="$1"; shift
    SETSID=""; [[ "$SO" == linux ]] && SETSID=setsid
    local casa; casa="$(mktemp -d)"
    if [[ "$SO" == linux ]]; then
        ambiente_limpo "$casa"
    else
        # O python3 do Windows costuma ser o atalho da Microsoft Store, que não executa nada, e o
        # teste do cano lança `python3`. No CI quem o fornece é o setup-python.
        local py="${VM_GIT%/*}/py3/Scripts"
        [[ -x "$py/python3.exe" ]] || { python -m venv "${py%/Scripts}" && cp -f "$py/python.exe" "$py/python3.exe"; } || return 2
        LIMPO=(env PATH="$py:$PATH" "${CARGO_ENV[@]}" CARGO_INCREMENTAL=0)
    fi

    local p ini dur log falhou=0 resumo=()
    for p in "$@"; do
        log="$LOGS/${sha:0:10}-$SO-$p.log"
        echo ">> $SO: $p…" >&3
        ini=$SECONDS
        # setsid no Linux: o passo vira grupo próprio e o vigia mata a árvore inteira.
        "${LIMPO[@]}" SO="$SO" $SETSID bash -c "$(declare -f); $(declare -p RUNTIME_TESTS PROCESSOS PLANO ARQUIVOS); passo_$p" >"$log" 2>&1 &
        local spid=$! vigia rc
        vigiar_disco "$spid" "$log" &
        vigia=$!
        wait "$spid"; rc=$?
        kill "$vigia" 2>/dev/null; wait "$vigia" 2>/dev/null
        if (( rc == 0 )); then
            dur=$((SECONDS - ini)); resumo+=("ok      $p ${dur}s")
        else
            dur=$((SECONDS - ini)); resumo+=("FALHOU  $p ${dur}s  log: $log"); falhou=1
            echo "--- $SO/$p: fim do log ---"; tail -40 "$log"
        fi
        echo "<< $SO: $p ${dur}s $( (( rc == 0 )) && echo ok || echo FALHOU)" >&3
    done
    rm -rf "$casa"
    echo "=== resumo $SO ${sha:0:10}"
    printf '  %s\n' "${resumo[@]}"
    return $falhou
}

# ── registro ──────────────────────────────────────────────────────────────────────────────────

registro() { echo "$ESTADO/resultados/$(git rev-parse "$1^{tree}")-$2"; }

# Soma os passos aos que já passaram nesta árvore: um passo que falha não apaga os que passaram.
gravar() {   # $1 = sha, $2 = so, $3 = base, resto = passos
    local sha="$1" so="$2" base="$3" arq p ja=()
    shift 3
    mkdir -p "$ESTADO/resultados"
    arq="$(registro "$sha" "$so")"
    [[ -f "$arq" ]] && read -ra ja <<< "$(sed -n 's/^passos=//p' "$arq")"
    # O registro guarda uma base só: rápido gravado com outra base deixa de valer junto com ela.
    if [[ -f "$arq" && "$(sed -n 's/^base=//p' "$arq")" != "$base" ]]; then
        local manter=()
        for p in "${ja[@]}"; do [[ "$p" == *_rapido ]] || manter+=("$p"); done
        ja=("${manter[@]}")
    fi
    # shellcheck disable=SC2207
    ja+=($(BASE_ATUAL="$base" faltando "$arq" "$@"))
    printf 'commit=%s\nbase=%s\npassos=%s\nquando=%s\n' "$sha" "$base" "${ja[*]}" "$(date -Is)" > "$arq"
}

# Passos de $2.. que o registro $1 não cobre, na ordem dada.
faltando() {
    local arq="$1" feitos="" p saida=() base_reg
    shift
    [[ -f "$arq" ]] && feitos=" $(sed -n 's/^passos=//p' "$arq") "
    # O rápido olhou só o diff desde a base dele: vale se ela é a pedida ou mais velha (diff maior).
    base_reg="$(sed -n 's/^base=//p' "$arq" 2>/dev/null)"
    if [[ -n "${BASE_ATUAL:-}" && -n "$base_reg" ]] && ! git merge-base --is-ancestor "$base_reg" "$BASE_ATUAL" 2>/dev/null; then
        local f completos=" "
        for f in $feitos; do [[ "$f" == *_rapido ]] || completos+="$f "; done
        feitos="$completos"
    fi
    # O passo completo cobre o rápido da mesma área; o rápido nunca cobre o completo.
    for p in "$@"; do [[ "$feitos" == *" $p "* || ( "$p" == *_rapido && "$feitos" == *" ${p%_rapido} "* ) ]] || saida+=("$p"); done
    echo "${saida[*]}"
}

# ── Windows pela VM ───────────────────────────────────────────────────────────────────────────

# Keepalive: VM que para de responder no meio derruba a conexão em ~1 min em vez de pendurar.
vm_ssh() { ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 "$VM" "$@" \
    2> >(grep -v 'post-quantum\|store now\|upgraded\|openssh.com' >&2); }
# Teto da rodada inteira na VM: VM travada já segurou a fila da máquina por mais de uma hora.
VM_MAX="${HANGAR_VERIFICAR_WINDOWS_MAX:-600}"

vm_rodar() {   # $1 = sha, resto = passos; saída inteira no stdout
    local sha="$1"; shift
    local tem bundle ps b64 nome
    git -C "$FIXO" update-ref refs/verificar/alvo "$sha" || return 2
    tem="$(echo "mkdir -p $VM_GIT; git -C $VM_GIT rev-parse -q --verify refs/verificar/alvo 2>/dev/null" \
        | vm_ssh '& "C:\Program Files\Git\bin\bash.exe" -s' | tr -d '\r')" || true
    nome=-
    if [[ "$tem" != "$sha" ]]; then
        nome="in-${sha:0:10}-$$.bundle"
        bundle="$ESTADO/$nome"
        if [[ -n "$tem" ]] && git -C "$FIXO" cat-file -e "$tem^{commit}" 2>/dev/null; then
            # Commit que a VM já tem (ancestral do último verificado lá): nada a mandar.
            git -C "$FIXO" merge-base --is-ancestor "$sha" "$tem" && nome=-
        fi
        if [[ "$nome" == - ]]; then
            :
        elif [[ -n "$tem" ]] && git -C "$FIXO" cat-file -e "$tem^{commit}" 2>/dev/null; then
            git -C "$FIXO" bundle create -q "$bundle" refs/verificar/alvo --not "$tem" || return 2
        else
            git -C "$FIXO" bundle create -q "$bundle" refs/verificar/alvo || return 2
        fi
        if [[ "$nome" != - ]]; then
            scp -q -o BatchMode=yes "$bundle" "$VM:$VM_WIN/$nome" 2>/dev/null || { rm -f "$bundle"; echo "scp para $VM falhou"; return 2; }
            rm -f "$bundle"
        fi
    fi
    # Mutex do sistema: some com o processo, então SSH caído não deixa a fila presa. Prioridade
    # abaixo do normal passa para os filhos (cargo, pytest) e não disputa com o Hangar da VM.
    ps="\$ProgressPreference='SilentlyContinue'
\$m = New-Object System.Threading.Mutex(\$false, 'Global\\hangar-verificacao')
try { if (-not \$m.WaitOne(${VM_MAX}000)) { 'verificar-local: outra verificação ocupa a VM'; exit 3 } } catch [System.Threading.AbandonedMutexException] { }
[System.Diagnostics.Process]::GetCurrentProcess().PriorityClass = 'BelowNormal'
& 'C:\\Program Files\\Git\\bin\\bash.exe' -s -- --executar windows $sha $([[ $nome == - ]] && echo - || echo "$VM_WIN/$nome") $*
\$rc = \$LASTEXITCODE
\$m.ReleaseMutex()
exit \$rc"
    b64="$(printf '%s' "$ps" | iconv -t UTF-16LE | base64 -w0)"
    timeout --kill-after=10 "$VM_MAX" ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 \
        "$VM" "powershell -NoProfile -NonInteractive -EncodedCommand $b64" < "$SCRIPT" \
        2> >(grep -v 'post-quantum\|store now\|upgraded\|openssh.com' >&2) | tr -d '\r'
    local rc="${PIPESTATUS[0]}"
    (( rc == 124 || rc == 137 )) && echo "verificar-local: a VM $VM não terminou em ${VM_MAX}s; Windows não verificado"
    return "$rc"
}

# Poda do target acima do teto, do que volta mais barato ao mais caro: o cache incremental, depois os
# executáveis de teste mais velhos (um por arquivo de tests/, ~180 MB cada, voltam só com o link).
# Apagar tudo, que obriga a compilar do zero, só se ainda não couber. O disco é noatime: a idade é
# a do mtime, que o link renova.
podar_target() {   # $1 = target, $2 = teto em KB
    local dir="$1" teto="$2" usado tamanho caminho
    [[ -d "$dir" ]] || return 0
    usado="$(du -sk "$dir" | awk '{print $1}')"
    (( usado > teto )) || return 0
    echo "verificar-local: $dir com $(( usado / 1048576 )) GB (teto $(( teto / 1048576 )) GB); podando."
    rm -rf "$dir/debug/incremental"
    usado="$(du -sk "$dir" | awk '{print $1}')"
    while (( usado > teto )) && read -r _ tamanho caminho; do
        rm -f "$caminho"
        usado=$(( usado - tamanho ))
    done < <(find "$dir/debug/deps" -maxdepth 1 -type f -perm -u+x -printf '%T@ %k %p\n' 2>/dev/null | sort -n)
    usado="$(du -sk "$dir" | awk '{print $1}')"
    if (( usado > teto )); then
        echo "verificar-local: a poda não bastou; apagando $dir (a rodada compila do zero)."
        rm -rf "$dir"
    fi
}

# Repassa a entrada e copia as linhas de passo (>> começou, << terminou) para o arquivo de
# andamento, com a hora em segundos: é dele que um painel acompanha uma rodada que não é a sua.
marcar() {   # $1 = arquivo de andamento
    local l
    while IFS= read -r l; do
        printf '%s\n' "$l"
        [[ "$l" == ">> "* || "$l" == "<< "* ]] && printf '%(%s)T %s\n' -1 "$l" >> "$1"
    done
    # Sem isto a função sai com o código do último [[ ]] (1 quando a última linha não é de passo), e
    # quem espera o Windows pelo `wait` deste filtro dá a VM como falha mesmo com tudo ok.
    return 0
}

# ── principal ─────────────────────────────────────────────────────────────────────────────────

SCRIPT="$(realpath "$0" 2>/dev/null || echo "$0")"

if [[ "${1:-}" == --podar ]]; then   # uso do teste: --podar <target> <teto em KB>
    podar_target "$2" "$3"
    exit 0
fi

if [[ "${1:-}" == --memoria-curta ]]; then   # uso do teste
    memoria_curta
    exit $?
fi

if [[ "${1:-}" == --marcar ]]; then   # uso do teste: --marcar <arquivo>
    marcar "$2"
    exit 0
fi

if [[ "${1:-}" == --classificar ]]; then
    classificar
    exit 0
fi

if [[ "${1:-}" == --classificar-rapido ]]; then
    classificar_rapido
    exit 0
fi

if [[ "${1:-}" == --faltando ]]; then   # uso do teste: --faltando <registro> passos…
    shift
    faltando "$@"
    exit 0
fi

if [[ "${1:-}" == --executar ]]; then
    shift
    { true >&3; } 2>/dev/null || exec 3>&1
    executar "$@"
    exit $?
fi

commit=HEAD base="" tudo=0 completo=0 so="" modo=rodar de_novo=0 so_passos=""
while (( $# )); do
    case "$1" in
        --commit) commit="${2:?}"; shift ;;
        --base) base="${2:?}"; shift ;;
        --tudo) tudo=1 ;;
        --completo) completo=1 ;;
        --de-novo) de_novo=1 ;;
        --so) so="${2:?}"; shift ;;
        --passos) so_passos="${2:?}"; shift ;;
        --plano) modo=plano ;;
        --exigir) modo=exigir; commit="${2:?}"; shift ;;
        -h|--help) sed -n '2,26p' "$SCRIPT" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) erro "opção desconhecida: $1" ;;
    esac
    shift
done

(( completo || tudo )) && VM_MAX="${HANGAR_VERIFICAR_WINDOWS_MAX:-2400}"

unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX
sha="$(git rev-parse --verify -q "$commit^{commit}")" || erro "commit inválido: $commit"
ORIGEM="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
# rc 1 do git config é "não configurado"; acima disso, erro de leitura, que não pode virar "sem VM".
VM="$(git config hangar.verificarWindows)"; (( $? > 1 )) && erro "não consegui ler hangar.verificarWindows"
if [[ -n "$base" ]]; then
    # Desde onde o commit saiu de <ref>: o que a base andou depois não é mudança deste commit.
    ref_base="$base"
    base="$(git merge-base "$ref_base" "$sha")" || erro "base inválida ou sem ancestral comum: $ref_base (commit ${sha:0:10})"
else
    base="$(base_padrao "$sha")"
fi
BASE_ATUAL="$base"

if (( tudo )); then
    plano_lin="$TODOS_LINUX"; plano_win="$TODOS_WINDOWS"
else
    # quotepath=off: caminho com acento sairia entre aspas e escaparia dos padrões.
    arquivos="$(git -c core.quotepath=off diff --name-only --no-renames "$base" "$sha")" || erro "não consegui comparar $base com $sha"
    if (( completo )); then plano="$(classificar <<< "$arquivos")"; else plano="$(classificar_rapido <<< "$arquivos")"; fi
    plano_lin="$(sed -n 's/^linux: //p' <<< "$plano")"
    plano_win="$(sed -n 's/^windows: //p' <<< "$plano")"
fi
[[ -z "$VM" ]] && plano_win=""
[[ "$so" == windows ]] && plano_lin=""
[[ "$so" == linux ]] && plano_win=""

filtrar() {   # $1 = lista, resto = passos aceitos; imprime a lista só com os aceitos, na ordem dela
    local p saida=() aceitos=" ${*:2} "
    for p in $1; do [[ "$aceitos" == *" $p "* ]] && saida+=("$p"); done
    echo "${saida[*]}"
}
if [[ -n "$so_passos" ]]; then
    for p in $so_passos; do [[ " $TODOS_LINUX $RAPIDOS " == *" $p "* ]] || erro "passo desconhecido: $p"; done
    # O rápido precisa da lista de arquivos mudados, que o --tudo não calcula.
    (( tudo )) && [[ " $so_passos " == *"_rapido "* ]] && erro "--tudo roda passos completos; sem passo rápido"
    # shellcheck disable=SC2086
    plano_lin="$(filtrar "$plano_lin" $so_passos)"
    # shellcheck disable=SC2086
    plano_win="$(filtrar "$plano_win" $so_passos)"
fi

if [[ "$modo" == exigir ]]; then
    # shellcheck disable=SC2086
    fl="$(faltando "$(registro "$sha" linux)" $plano_lin)"
    # shellcheck disable=SC2086
    fw="$(faltando "$(registro "$sha" windows)" $plano_win)"
    [[ -z "$fl$fw" ]] && exit 0
    echo "  ${sha:0:10}: falta verificação local de${fl:+ linux ($fl)}${fw:+ windows ($fw)}" >&2
    exit 1
fi

if (( ! de_novo )); then
    # Só o que ainda não passou nesta árvore.
    # shellcheck disable=SC2086
    falta_lin="$(faltando "$(registro "$sha" linux)" $plano_lin)"
    # shellcheck disable=SC2086
    falta_win="$(faltando "$(registro "$sha" windows)" $plano_win)"
    if [[ "$falta_lin" != "$plano_lin" || "$falta_win" != "$plano_win" ]]; then
        echo "verificar-local: parte do plano já passou nesta árvore; falta: ${falta_lin:-nada}${falta_win:+ (windows: $falta_win)}. --de-novo repete tudo."
        plano_lin="$falta_lin" plano_win="$falta_win"
        [[ "$modo" != plano && -z "$plano_lin$plano_win" ]] && exit 0
    fi
fi

# rc 1 do git config é "não configurado"; acima disso, erro de leitura.
PROCESSOS="${HANGAR_VERIFICAR_PROCESSOS:-$(git config hangar.verificarProcessos)}"
(( $? > 1 )) && erro "não consegui ler hangar.verificarProcessos"
PROCESSOS="${PROCESSOS:-$PROCESSOS_PADRAO}"
[[ "$PROCESSOS" =~ ^[1-9][0-9]*$ ]] || erro "hangar.verificarProcessos inválido: $PROCESSOS (use um inteiro a partir de 1)"

if [[ "$modo" == plano ]]; then
    echo "commit ${sha:0:10}, comparado com ${base:0:10}"
    echo "linux:   ${plano_lin:-nada a rodar}"
    if [[ -n "$VM" ]]; then echo "windows: ${plano_win:-nada a rodar} (VM $VM)"
    else echo "windows: sem VM (git config hangar.verificarWindows <host>)"; fi
    echo "processos: $PROCESSOS (git config hangar.verificarProcessos <n>)"
    exit 0
fi

[[ "$commit" == HEAD && -n "$(git status --porcelain --untracked-files=no)" ]] && \
    echo "verificar-local: há mudanças não commitadas; só o commit ${sha:0:10} é verificado." >&2
[[ -z "$plano_lin$plano_win" ]] && { echo "verificar-local: nada a rodar para ${sha:0:10} (comparado com ${base:0:10})."; \
    gravar "$sha" linux "$base"; exit 0; }

echo "verificar-local: ${sha:0:10} contra ${base:0:10}"
echo "  linux:   ${plano_lin:-nada}${plano_lin:+ ($PROCESSOS processos)}"
[[ -n "$VM" ]] && echo "  windows: ${plano_win:-nada} (VM $VM)"

mkdir -p "$ESTADO/logs" "$ESTADO/andamento"
find "$ESTADO/andamento" -type f -mtime +1 -delete 2>/dev/null
# Um arquivo por rodada (o pid separa duas do mesmo commit): plano, fila, cada passo e o fim.
ANDAMENTO="$ESTADO/andamento/${sha:0:10}-$$"
# A faixa do plugin só aparece na sessão que chamou (`dono`); plano e dono saem numa escrita só,
# senão um tique do plugin entre as duas leria a rodada sem dono.
{
    printf '%(%s)T plano %s linux=%s windows=%s vm=%s\n' -1 "${sha:0:10}" "${plano_lin// /,}" "${plano_win// /,}" "$VM"
    [[ -n "${CP_SESSION_NAME:-}" ]] && printf '%(%s)T dono %s\n' -1 "$CP_SESSION_NAME"
} > "$ANDAMENTO"
[[ -d "$FIXO/.git" ]] || { mkdir -p "$(dirname "$FIXO")" && git clone -q --no-checkout "$ORIGEM" "$FIXO"; } || erro "não consegui criar $FIXO"

rc_lin=0 rc_win=0
saida_lin="$(mktemp)"
trap 'rc_saida=$?; rm -f "$saida_lin"; printf "%(%s)T fim %s\n" -1 "$rc_saida" >> "$ANDAMENTO"' EXIT
# Sem isto, morto por sinal o trap de saída lê o código do último comando (0) e grava "fim 0".
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
exec 3> >(marcar "$ANDAMENTO" >&2)
(
    exec 9>"$TRAVA" || exit 10
    if ! flock -n 9; then
        echo "verificar-local: na fila, outra verificação roda nesta máquina…" >&2
        printf '%(%s)T fila\n' -1 >> "$ANDAMENTO"
        flock 9 || exit 10
    fi
    # Busca primeiro, sob a trava: o Windows sai do mesmo clone.
    git -C "$FIXO" fetch -q --no-tags "$ORIGEM" "$sha" || exit 10
    win_pid=""
    if [[ -n "$plano_win" ]]; then
        # shellcheck disable=SC2086
        # 9>&-: processo que sobrar de um passo não pode segurar a fila da máquina.
        vm_rodar "$sha" $plano_win 2>&1 9>&- | marcar "$ANDAMENTO" > "$ESTADO/logs/${sha:0:10}-windows.log" 9>&- &
        win_pid=$!
        echo ">> windows: rodando na VM $VM (log: $ESTADO/logs/${sha:0:10}-windows.log)" >&3
    fi
    rl=0
    if [[ -n "$plano_lin" ]]; then
        # shellcheck disable=SC2086
        ORIGEM="$ORIGEM" HANGAR_VERIFICAR_PROCESSOS="$PROCESSOS" HANGAR_VERIFICAR_ARQUIVOS="${arquivos:-}" \
            HANGAR_VERIFICAR_BASE="$base" nice -n 10 ionice -c 3 \
            bash "$SCRIPT" --executar linux "$sha" - $plano_lin 9>&- | tee "$saida_lin"
        rl=${PIPESTATUS[0]}
    fi
    rw=0
    if [[ -n "$win_pid" ]]; then
        wait "$win_pid" || rw=$?
        echo
        sed -n '/^\(--- windows\/\|=== resumo windows\)/,$p' "$ESTADO/logs/${sha:0:10}-windows.log"
        # Sem resumo, ou com falha no resumo, não passou, seja qual for o código que o SSH devolveu.
        grep -q '^=== resumo windows' "$ESTADO/logs/${sha:0:10}-windows.log" || \
            { echo "=== windows não terminou (rc $rw):"; tail -20 "$ESTADO/logs/${sha:0:10}-windows.log"; rw=1; }
        grep -q '^  FALHOU' "$ESTADO/logs/${sha:0:10}-windows.log" && rw=1
    fi
    exit $(( (rl ? 1 : 0) | (rw ? 2 : 0) ))
)
rc=$?
case "$rc" in
    0|1|2|3) ;;
    *) erro "a verificação parou antes de rodar (rc $rc)" ;;
esac
(( rc & 1 )) && rc_lin=1
(( rc & 2 )) && rc_win=1
# Linux: cada passo que passou, mesmo que outro tenha falhado (o resumo diz quais).
passaram="$(sed -n '/^=== resumo linux/,$p' "$saida_lin" | awk '$1 == "ok" {print $2}' | xargs)"
# shellcheck disable=SC2086
[[ -n "$passaram" ]] && gravar "$sha" linux "$base" $passaram
# shellcheck disable=SC2086
[[ -n "$plano_win" ]] && (( ! rc_win )) && gravar "$sha" windows "$base" $plano_win
if (( rc_lin || rc_win )); then
    echo "verificar-local: FALHOU; o que passou ficou gravado, e a próxima rodada só repete o que falta."
    exit 1
fi
echo "verificar-local: ok, gravado para a árvore $(git rev-parse --short "$sha^{tree}")"

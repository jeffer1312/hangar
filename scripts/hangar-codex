#!/bin/sh
# Cria uma sessão Codex gerenciada pelo Hangar e anexa o terminal ao tmux dela.
#
# Abre pelo `hangar-server open`, o lançador do app: ele pede ao servidor e, com o servidor fora,
# abre igual nesta máquina e o servidor adota depois. Sem um `hangar-server` que abra sai com 3, e a
# função `codex` do shell abre o oficial; recusa sai com 1 e não abre nada. Cada chamada cria uma
# sessão nova. Quando a sessão acaba (não um detach), `hangar-server codex-close` a fecha no servidor
# ou, sem ele, limpa o que ficou da vida dela.
set -u

if [ "$#" -gt 1 ]; then
    printf '%s\n' 'uso: hangar-codex [prompt]' >&2
    exit 2
fi

say() { printf 'hangar-codex: %s\n' "$1" >&2; }

# A cópia do Hangar deste script: `~/.local/bin/hangar-codex` é link.
script=$0
while [ -L "$script" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$script")" && pwd)
    link=$(readlink "$script")
    case "$link" in /*) script=$link ;; *) script=$dir/$link ;; esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script")/.." && pwd)

# Texto como string JSON: aspas, contrabarra e controle escapados; o resto passa como está (UTF-8).
json_string() {
    printf '%s\n' "$1" | awk '
        BEGIN { for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
                esc["\\"] = "\\\\"; esc["\""] = "\\\""; esc["\t"] = "\\t"; esc["\r"] = "\\r" }
        { out = ""; n = length($0)
          for (i = 1; i <= n; i++) { c = substr($0, i, 1); out = out ((c in esc) ? esc[c] : c) }
          printf "%s%s", (NR > 1 ? "\\n" : ""), out }'
}

# Texto sem espaço nem linha em branco nas pontas.
trimmed() {
    printf '%s' "$1" | awk 'BEGIN { RS = "\001" } { gsub(/^[ \t\r\n]+|[ \t\r\n]+$/, ""); printf "%s", $0 }'
}

# Caminho absoluto: `~` expandido e a pasta (ou a pasta de cima, se ela não existe) pelo caminho real.
absolute() {
    case "$1" in
        "~") path=$HOME ;;
        "~/"*) path=$HOME/${1#"~/"} ;;
        /*) path=$1 ;;
        *) path=$(pwd -P)/$1 ;;
    esac
    path=${path%/}
    if [ -d "$path" ]; then
        (CDPATH= cd -- "$path" && pwd -P)
    elif [ -d "${path%/*}" ]; then
        printf '%s/%s\n' "$(CDPATH= cd -- "${path%/*}" && pwd -P)" "${path##*/}"
    else
        printf '%s\n' "$path"
    fi
}

# `CODEX_HOME` herdado precisa ser uma conta gerenciada (`~/.codex-<id>`); a padrão não manda o campo.
# Pelo caminho, sem perguntar ao servidor: com ele fora a sessão abre igual, e o lançador confere a marca.
account=
if [ -n "${CODEX_HOME:-}" ]; then
    target=$(absolute "$CODEX_HOME")
    base=$(absolute "$HOME")
    name=${target##*/}
    if [ "$target" = "$base/.codex" ]; then
        account=
    elif [ "${target%/*}" = "$base" ] && [ "${name#.codex-}" != "$name" ] && [ -n "${name#.codex-}" ]; then
        account=${name#.codex-}
    else
        say 'CODEX_HOME personalizado não é uma conta Codex gerenciada pelo Hangar (~/.codex-<conta>)'
        exit 1
    fi
fi

# O mesmo `hangar-server` dos outros atalhos; sem nenhum, o do PATH, como o `codex` digitado sempre aceitou.
# O explícito errado não cai para o do PATH.
. "$root/scripts/hangar-server-lookup"
server=
if hangar_server_find "$root"; then
    server=$HANGAR_SERVER_BIN
elif [ "$HANGAR_SERVER_MISSING" = env ]; then
    printf 'rust_bins: CP_RUST_SERVER_BIN=%s não é executável; seguindo sem hangar-server\n' \
        "$(printf '%s' "$CP_RUST_SERVER_BIN" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')" >&2
else
    server=$(command -v hangar-server)
fi
if [ -z "$server" ]; then
    say 'hangar-server não encontrado (CP_RUST_SERVER_BIN, crates/target/release, ~/.hangar/bin ou PATH): nenhuma sessão foi aberta'
    exit 3
fi

cwd=$(pwd -P)
# No Git Bash do Windows o `pwd` dá `/c/...`; o hangar-server é nativo e precisa de `C:\...`.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        if ! cwd=$(cygpath -w "$cwd") || [ -z "$cwd" ]; then
            say "cygpath não converteu a pasta $(pwd -P) para caminho do Windows: nenhuma sessão foi aberta"
            exit 1
        fi
        ;;
esac
if [ "$#" -eq 1 ]; then prompt="\"$(json_string "$1")\""; else prompt=null; fi
body="{\"cwd\": \"$(json_string "$cwd")\", \"provider\": \"codex\", \"headless\": false, \"initial_prompt\": $prompt"
[ -n "$account" ] && body="$body, \"codex_account\": \"$(json_string "$account")\""
body="$body}"

errors=$(mktemp "${TMPDIR:-/tmp}/hangar-codex.XXXXXX") || exit 1
opened=$("$server" open "$body" 2>"$errors")
status=$?
problem=$(cat "$errors")
rm -f "$errors"

if [ "$status" -ne 0 ]; then
    text=$problem
    [ -n "$(trimmed "$text")" ] || text=$opened
    text=$(trimmed "$text")
    # 2 = hangar-server antigo, sem `open`; 4 = sem token no .env. Nada foi enviado: o oficial abre.
    if [ "$status" -eq 2 ] || [ "$status" -eq 4 ]; then
        say "o hangar-server não abriu a sessão (saída $status): $text"
        exit 3
    fi
    # Recusa: a última linha é o envelope `{"detail": …}` do servidor; dele vale a mensagem.
    last=$(printf '%s\n' "$text" | tail -n 1)
    message=
    case "$last" in
        "{"*'"detail"'*)
            message=$(printf '%s\n' "$last" | sed -n 's/.*"msg"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
            [ -n "$message" ] || message=$(printf '%s\n' "$last" | sed -n 's/.*"detail"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n 1)
            ;;
    esac
    [ -n "$message" ] || message=$text
    [ -n "$message" ] || message="hangar-server open saiu com $status"
    # O `codex` oficial abriria fora do Hangar a sessão que ele recusou.
    say "$message"
    exit 1
fi

# O primeiro `name` da resposta é o da sessão (objetos de dentro vêm depois).
name=$(printf '%s\n' "$opened" | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')
if [ -z "$name" ]; then
    say 'o hangar-server abriu sem dizer o nome da sessão; confira a lista no app'
    exit 1
fi

printf 'Codex gerenciado pelo hangar: %s (detach: Ctrl-b d)\n' "$name" >&2
# Um terminal novo pode herdar o ambiente de um pane que já morreu.
if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ] && tmux list-panes -t "$TMUX_PANE" >/dev/null 2>&1; then
    tmux switch-client -t "=$name"
    attached=$?
    if [ "$attached" -eq 0 ]; then
        # Este processo fica no pane antigo enquanto o cliente usa a sessão Codex; quando ela termina,
        # o tmux volta para outra sessão e a limpeza roda daqui.
        while tmux has-session -t "=$name" >/dev/null 2>&1; do sleep 0.5; done
    fi
else
    unset TMUX TMUX_PANE
    tmux attach-session -t "=$name"
    attached=$?
fi

# Encerrada (não um detach): o servidor fecha a sessão; sem ele, a limpeza local.
if ! tmux has-session -t "=$name" >/dev/null 2>&1; then
    "$server" codex-close "$name"
fi
exit "$attached"

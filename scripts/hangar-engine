#!/bin/sh
# O motor funciona sem serviço e sem Python; toda regra vive no executável Rust.
set -eu
engine_script=$0
while [ -L "$engine_script" ]; do
    engine_dir=$(CDPATH= cd -- "$(dirname -- "$engine_script")" && pwd)
    engine_link=$(readlink "$engine_script")
    case "$engine_link" in /*) engine_script=$engine_link ;; *) engine_script=$engine_dir/$engine_link ;; esac
done
engine_root=$(CDPATH= cd -- "$(dirname -- "$engine_script")/.." && pwd)
if [ -n "${CP_RUST_SERVER_BIN:-}" ] && [ -x "$CP_RUST_SERVER_BIN" ]; then
    exec "$CP_RUST_SERVER_BIN" engine "$@"
fi
for engine_binary in "$engine_root/bin/hangar-server" "$engine_root/crates/target/release/hangar-server" "$HOME/.hangar/bin/hangar-server"; do
    if [ -x "$engine_binary" ]; then exec "$engine_binary" engine "$@"; fi
done
printf '%s\n' 'hangar-engine: hangar-server não encontrado; instale o Hangar ou configure CP_RUST_SERVER_BIN' >&2
exit 126

#!/usr/bin/env -S sh -c 'exec "$(command -v hangar-python || command -v python3)" "$0" "$@"'
"""CLI de motores de modelo, para o wrapper de shell e para o backend chamarem.

Por que existe: a derivação motor->env tem que morar num lugar SÓ. O backend importa app.engines
direto; o shell não pode (não tem venv), então chama este script com o python3 do sistema.
Reimplementar o parse em fish e em bash seriam três verdades divergindo.

Por que `--exec` e não `tmux -e`: a key iria para a linha de comando, e /proc/<pid>/cmdline é legível
por qualquer usuário da máquina (o systemd-run --scope ainda joga argv no journal). Com execvpe o
ambiente é aplicado DENTRO do processo e, depois do exec, o cmdline é o do comando alvo.

  hangar-engine --list                       -> nome<TAB>label<TAB>modelo
  hangar-engine --env <motor>                -> CHAVE=VALOR por linha (diagnóstico)
  hangar-engine --exec <motor> [--model <id>] [--context <n>] [--service-tier default|priority] -- <cmd> ...
  Conta fixa: --account <id> --account-home <home> --account-base-url <url>, resolvidos no backend.
                                         -> executa cmd com o env do motor (substitui este processo)

`--model`/`--context` são a escolha da tela de abertura: o env do motor tem que saber qual modelo
está subindo, senão as cinco chaves ANTHROPIC_*, o subagente e a janela ficariam no modelo do
motor com a flag num outro — o cenário "motor de 1M com modelo de 262k".
"""
import json
import os
import sys
import tempfile
from pathlib import Path

# app.engines é stdlib pura (garantido por teste): importável sem instalar o backend.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "backend"))

from app import engines  # noqa: E402


def _env_ou_morre(nome: str, modelo: str | None = None, context: int | None = None,
                  account: str | None = None, account_home: str | None = None,
                  account_base: str | None = None) -> dict[str, str]:
    try:
        return engines.env_de(nome, modelo, context, engine_account=account,
                              engine_account_home=account_home, engine_account_base_url=account_base)
    except (KeyError, ValueError) as e:
        # KeyError: motor não existe no registro. ValueError: existe, mas engines.json foi
        # hand-editado com um valor que viola o contrato de shell (\n/\r/\0 — ver env_de). Os dois
        # casos morrem igual: traceback aqui vazaria pro usuário errado (o wrapper de shell).
        if isinstance(e, ValueError):
            print(f"hangar-engine: motor '{nome}' inválido: {e}", file=sys.stderr)
        else:
            disponiveis = ", ".join(sorted(engines.listar())) or "nenhum"
            print(f"hangar-engine: motor '{nome}' não existe (configurados: {disponiveis})", file=sys.stderr)
        raise SystemExit(1)


def _apply_service_tier(cmd: list[str], env: dict[str, str], service_tier: str) -> list[str]:
    args, settings = engines.service_tier_settings(cmd, env, service_tier)
    # Settings explícitos podem ter segredos; o argv recebe só o caminho privado.
    fd, value = tempfile.mkstemp(prefix="hangar-engine-", suffix=".json")
    path = Path(value)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(settings, stream, ensure_ascii=False, allow_nan=False, separators=(",", ":"))
    except BaseException:
        path.unlink(missing_ok=True)
        raise
    return [args[0], "--settings", str(path), *args[1:]]


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] in ("--help", "-h"):
        print(__doc__)
        return 0

    if len(argv) == 2 and argv[1] == "--list":
        for nome, e in sorted(engines.listar().items()):
            print(f"{nome}\t{e.get('label', nome)}\t{e.get('model', '')}")
        return 0

    if len(argv) == 3 and argv[1] == "--env":
        for chave, valor in _env_ou_morre(argv[2]).items():
            print(f"{chave}={valor}")
        return 0

    if len(argv) >= 5 and argv[1] == "--exec" and "--" in argv[3:]:
        corte = argv.index("--", 3)
        nome = argv[2]
        modelo = None
        context = None
        service_tier = None
        account = account_home = account_base = None
        i = 3
        while i < corte:
            if argv[i] in ("--model", "--context", "--account", "--account-home", "--account-base-url", "--service-tier"):
                if i + 1 >= corte:
                    print(f"hangar-engine: {argv[i]} precisa de um valor", file=sys.stderr)
                    return 2
                if argv[i] == "--model":
                    modelo = argv[i + 1]
                elif argv[i] == "--account":
                    account = argv[i + 1]
                elif argv[i] == "--account-home":
                    account_home = argv[i + 1]
                elif argv[i] == "--account-base-url":
                    account_base = argv[i + 1]
                elif argv[i] == "--service-tier":
                    service_tier = argv[i + 1]
                    if service_tier not in ("default", "priority"):
                        print("hangar-engine: --service-tier precisa de default ou priority", file=sys.stderr)
                        return 2
                else:
                    try:
                        context = int(argv[i + 1])
                    except ValueError:
                        print("hangar-engine: --context precisa de um número", file=sys.stderr)
                        return 2
                i += 2
            else:
                print(f"hangar-engine: opção desconhecida {argv[i]!r}", file=sys.stderr)
                return 2
        if account is None and (account_home is not None or account_base is not None):
            print("hangar-engine: vínculo de conta sem --account", file=sys.stderr)
            return 2
        env = _env_ou_morre(nome, modelo, context, account, account_home, account_base)
        if account is not None and "CLAUDE_CODE_MAX_CONTEXT_TOKENS" not in env:
            os.environ.pop("CLAUDE_CODE_MAX_CONTEXT_TOKENS", None)
        if account is None:
            # Não herde a escolha de outra sessão que lançou este processo.
            os.environ.pop("CP_ENGINE_ACCOUNT", None)
            os.environ.pop("CP_ENGINE_CREDENTIAL_ID", None)
            os.environ.pop("CP_ENGINE_ACCOUNT_BASE_URL", None)
        cmd = argv[corte + 1:]
        if not cmd:
            # A guarda antiga (`argv[3] == "--"` com len>=5) garantia comando depois do `--`; a nova
            # não. `hangar-engine --exec kimi --model x --` passaria e `cmd[0]` estouraria IndexError —
            # traceback cru, que é o oposto do que este parse existe pra fazer. O `except OSError` do
            # __main__ não pega IndexError.
            print("hangar-engine: falta o comando depois de --", file=sys.stderr)
            return 2
        launch_env = {**os.environ, **env}
        launch_env.pop("CP_ENGINE_SERVICE_TIER", None)
        settings_path = None
        if service_tier is not None:
            try:
                cmd = _apply_service_tier(cmd, launch_env, service_tier)
                settings_path = Path(cmd[2])
            except ValueError as e:
                print(f"hangar-engine: {e}", file=sys.stderr)
                return 2
        # execvpe substitui este processo: o pane do tmux passa a ser o próprio claude (dono do tty),
        # que é o que faz o send-keys do app chegar nele. Um wrapper que ficasse no meio quebraria isso.
        #
        # No Windows nenhuma variante de exec serve, e as duas falham de jeitos DIFERENTES. Medido
        # em 21/08/2026 neste Windows 11 (Python 3.14.6), 20 execuções de cada:
        #     os.execve  (com env)  crash 14/20   0xC0000005 ACCESS_VIOLATION
        #     os.execvpe (com env)  crash 17/20   idem
        #     os.execv   (sem env)  crash  0/20
        #     os.execvp  (sem env)  crash  0/20
        # O crash é sem stdout, sem stderr e sem traceback: o pane simplesmente morre. Não é
        # tamanho de ambiente — um dict de duas chaves crasha 16/20 igual.
        #
        # As variantes sem env não crasham, mas QUEBRAM O ARGV: elas remontam a linha de comando e
        # o filho a reparseia. Medido com `["um dois", "tres;quatro", "cinco"]`, o filho recebeu o
        # primeiro argumento partido no espaço. Num comando com caminho ou prompt com espaço isso é
        # silencioso e destrutivo.
        #
        # `subprocess.run` preserva as fronteiras (mesma medição: devolveu os três argumentos
        # intactos) e roda 10/10 sem crash. O preço é um processo a mais no pane — e ele NÃO custa
        # aqui: a razão de o POSIX usar exec é o filho ficar dono do tty, e no Windows o psmux roda
        # o comando direto no ConPTY, sem shell no meio (é por isso que o `new_session` já omite o
        # `exec` lá). A resolução por descendentes do registry atravessa esse nível sem mudança.
        #
        # O ramo POSIX fica byte-idêntico ao que está em produção.
        try:
            if os.name == "nt":
                import subprocess
                return subprocess.run(cmd, env=launch_env).returncode
            os.execvpe(cmd[0], cmd, launch_env)
            return 127  # inalcançável; o execvpe só retorna levantando OSError
        finally:
            # No POSIX o exec bem-sucedido mantém o arquivo disponível para recargas do Claude.
            if settings_path is not None:
                settings_path.unlink(missing_ok=True)

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except OSError as e:
        print(f"hangar-engine: falha ao executar: {e}", file=sys.stderr)
        sys.exit(126)

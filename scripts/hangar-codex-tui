#!/usr/bin/env python3
"""Lancador UNICO da sessao Codex: um comando que sobe o app-server e a TUI no mesmo pane.

O backend e o terminal chamam exatamente isto. Antes o app-server era filho do processo do
BACKEND (registry.create_codex spawnava o subprocess e segurava o client), o que deixava duas
marcas: o servidor sobrevivia ao pane (ja houve app-server orfao escutando em loopback nesta
maquina) e a criacao de sessao Codex nao passava pelo caminho normal dos outros agentes.

O servidor nasce em segundo plano e a TUI roda em PRIMEIRO plano -- nunca `exec`. E a unica forma
de o servidor morrer junto com o pane: quem o mata e o `finally` daqui, e o `exec` apagaria este
processo antes de ele chegar la.
"""
from __future__ import annotations

import argparse
import asyncio
import json
import math
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

_REPO = Path(__file__).resolve().parent.parent


def _api_backend(method: str, path: str) -> dict:
    env: dict[str, str] = {}
    # Dados do usuário: `~/.hangar/config/` quando o arquivo está lá; senão a `backend/` (não migrada).
    env_file = Path.home() / ".hangar" / "config" / ".env"
    if not env_file.exists():
        env_file = _REPO / "backend" / ".env"
    try:
        for line in env_file.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                key, value = line.split("=", 1)
                env[key.strip()] = value.strip()
    except OSError:
        pass
    token = os.environ.get("CP_AUTH_TOKEN") or env.get("CP_AUTH_TOKEN")
    port = os.environ.get("CP_PORT") or env.get("CP_PORT") or "8765"
    if not token:
        raise RuntimeError("CP_AUTH_TOKEN ausente")
    req = urllib.request.Request(f"http://127.0.0.1:{port}{path}", method=method,
                                 headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req, timeout=5) as response:
        return json.load(response)


def _texto(msg) -> str:
    """A mensagem do backend é `{codigo, params, texto}`; no terminal só o texto serve."""
    return msg.get("texto", "") if isinstance(msg, dict) else str(msg or "")


def _integracao_codex() -> dict:
    """Dispara a reconciliação e não espera: ela termina no backend e vale a partir da próxima sessão."""
    return _api_backend("POST", "/api/harness/codex/integracao/sessao")


def _preparar_conta_codex(account_id: str, cwd: str) -> dict:
    """Dispara o preparo da conta e não espera; a TUI abre com a config que a conta já tem.

    Preparo já concluído (cache) passa pelo GET, que grava a confiança da pasta depois das escritas.
    """
    path = (f"/api/codex-contas/{urllib.parse.quote(account_id, safe='')}/prepare"
            f"?cwd={urllib.parse.quote(cwd, safe='')}")
    resultado = _api_backend("POST", path)
    if resultado.get("status") != "running":
        resultado = _api_backend("GET", path)
    return resultado
# Quanto esperamos a TUI abrir a thread. Estourar NAO e fatal: o pane segue sendo um Codex
# utilizavel; o que se perde e o vinculo com o app ate a proxima abertura.
_ESPERA_THREAD = 60.0
# Quantas vezes o app-server pode ser ressubido em 5 min antes de assumir crash em laço.
_QUEDAS_MAX = 3
# ponytail: janela fixa; TUI que demora mais que isso para sair depois do servidor ainda conta como queda.
_FIM_DA_SESSAO = 1.5
# Quanto do stderr do app-server sai na tela quando ele morre na largada. E a cauda, porque a
# ultima linha e que costuma dizer o motivo.
_ERRO_MAX = 2000


def _com_websockets() -> None:
    """Garante a lib de WebSocket, re-exec no python do backend quando o do sistema nao a tem.

    O comando do pane e montado tanto pelo backend quanto pelo wrapper de shell, e nenhum dos dois
    sabe qual python vai atender o shebang. Falhar aqui deixaria um pane que morre no ato.
    """
    try:
        import websockets  # noqa: F401
        return
    except ImportError:
        pass
    # A regra de backend/app/install_root.py: raiz = ~/.hangar/current (pacote) ou este checkout; nela o
    # Python embutido, senao o venv do backend.
    raiz = Path.home() / ".hangar" / "current"
    raiz = raiz if raiz.exists() else _REPO
    embutido, venv = ((raiz / "python" / "python.exe", raiz / "backend" / ".venv" / "Scripts" / "python.exe")
                      if os.name == "nt" else
                      (raiz / "python" / "bin" / "python3", raiz / "backend" / ".venv" / "bin" / "python"))
    venv = embutido if embutido.exists() else venv
    if os.environ.get("_HANGAR_CODEX_REEXEC") or not venv.exists():
        raise SystemExit(
            "hangar-codex-tui: falta o pacote `websockets` e o Python do hangar nao esta em "
            f"{venv} — rode o instalador do hangar"
        )
    os.environ["_HANGAR_CODEX_REEXEC"] = "1"
    os.execv(str(venv), [str(venv), os.path.abspath(__file__), *sys.argv[1:]])


def _rollout_de(thread_id: str) -> str:
    """O arquivo da conversa, pelo id. "" quando nao existe.

    O id e o final do nome do arquivo — mesmo layout que o Arquivo do app lê pra listar as
    conversas (`app/archive_providers.py`, `_codex_jsonl`). Mais de um arquivo com o mesmo id nao
    acontece na pratica; havendo, o mais recente e o que o `codex resume` abre.
    """
    raiz = Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex")) / "sessions"
    achados = sorted(raiz.glob(f"*/*/*/rollout-*-{thread_id}.jsonl"),
                     key=lambda p: p.stat().st_mtime, reverse=True)
    return str(achados[0]) if achados else ""


def _codex() -> str:
    """O caminho do binario `codex`, resolvido UMA vez.

    Nome cru nao serve no Windows: o `CreateProcess` nao aplica PATHEXT, e o codex do npm e um
    `codex.CMD` — `Popen(["codex", ...])` estoura com WinError 2 enquanto o mesmo comando com o
    caminho resolvido funciona (medido 07/09/2026). O `shutil.which` aplica PATHEXT e devolve o
    arquivo real, entao serve aos dois sistemas sem ramo por OS.

    Falha ALTA e legivel: sem isto o pane morria com um traceback de FileNotFoundError apontando
    pro `subprocess.py`, que nao diz a quem le que o que falta e o proprio Codex.
    """
    caminho = shutil.which("codex")
    if not caminho:
        raise SystemExit(
            "hangar-codex-tui: nao achei o executavel `codex` no PATH deste processo. "
            "Instale o Codex CLI (npm install -g @openai/codex) e reabra a sessao."
        )
    return caminho


_CONSULTA_VERSAO_S = 3600
_NEW_ATTEMPT_S = 300
_UPDATE_TIMEOUT_S = 600
_PREFIXO = "hangar-codex-tui:"


def _versao(texto: str) -> tuple[int, ...] | None:
    # A versão vai para o comando do npm e para a tela: só passa o formato publicado.
    texto = texto.strip()
    if not re.fullmatch(r"\d+\.\d+\.\d+(-[0-9A-Za-z.]+)?", texto):
        return None
    return tuple(int(parte) for parte in texto.split("-")[0].split("."))


def _npm_failure_kind(stderr: str) -> str:
    # O texto do npm não vai à tela: pode trazer caminho, registro e token.
    if "EACCES" in stderr or "EPERM" in stderr:
        return "sem permissão para instalar"
    if any(c in stderr for c in ("ENOTFOUND", "ETIMEDOUT", "ECONNRESET", "EAI_AGAIN")):
        return "falha de rede"
    return "outro erro do npm"


def _installed_by_npm(codex: str, npm: str) -> bool:
    if "node_modules" in os.path.realpath(codex).replace("\\", "/"):
        return True
    if os.name != "nt":
        return False
    # No Windows o shim `codex.cmd` fica fora de node_modules; o pacote é que diz.
    raiz = subprocess.run([npm, "root", "-g"], capture_output=True, text=True, errors="replace",
                          timeout=15)
    return raiz.returncode == 0 and (Path(raiz.stdout.strip()) / "@openai" / "codex").is_dir()


def _standalone_home(caminho: str) -> Path | None:
    # O instalador oficial guarda o binário em <CODEX_HOME>/packages/standalone/releases/, e é
    # esse trecho inteiro que o próprio Codex exige; `packages/standalone` sozinho casa monorepo npm.
    partes = [parte.lower() for parte in Path(caminho).parts]
    for i in range(len(partes) - 2):
        if partes[i:i + 3] == ["packages", "standalone", "releases"]:
            return Path(*Path(caminho).parts[:i])
    return None


def _latest_standalone_version() -> str:
    # O mesmo canal que o instalador oficial lê para "latest". O User-Agent padrão do urllib leva 403.
    pedido = urllib.request.Request("https://releases.openai.com/codex/channels/latest",
                                    headers={"User-Agent": "hangar-codex-tui"})
    with urllib.request.urlopen(pedido, timeout=15) as resposta:
        dados = json.load(resposta)
    tag = dados.get("tag_name") if isinstance(dados, dict) else None
    return tag.removeprefix("rust-v") if isinstance(tag, str) else ""


def _atualizar_codex() -> None:
    """Atualiza o Codex do npm ou o standalone oficial antes de abrir a sessão, mostrando na tela.

    A TUI sobe com a checagem dela desligada (o aviso travava a abertura); quem atualiza é o
    lançador, aqui, e a tela de abertura do app mostra a espera. A versão publicada é consultada no
    máximo uma vez por hora. Falha nunca impede a abertura: a sessão segue na versão instalada e
    toda falha vira uma linha fixa na tela, sem a saída crua do npm. A saída do instalador
    standalone vai ao pane: é o instalador oficial, que mostra versão, URL pública e pastas da
    instalação, sem token.
    """
    codex = shutil.which("codex")
    if not codex:
        return   # o `_codex()` da abertura já diz o que falta
    npm = shutil.which("npm")
    estado = Path.home() / ".hangar" / "codex-atualizacao.json"

    def vencido() -> bool:
        try:
            visto = json.loads(estado.read_text())
        except (OSError, ValueError):
            return True
        proxima = visto.get("proxima_em") if isinstance(visto, dict) else None
        agora = time.time()
        # Valor absurdo (NaN, infinito, ano que vem) desligaria a atualização para sempre.
        return not (isinstance(proxima, (int, float)) and math.isfinite(proxima)
                    and agora < proxima <= agora + 86400)

    def gravar(segundos: int) -> None:
        # Sem o controle gravado a consulta só se repete; a atualização segue.
        try:
            estado.write_text(json.dumps({"proxima_em": time.time() + segundos}))
        except OSError:
            print(f"{_PREFIXO} não deu para gravar o controle de atualização do Codex; "
                  "a consulta se repete na próxima abertura", file=sys.stderr)

    def rodar(argv: list[str], timeout: int):
        return subprocess.run(argv, capture_output=True, text=True, errors="replace", timeout=timeout)

    trava = None
    try:
        if not vencido():
            return
        try:
            estado.parent.mkdir(parents=True, exist_ok=True)
            trava = open(estado.with_suffix(".lock"), "w")
        except OSError:
            # Sem trava o risco é dois npm juntos, que só falham; pular a atualização é pior.
            print(f"{_PREFIXO} não deu para criar a trava da atualização do Codex; ela segue "
                  "sem trava", file=sys.stderr)
        try:
            import fcntl
        except ImportError:
            fcntl = None   # ponytail: sem trava no Windows; dois npm juntos lá só falham e a sessão segue
        if fcntl is not None and trava is not None:
            try:
                fcntl.flock(trava, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                # Esperar a trava prenderia esta abertura durante o npm install da outra.
                print(f"{_PREFIXO} outra sessão está atualizando o Codex; esta abre na versão "
                      "instalada", file=sys.stderr)
                return
        if not vencido():
            return   # a outra sessão acabou de conferir
        standalone = _standalone_home(os.path.realpath(codex))
        try:
            pelo_npm = standalone is None and bool(npm) and _installed_by_npm(codex, npm)
        except (OSError, subprocess.SubprocessError):
            print(f"{_PREFIXO} não deu para identificar como o Codex foi instalado; a sessão abre "
                  "na versão instalada e tenta de novo em 5 min", file=sys.stderr)
            gravar(_NEW_ATTEMPT_S)
            return
        if standalone is None and not pelo_npm:
            print(f"{_PREFIXO} atualização automática do Codex indisponível nesta instalação",
                  file=sys.stderr)
            gravar(_CONSULTA_VERSAO_S)
            return
        print(f"{_PREFIXO} conferindo a versão do Codex…", file=sys.stderr)
        try:
            saida = rodar([codex, "--version"], 15)
            atual = (saida.stdout.split() or [""])[-1]
            if standalone is not None:
                publicada = _latest_standalone_version()
            else:
                consulta = rodar([npm, "view", "@openai/codex", "version"], 15)
                publicada = consulta.stdout.strip() if consulta.returncode == 0 else ""
            consultou = saida.returncode == 0 and bool(_versao(publicada) and _versao(atual))
        except (OSError, ValueError, subprocess.SubprocessError):
            consultou = False
        if not consultou:
            print(f"{_PREFIXO} não deu para conferir a versão do Codex; a sessão abre na versão "
                  "instalada e tenta de novo em 5 min", file=sys.stderr)
            gravar(_NEW_ATTEMPT_S)
            return
        gravar(_CONSULTA_VERSAO_S)
        if _versao(publicada) <= _versao(atual):
            return
        print(f"{_PREFIXO} atualizando o Codex {atual} → {publicada}…", file=sys.stderr)
        reinstalar = "codex update" if standalone is not None else "npm install -g @openai/codex"
        try:
            if standalone is not None:
                # O CODEX_HOME da conta levaria o instalador a outra pasta; a versão vai fixada na
                # que foi conferida, e o link visível fica onde o `which` o achou.
                ambiente = {**os.environ, "CODEX_HOME": str(standalone), "CODEX_RELEASE": publicada}
                visivel = str(Path(codex).parent)
                if _standalone_home(os.path.realpath(visivel)) is None:
                    ambiente["CODEX_INSTALL_DIR"] = visivel
                else:
                    ambiente.pop("CODEX_INSTALL_DIR", None)
                grupo = os.name != "nt"
                # A saída do instalador oficial vai ao pane: é ela que mostra o motivo de uma falha.
                proc = subprocess.Popen([codex, "update"], env=ambiente, stdin=subprocess.DEVNULL,
                                        stdout=2, stderr=2, start_new_session=grupo)
                try:
                    codigo, erro = proc.wait(timeout=_UPDATE_TIMEOUT_S), ""
                except subprocess.TimeoutExpired:
                    # O `curl | sh` é neto: matar só o `codex` deixaria o instalador trocando o
                    # binário com a sessão aberta. ponytail: no Windows só o filho morre.
                    try:
                        if grupo:
                            os.killpg(proc.pid, signal.SIGKILL)
                        else:
                            proc.kill()
                    except ProcessLookupError:
                        pass
                    proc.wait()
                    raise
            else:
                feito = rodar([npm, "install", "-g", f"@openai/codex@{publicada}"], _UPDATE_TIMEOUT_S)
                codigo, erro = feito.returncode, feito.stderr
        except subprocess.TimeoutExpired:
            print(f"{_PREFIXO} a atualização do Codex passou de 10 min e foi interrompida",
                  file=sys.stderr)
            try:
                depois = _versao((rodar([codex, "--version"], 15).stdout.split() or [""])[-1])
            except (OSError, subprocess.SubprocessError):
                depois = None
            if depois is None:
                print(f"{_PREFIXO} o Codex pode ter ficado incompleto; reinstale com {reinstalar}",
                      file=sys.stderr)
            return
        if codigo == 0 and standalone is not None:
            # Código 0 não prova a troca: o que vale é a versão que o `codex` responde agora.
            try:
                depois = (rodar([codex, "--version"], 15).stdout.split() or [""])[-1]
            except (OSError, subprocess.SubprocessError):
                depois = ""
            if depois != publicada:
                lida = depois if _versao(depois) else "ilegível"
                print(f"{_PREFIXO} o atualizador oficial terminou, mas o Codex responde {lida} em "
                      f"vez de {publicada}; a sessão abre assim e tenta de novo em 1 h",
                      file=sys.stderr)
                return
        if codigo == 0:
            print(f"{_PREFIXO} Codex atualizado para {publicada}", file=sys.stderr)
        elif standalone is not None:
            print(f"{_PREFIXO} não deu para atualizar o Codex (o atualizador oficial saiu com "
                  f"código {codigo}); a sessão abre na {atual} e tenta de novo em 1 h",
                  file=sys.stderr)
        else:
            print(f"{_PREFIXO} não deu para atualizar o Codex ({_npm_failure_kind(erro)}); "
                  f"a sessão abre na {atual} e tenta de novo em 1 h", file=sys.stderr)
    except Exception as exc:
        print(f"{_PREFIXO} não deu para preparar a atualização do Codex ({type(exc).__name__}); "
              "a sessão abre na versão instalada e tenta de novo em 5 min", file=sys.stderr)
        gravar(_NEW_ATTEMPT_S)
    finally:
        if trava is not None:
            trava.close()


def _porta_livre() -> str:
    # Reserva e solta uma porta loopback. Ha uma janela minima ate o app-server dar bind; quem
    # perde a corrida ve o servidor sair, e a espera abaixo falha em vez de deixar uma TUI apontando
    # pro servidor errado.
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.bind(("127.0.0.1", 0))
        porta = sock.getsockname()[1]
    return f"ws://127.0.0.1:{porta}"


def _cauda_erros(erros) -> bytes:
    tamanho = erros.seek(0, os.SEEK_END)
    erros.seek(max(0, tamanho - _ERRO_MAX))
    cauda = erros.read(_ERRO_MAX)
    # O mesmo arquivo e o stderr do proximo servidor: sem voltar ao fim, ele sobrescreve daqui.
    erros.seek(0, os.SEEK_END)
    return cauda


def _registrar_falha_servidor(erros, codigo: str, *, retorno=None, exc=None,
                             etapa="abrir_app_server", limite_ms=None) -> bytes:
    from app import atomico, diag, log_paths

    campos = {"sessao": os.environ.get("CP_SESSION_NAME", ""), "provider": "codex",
              "codigo": codigo, "etapa": etapa, "retorno": retorno, "limite_ms": limite_ms}
    diag.registrar("codex.app_server.falhou", **campos, nivel="erro",
                   **(diag.erro_campos(exc) if exc is not None else {}))
    cauda = b""
    try:
        cauda = _cauda_erros(erros)
        pasta = log_paths.base() / "privado"
        pasta.mkdir(parents=True, exist_ok=True, mode=0o700)
        destino = pasta / f"codex-app-server-{diag.conta_id(campos['sessao'])}.log"
        temporario = None
        try:
            with tempfile.NamedTemporaryFile(dir=pasta, prefix=".codex-app-server-", delete=False) as arquivo:
                temporario = Path(arquivo.name)
                arquivo.write(cauda)
            atomico.substituir(temporario, destino)
        finally:
            if temporario is not None:
                temporario.unlink(missing_ok=True)
    except OSError as erro:
        diag.registrar("codex.app_server.log_falhou", "aviso", **{
            **campos, "codigo": "gravar_cauda", **diag.erro_campos(erro)})
    return cauda


def _avisar_servidor_morto(endpoint: str, servidor, erros, *, etapa="abrir_app_server") -> None:
    """O stderr DELE e a unica pista de por que nao abriu a porta."""
    cauda = _registrar_falha_servidor(erros, "processo_encerrou",
                                      retorno=servidor.returncode, etapa=etapa).decode(errors="replace").strip()
    print(f"hangar-codex-tui: o app-server saiu com codigo {servidor.returncode} antes de "
          f"abrir {endpoint}" + (f":\n{cauda}" if cauda else ""), file=sys.stderr)


def _esperar_porta(endpoint: str, servidor, erros, teto: float) -> bool:
    """Bloqueia ate o app-server aceitar conexao. A TUI nao tenta de novo: se sobe antes do bind,
    leva `Connection refused`, sai com 1, o pane morre e a sessao some — e isso acontece justo
    quando a maquina esta carregada, que e quando o servidor demora."""
    host, porta = endpoint.rsplit("/", 1)[1].rsplit(":", 1)
    limite = time.monotonic() + teto
    while time.monotonic() < limite:
        if servidor.poll() is not None:
            _avisar_servidor_morto(endpoint, servidor, erros)
            return False
        try:
            with socket.create_connection((host, int(porta)), timeout=0.5):
                return True
        except OSError:
            time.sleep(0.05)
    print(f"hangar-codex-tui: app-server nao respondeu em {endpoint}", file=sys.stderr)
    _registrar_falha_servidor(erros, "timeout", retorno=servidor.poll(), limite_ms=int(teto * 1000))
    return False


class _RpcError(Exception):
    def __init__(self, code) -> None:
        super().__init__(code)
        self.code = code


_HOOKS_DEADLINE_S = 15


def _screen_key(chave: str) -> str:
    # A chave vem do arquivo de hooks: sem caractere de controle e curta, para não sujar a tela.
    limpa = "".join(c for c in chave if c.isprintable())
    return limpa if len(limpa) <= 80 else limpa[:79] + "…"
# Só os hooks que o Hangar sincroniza (~/.codex/hooks.json e plugins); hook de projeto vem de um
# repositório qualquer e continua passando pela pergunta da TUI.
_TRUSTED_SOURCES = ("user", "plugin")


def _sincronizado_pelo_hangar(hook: dict) -> bool:
    # Sessão aberta na home: o Codex lista o `~/.codex/hooks.json` da conta padrão como hook de
    # projeto, mas o arquivo é o mesmo que o Hangar escreve.
    if hook.get("source") in _TRUSTED_SOURCES:
        return True
    arquivos = {Path.home() / ".codex" / "hooks.json"}
    if os.environ.get("CODEX_HOME"):
        arquivos.add(Path(os.environ["CODEX_HOME"]) / "hooks.json")
    return any(hook["key"].startswith(f"{arquivo}:") for arquivo in arquivos)


def _confiar_hooks(endpoint: str, cwd: str) -> None:
    """Confia nos hooks pendentes sincronizados pelo Hangar antes da TUI subir.

    Os hooks chegam ao Codex pela sincronização do próprio Hangar; sem isto a TUI para em "Hooks
    need review" antes da thread e quem abriu pelo app vê a sessão travada. A confiança é gravada
    pelo escritor do próprio Codex (`config/batchWrite`), com o hash que o `hooks/list` informa.
    Falha aqui não impede a abertura: a TUI pergunta, como antes.
    """
    etapa = "conectar"
    try:
        from websockets.sync.client import connect
        from app.adapters.codex.lancador import CLIENT_INFO

        limite = time.monotonic() + _HOOKS_DEADLINE_S

        def pedir(ws, ident: int, metodo: str, params: dict):
            nonlocal etapa
            etapa = metodo
            ws.send(json.dumps({"jsonrpc": "2.0", "id": ident, "method": metodo, "params": params}))
            # Prazo total, não por mensagem: notificações em sequência não podem segurar a abertura.
            while True:
                msg = json.loads(ws.recv(timeout=max(0.0, limite - time.monotonic())))
                if isinstance(msg, dict) and msg.get("id") == ident and "method" not in msg:
                    if msg.get("error"):
                        erro = msg["error"]
                        codigo = erro.get("code") if isinstance(erro, dict) else None
                        raise _RpcError(codigo if type(codigo) is int else None)
                    return msg.get("result") or {}

        with connect(endpoint, open_timeout=5, close_timeout=1, max_size=None) as ws:
            pedir(ws, 1, "initialize", {"clientInfo": CLIENT_INFO, "capabilities": None})
            dados = pedir(ws, 2, "hooks/list", {"cwds": [cwd]})
            pendentes = [h for entrada in dados.get("data") or [] for h in entrada.get("hooks") or []
                         if h.get("enabled") and h.get("trustStatus") in ("untrusted", "modified")
                         and isinstance(h.get("key"), str) and isinstance(h.get("currentHash"), str)]
            aceitos = {h["key"]: h["currentHash"] for h in pendentes if _sincronizado_pelo_hangar(h)}
            restantes = len(pendentes) - len(aceitos)
            if aceitos:
                edicoes = [{"keyPath": ".".join(json.dumps(p) for p in ("hooks", "state", chave, "trusted_hash")),
                            "value": hash_atual, "mergeStrategy": "replace"}
                           for chave, hash_atual in aceitos.items()]
                pedir(ws, 3, "config/batchWrite", {"edits": edicoes, "reloadUserConfig": True})
                print(f"{_PREFIXO} {len(aceitos)} hooks sincronizados pelo Hangar foram aceitos: "
                      + ", ".join(_screen_key(chave) for chave in aceitos), file=sys.stderr)
            if restantes:
                print(f"{_PREFIXO} {restantes} hooks de outra origem ficam para o Codex perguntar "
                      "no terminal", file=sys.stderr)
    except Exception as exc:
        if isinstance(exc, _RpcError):
            detalhe = f"código {exc.code}" if exc.code is not None else "recusado"
        else:
            detalhe = type(exc).__name__
        print(f"{_PREFIXO} não deu para aceitar os hooks ({etapa}, {detalhe}); "
              "o Codex vai perguntar no terminal", file=sys.stderr)


def _espera_thread(endpoint: str, cwd: str, servidor, erros, salvar) -> None:
    """Acompanha as threads principais abertas pela TUI durante a vida do pane.

    A TUI e quem chama thread/start: uma thread aberta por outro cliente e ainda sem turno nao tem
    rollout no disco, e `codex resume` a rejeita. Aqui so olhamos.
    """
    from websockets.sync.client import connect
    from app.adapters.codex.lancador import CLIENT_INFO
    from app.adapters.codex.sessions import primary_thread

    limite = time.monotonic() + _ESPERA_THREAD
    ws = None
    while ws is None and time.monotonic() < limite:
        if servidor.poll() is not None:
            return   # quem avisa e o `_esperar_porta` da thread principal, uma vez so
        try:
            ws = connect(endpoint, open_timeout=1, max_size=None)
        except Exception:
            time.sleep(0.1)
    if ws is None:
        print(f"hangar-codex-tui: app-server nao respondeu em {endpoint}", file=sys.stderr)
        return
    from websockets.exceptions import ConnectionClosed
    with ws:
        try:
            ws.send(json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize",
                                "params": {"clientInfo": CLIENT_INFO, "capabilities": None}}))
            for cru in ws:
                try:
                    msg = json.loads(cru)
                except ValueError:
                    continue
                if not isinstance(msg, dict) or msg.get("method") != "thread/started":
                    continue
                thread = (msg.get("params") or {}).get("thread") or {}
                if not primary_thread(thread, cwd):
                    continue
                if thread.get("id") and thread.get("path"):
                    salvar(thread["id"], thread["path"], thread)
        except ConnectionClosed:
            # Servidor foi embora (a TUI saiu e o `finally` o matou): nao ha o que salvar, e um
            # traceback aqui so suja o pane por cima do erro de verdade.
            return


def main() -> int:
    ap = argparse.ArgumentParser(prog="hangar-codex-tui")
    # O nome vem do env por padrao: `tmux new-session` ja carimba CP_SESSION_NAME no pane, entao o
    # backend nao precisa repetir a identidade no comando.
    ap.add_argument("--name", default=os.environ.get("CP_SESSION_NAME"))
    ap.add_argument("--cwd", default=None)
    ap.add_argument("--prompt", default=None)
    ap.add_argument("--resume", default=None,
                    help="retoma a conversa deste id em vez de abrir uma nova")
    ap.add_argument("--model", default=None, help="modelo do Codex (vira `-m` na TUI)")
    ap.add_argument("--effort", default=None,
                    help="nivel de raciocinio; vira sobrescrita de config, nao flag")
    ap.add_argument("--service-tier", choices=("default", "priority"), default=None, help=argparse.SUPPRESS)
    ap.add_argument("--codex-home", default=None, help=argparse.SUPPRESS)
    ap.add_argument("--codex-account", default=None, help=argparse.SUPPRESS)
    ap.add_argument("--approval-policy", choices=("never", "on-request"), default=None)
    ap.add_argument("--sandbox", choices=("read-only", "workspace-write", "danger-full-access"), default=None)
    ap.add_argument("--tool-output-token-limit", type=int, default=None)
    ap.add_argument("--transfer-id", default=None, help=argparse.SUPPRESS)
    args = ap.parse_args()
    if args.tool_output_token_limit is not None and args.tool_output_token_limit <= 0:
        ap.error("--tool-output-token-limit precisa ser positivo")
    if not args.name:
        print("hangar-codex-tui: --name (ou CP_SESSION_NAME) e obrigatorio", file=sys.stderr)
        return 2
    _com_websockets()
    sys.path.insert(0, str(_REPO / "backend"))
    from app.adapters.codex import sessions as codex_sessions
    from app.adapters.codex.lancador import (APPROVAL, NO_UPDATE_CHECK, SANDBOX, PERMISSION_POLICIES,
                                            identity_override, service_tier_override, tool_output_override)
    launch_key = None
    def runtime():
        live = codex_sessions.load(args.name)
        if args.transfer_id and launch_key and live and live.get("key") == launch_key:
            return live
        return (codex_sessions.transfer_runtime(args.name, args.transfer_id) if args.transfer_id
                else live)

    def update_runtime(**fields):
        if args.transfer_id:
            current = runtime() or {}
            if current.get("transfer_id") != args.transfer_id:
                with codex_sessions._locked(args.name):
                    live = codex_sessions.load(args.name)
                    if not live or live.get("key") != launch_key:
                        raise RuntimeError("session_transfer_runtime_identity_changed")
                    updated = {**live, **fields}
                    codex_sessions._write(args.name, updated)
                    return updated
            from app.conversation_transfer import _processes
            processes = dict(current.get("processes", {}))
            for field in ("app_pid", "tui_pid", "launcher_pid"):
                if fields.get(field):
                    processes.update(_processes(fields[field]))
            fields["processes"] = processes
        return (codex_sessions.update_transfer_runtime(args.name, args.transfer_id, **fields)
                if args.transfer_id else codex_sessions.update(args.name, **fields))

    existing = runtime()
    launch_key = (existing or {}).get("key")
    if args.transfer_id and (not existing or existing.get("thread_id") != args.resume):
        ap.error("runtime preparado não pertence à conversa pedida")
    imported_resume = bool(existing and existing.get("transfer_id") and existing.get("thread_id") == args.resume)
    if imported_resume:
        required = ("codex_home", "codex_account", "key", "cwd", "permission_mode")
        if (existing.get("name") != args.name
                or any(not isinstance(existing.get(field), str) or not existing[field] for field in required)
                or not Path(existing["codex_home"]).is_absolute()
                or not Path(existing["cwd"]).is_absolute()
                or existing["permission_mode"] not in PERMISSION_POLICIES):
            ap.error("metadados da conversa importada inválidos; nenhuma sessão foi aberta")
        args.codex_home = args.codex_home if args.codex_home is not None else existing["codex_home"]
        args.codex_account = args.codex_account if args.codex_account is not None else existing["codex_account"]
        args.cwd = args.cwd if args.cwd is not None else existing["cwd"]
        saved_approval, saved_sandbox = PERMISSION_POLICIES[existing["permission_mode"]]
        args.approval_policy = args.approval_policy if args.approval_policy is not None else saved_approval
        args.sandbox = args.sandbox if args.sandbox is not None else saved_sandbox
        for key in ("CP_SESSION_KEY", "TMUX", "TMUX_PANE", "HANGAR_CANO_KEY"):
            os.environ.pop(key, None)
        os.environ["CP_SESSION_KEY"] = existing["key"]
    if existing and existing.get("thread_id") == args.resume:
        if args.tool_output_token_limit is None:
            args.tool_output_token_limit = existing.get("tool_output_token_limit")
        # Relançar a própria sessão (o Rust passa só --cwd/--resume e a chave): o resto vem do sidecar.
        own = bool(args.resume and existing.get("key") and existing["key"] == os.environ.get("CP_SESSION_KEY"))
        fields = ("model", "effort") if existing.get("transfer_id") or own else ()
        for field in fields + (("service_tier", "codex_home", "codex_account") if own else ()):
            setattr(args, field, getattr(args, field) if getattr(args, field) is not None else existing.get(field))
        if own and args.approval_policy is None and args.sandbox is None:
            # Sem modo conhecido não relança: o padrão do lançador é Full Access.
            if existing.get("permission_mode") not in PERMISSION_POLICIES:
                ap.error("modo de permissão da sessão desconhecido; nenhuma sessão foi aberta")
            args.approval_policy, args.sandbox = PERMISSION_POLICIES[existing["permission_mode"]]
    args.codex_account = args.codex_account if args.codex_account is not None else "default"
    cwd = os.path.abspath(args.cwd or os.getcwd())
    selected_home = (Path(args.codex_home).expanduser().absolute()
                     if args.codex_home else Path(os.environ.get("CODEX_HOME") or
                                                  Path.home() / ".codex").absolute())
    os.environ["CP_SESSION_NAME"] = args.name
    os.environ["CODEX_HOME"] = str(selected_home)
    approval = args.approval_policy or APPROVAL
    sandbox = args.sandbox or SANDBOX
    resumed_mode = next((mode for mode, policy in PERMISSION_POLICIES.items()
                         if policy == (approval, sandbox)), None)
    if imported_resume and resumed_mode is None:
        ap.error("combinação de aprovação e sandbox não suportada para conversa importada; sessão preservada")
    # O modo gravado é o que a sessão criada por esta herda; par sem modo do app não apaga o que havia.
    mode_record = {"permission_mode": resumed_mode} if resumed_mode else {}
    if resumed_mode is None:
        print(f"hangar-codex-tui: aprovação {approval} com sandbox {sandbox} não é um modo do app; "
              "o modo gravado da sessão fica como estava", file=sys.stderr)
    resumed_metadata = ({"codex_home": str(selected_home), "codex_account": args.codex_account,
                         "cwd": cwd, "permission_mode": resumed_mode} if imported_resume else {})
    from app import codex_contas
    from app.codex_instrucoes import (LIMITE_INSTRUCOES, limite_instrucoes,
                                      preparar_instrucoes, preparar_projeto)

    account = codex_contas.Account(
        args.codex_account,
        selected_home, args.codex_account == "default",
    )
    ambiente = codex_contas.environment(account, base=os.environ)
    os.environ.clear()
    os.environ.update(ambiente)

    if not account.is_default and not imported_resume:
        try:
            resultado = _preparar_conta_codex(account.id, cwd)
            status = resultado.get("status")
            if status == "running":
                # O GET só confia a pasta depois das escritas do preparo; aqui a TUI sobe antes dele.
                from app.adapters.codex import sessions
                sessions.pretrust_cwd(cwd, codex_home=account.home)
                print("hangar-codex-tui: sincronização da conta segue em segundo plano; "
                      "vale a partir da próxima sessão", file=sys.stderr)
            elif status != "ready":
                print(f"hangar-codex-tui: última sincronização da conta: {status or 'desconhecida'}",
                      file=sys.stderr)
                for issue in resultado.get("issues", []):
                    print(f"hangar-codex-tui: {_texto(issue) or issue.get('code', 'aviso da sincronização')}",
                          file=sys.stderr)
        except Exception as exc:                          # noqa: BLE001
            print(f"hangar-codex-tui: sincronização da conta não pôde ser pedida ({exc}); "
                  "o Codex abre com a config atual da conta", file=sys.stderr)

    # O cwd novo ainda pode não estar no config do Codex. O alias precisa existir antes do app-server.
    # Falha (override pessoal, config.toml ilegível) não impede a TUI: fica sem alias e sem limite maior.
    codex_home = selected_home
    limite = LIMITE_INSTRUCOES
    if not imported_resume:
        print("hangar-codex-tui: preparando as instruções do Codex…", file=sys.stderr)
    if account.is_default and not imported_resume:
        try:
            preparar_instrucoes(Path.home(), codex_home, Path(cwd))
            limite = limite_instrucoes(codex_home)
        except Exception as exc:                          # noqa: BLE001
            print(f"hangar-codex-tui: instruções nativas não preparadas ({exc}); a sessão abre assim mesmo",
                  file=sys.stderr)
    elif not imported_resume:
        try:
            preparar_projeto(codex_home, Path(cwd))
            limite = limite_instrucoes(codex_home)
        except Exception as exc:                          # noqa: BLE001
            print(f"hangar-codex-tui: limite de instruções da conta não pôde ser lido ({exc})",
                  file=sys.stderr)

    # Quem reconcilia é o BACKEND (um executor só, e uma instalação longa termina lá); a abertura
    # não espera, e a sessão lê a config que já existe. Falha não impede a TUI.
    if account.is_default and not imported_resume:
        try:
            resultado = _integracao_codex()
            if resultado.get("estado") == "executando":
                print("hangar-codex-tui: integração do Codex segue em segundo plano; "
                      "vale a partir da próxima sessão", file=sys.stderr)
            elif resultado.get("estado") not in (None, "ocioso", "ok") or resultado.get("erros"):
                print(f"hangar-codex-tui: integração Codex: {resultado['estado']} — {_texto(resultado.get('etapa'))}",
                      file=sys.stderr)
            for aviso in [*resultado.get("avisos", []), *resultado.get("erros", [])]:
                print(f"hangar-codex-tui: {_texto(aviso)}", file=sys.stderr)
            if resultado.get("confianca_pendente"):
                print("hangar-codex-tui: há itens aguardando sua confirmação de confiança no Codex",
                      file=sys.stderr)
        except Exception as exc:                          # noqa: BLE001
            print(f"hangar-codex-tui: integração Codex falhou ({exc}); a sessão abre assim mesmo",
                  file=sys.stderr)

    endpoint = _porta_livre()
    # stdout no lixo (no modo WebSocket o protocolo nao passa por ele), mas o stderr vai pra um
    # arquivo temporario: PIPE sem consumidor encheria numa sessao longa, e DEVNULL jogaria fora
    # justamente a mensagem que explica uma largada que falhou.
    erros = tempfile.TemporaryFile()
    # O preparo conferiu a configuração da conta; a retomada não amplia as instruções.
    instruction_overrides = [] if imported_resume else ["-c", f"project_doc_max_bytes={limite}"]

    previous_thread = None

    def selected_service_tier():
        if previous_thread is None and args.service_tier is not None:
            return args.service_tier
        saved = runtime() or {}
        thread_id = previous_thread or args.resume
        return saved.get("service_tier") if thread_id and saved.get("thread_id") == thread_id else None

    def subir_servidor() -> subprocess.Popen:
        try:
            return subprocess.Popen(
                # Sandbox e aprovacao tambem no SERVIDOR: o thread/resume que a TUI faz ao reconectar
                # nao repassa as flags dela, e a conversa caia em `Workspace` com aprovacao.
                [_codex(), "app-server", "--listen", endpoint, *instruction_overrides,
                 "-c", f'sandbox_mode="{sandbox}"', "-c", f'approval_policy="{approval}"',
                 *tool_output_override(args.tool_output_token_limit),
                 *service_tier_override(selected_service_tier()), *identity_override(os.environ)],
                stdout=subprocess.DEVNULL, stderr=erros, cwd=cwd,
            )
        except (OSError, SystemExit) as exc:
            _registrar_falha_servidor(erros, "criar_processo", exc=exc)
            raise

    _atualizar_codex()
    servidor = subir_servidor()

    def salvar(thread_id: str, rollout: str, thread: dict | None = None) -> None:
        nonlocal previous_thread
        # A escolha do usuario vai pro sidecar, nao so pro comando da TUI: quem responde a pill do
        # app e `CodexAdapter.current_model`, que le daqui. Sem isto a sessao NASCIA no modelo certo
        # (o `-m` da TUI) e a pill mostrava vazio — o ramo `_conectar` do sidecar com endpoint so
        # conecta, entao o `default_model` da thread nunca chega a ser lido.
        if previous_thread is None:
            existing = runtime()
            if existing and existing.get("key") and existing.get("thread_id") == args.resume == thread_id:
                update_runtime(headless=False, cano=None, launching=False,
                                      endpoint=endpoint, app_pid=servidor.pid, launcher_pid=os.getpid(),
                                      model=args.model, effort=args.effort, rollout_path=rollout,
                                      tool_output_token_limit=args.tool_output_token_limit,
                                      **{**mode_record, **resumed_metadata},
                                      **({"service_tier": args.service_tier} if args.service_tier is not None else {}))
            else:
                codex_sessions.save(args.name, thread_id, rollout, cwd,
                                model=args.model, effort=args.effort,
                                endpoint=endpoint, app_pid=servidor.pid,
                                codex_home=str(codex_home),
                                codex_account=args.codex_account,
                                tool_output_token_limit=args.tool_output_token_limit,
                                # A chave do spec que o Rust pôs no pane: o registro da sessão é por ela.
                                key=os.environ.get("CP_SESSION_KEY") or None,
                                service_tier=args.service_tier, **mode_record)
        elif thread_id != previous_thread and thread is not None:
            if args.transfer_id:
                from app.conversation_transfer import load_transfer, TransferPhase
                record = load_transfer(args.transfer_id)
                if not record or record.phase != TransferPhase.COMPLETE:
                    raise RuntimeError("session_transfer_unexpected_import_turn")
            codex_sessions.switch_thread(args.name, thread, previous_thread,
                                         endpoint=endpoint, app_pid=servidor.pid)
        previous_thread = thread_id

    escuta = None
    if args.resume:
        # Retomando, a identidade JA e conhecida e nao ha `thread/started` pra esperar — medido:
        # numa conversa retomada o evento nao vem, e ficar esperando por ele deixava a sessao sem
        # sidecar, ou seja, invisivel no app que mandou retomar.
        rollout = _rollout_de(args.resume)
        if not rollout:
            print(f"hangar-codex-tui: nao achei o rollout da conversa {args.resume}",
                  file=sys.stderr)
        else:
            salvar(args.resume, rollout)
    escuta = threading.Thread(target=_espera_thread,
                              args=(endpoint, cwd, servidor, erros, salvar), daemon=True)
    escuta.start()

    # SIGTERM/SIGHUP viram SystemExit pra que o `finally` rode: `tmux kill-session` derruba o pane
    # por sinal, e sem isto o app-server ficaria escutando sem dono.
    # `getattr`: SIGHUP nao existe no Windows e o acesso direto levantava AttributeError aqui,
    # matando o pane DEPOIS de o app-server ja ter subido (medido 07/09/2026). No Linux os dois
    # existem e o laco e o mesmo de antes.
    for nome in ("SIGTERM", "SIGHUP"):
        sinal = getattr(signal, nome, None)
        if sinal is not None:
            signal.signal(sinal, lambda *_: sys.exit(143))

    # A escolha de modelo do usuario, traduzida pro que o binario entende. Sao DUAS gramaticas
    # diferentes e e por isso que a traducao mora aqui, e nao no model_args como a dos outros
    # agentes: o modelo tem flag (`-m`), o esforco NAO tem — ele e uma chave de configuracao
    # (`model_reasoning_effort`, confirmada com `codex exec --strict-config`, que recusa chave
    # inventada). O valor vai entre aspas porque o `-c` parseia como TOML.
    # Medido em 30/08/2026 (codex-cli 0.151.0): nivel fora do suporte do modelo NAO mata o
    # arranque — o binario DESCARTA o nivel e segue com o dele. Por isso quem recusa a escolha
    # errada e o backend, cruzando modelo x nivel no catalogo (`codex_models.checar_escolha`).
    # As flags valem nos DOIS ramos, resume incluido: hoje ninguem passa modelo num resume, mas
    # montar so num deles faria um `--model` com `--resume` ser aceito e ignorado calado.
    flags_da_escolha = list(NO_UPDATE_CHECK)
    if args.model:
        flags_da_escolha += ["-m", args.model]
    if args.effort:
        flags_da_escolha += ["-c", f'model_reasoning_effort="{args.effort}"']

    if args.resume:
        # Sem `--sandbox`/`--ask-for-approval` aqui: com `--remote`, o resume os RECUSA ("Permission
        # overrides are not supported when resuming a remote task") e a TUI morre na hora. Quem
        # carrega os dois e o app-server, que sobe com `-c sandbox_mode=`/`-c approval_policy=` —
        # e a thread retomada corre dentro dele.
        # `-C` fica de fora porque o pane ja nasce no cwd certo (`tmux new-session -c`) e a conversa
        # carrega o dela; o id vai no fim, onde o subcomando o espera.
        argv = [_codex(), "resume", "--remote", endpoint, "--no-alt-screen",
                *service_tier_override(selected_service_tier()), *flags_da_escolha, args.resume]
    else:
        argv = [_codex(), "--remote", endpoint, "--no-alt-screen", "-C", cwd,
                "--sandbox", sandbox, "--ask-for-approval", approval,
                *service_tier_override(selected_service_tier()), *flags_da_escolha]
    if args.prompt:
        argv.append(args.prompt)
    try:
        # A espera abaixo pode levar segundos com a maquina carregada, e ate a TUI desenhar o pane
        # fica em branco — de fora, indistinguivel de um terminal que nao abriu nada.
        print("hangar-codex-tui: subindo o app-server do Codex…", file=sys.stderr)
        if not _esperar_porta(endpoint, servidor, erros, _ESPERA_THREAD):
            return 1
        _confiar_hooks(endpoint, cwd)
        tui = subprocess.Popen(argv)
        update_runtime(tui_pid=tui.pid)
        # O servidor pode morrer com a TUI viva (SIGTERM alheio, crash). A TUI `--remote` tenta
        # reconectar por ~1 min e depois desiste PRA SEMPRE — nem mensagem nova a acorda. Subir
        # outro na MESMA porta dentro dessa janela faz ela retomar a thread sozinha, sem relançar
        # o pane; o backend se religa pelo pid novo do sidecar.
        quedas: list[float] = []
        desisti = False
        while tui.poll() is None:
            if servidor.poll() is not None and not desisti:
                # Fechar o terminal derruba os dois quase juntos: a TUI saindo logo depois é o fim
                # da sessão, não queda do servidor.
                try:
                    tui.wait(timeout=_FIM_DA_SESSAO)
                    break
                except subprocess.TimeoutExpired:
                    pass
                quedas = [t for t in quedas if time.monotonic() - t < 300] + [time.monotonic()]
                if len(quedas) > _QUEDAS_MAX:
                    # A TUI fica: o pane ainda mostra o scrollback e este aviso. Matar a TUI
                    # apagaria a sessao inteira da tela por causa do servidor.
                    print("hangar-codex-tui: app-server caindo em laço; desisto de ressubir",
                          file=sys.stderr)
                    desisti = True
                    continue
                _avisar_servidor_morto(endpoint, servidor, erros, etapa="executar_app_server")
                servidor = subir_servidor()
                if not _esperar_porta(endpoint, servidor, erros, _ESPERA_THREAD):
                    # Vivo sem porta enganaria o `poll()` acima; morto, conta como queda.
                    servidor.kill()
                    continue
                if args.transfer_id:
                    update_runtime(app_pid=servidor.pid)
                else:
                    codex_sessions.update_app_pid(args.name, servidor.pid)
                # A escuta antiga morreu com o socket. Sem uma nova, sessao que caiu antes do
                # primeiro thread/started nunca ganharia sidecar (update_app_pid e no-op sem ele).
                escuta = threading.Thread(target=_espera_thread,
                                          args=(endpoint, cwd, servidor, erros, salvar),
                                          daemon=True)
                escuta.start()
                print(f"hangar-codex-tui: app-server ressubido em {endpoint}", file=sys.stderr)
            time.sleep(0.5)
        return tui.wait()
    finally:
        servidor.terminate()
        try:
            servidor.wait(timeout=5)
        except subprocess.TimeoutExpired:
            servidor.kill()
        # A thread de escuta SAI sozinha com o servidor morto (ela testa `servidor.poll()`), mas
        # ainda precisa de um instante — e ela le o `erros` e chama `salvar()`. Sem esperar, ou ela
        # lia um arquivo ja fechado, ou gravava um sidecar apontando pro servidor que acabou de
        # morrer: sessao fantasma que nada limpa depois.
        if escuta is not None:
            escuta.join(timeout=5)
        erros.close()
        # So apaga o sidecar que e NOSSO: uma sessao recriada com o mesmo nome ja teria reescrito o
        # arquivo, e apagar o dela deixaria a sessao viva invisivel pro app.
        meta = codex_sessions.load(args.name)
        if meta and meta.get("app_pid") == servidor.pid and (not args.transfer_id or meta.get("key") == launch_key):
            if args.transfer_id:
                from app.conversation_transfer import load_transfer, TransferPhase
                record = load_transfer(args.transfer_id)
                if record and record.phase == TransferPhase.COMPLETE:
                    codex_sessions.delete(args.name)
            else:
                codex_sessions.delete(args.name)


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
# hangar-send — mensagem entre sessões Claude via hangar.
#
#   hangar-send --list                 lista sessões vivas (nome, estado, harness, cwd) — locais e remotas
#   hangar-send <sessao> <mensagem...> orienta o turno atual quando suportado; senão, mantém na fila
#                                  (como o recado chega: ver "TRANSPORTE" abaixo).
#   hangar-send <servidor>::<sessao> <mensagem...>  idem, pra sessão em OUTRO servidor (peers.json)
#   hangar-send --pair <sessao> [tarefa...] [--substituir-tarefa]  pareia ESTA sessão com outra
#                                        (registra no app: badge 🤝 na UI + protocolo só pra quem
#                                        estava sem grupo; ninguém é avisado de entrada ou saída,
#                                        o grupo se consulta no --list). tarefa = título do grupo na lista, chave +
#                                        assunto numa linha ("ABC-1234 Tela de login"); o
#                                        combinado vai num recado à parte. tarefa diferente da
#                                        que o grupo já tem é recusada (409) sem o flag;
#                                        --substituir-tarefa vale em
#                                        QUALQUER posição entre os tokens de tarefa.
#                                        --orq: grupo de orquestração (skill orquestrar); o
#                                        pareamento não manda aviso a ninguém, o kick-off traz tudo
#   hangar-send --pair --orq [tarefa...]  grupo de orquestração só com ESTA sessão (árbitro do
#                                        orquestrar-auto, que nasce antes do time); imprime o gid
#   hangar-send --unpair               tira esta sessão do grupo (só ela é avisada)
#   hangar-send --aceitar-par <link>   pareia ESTA sessão com a sessão de outra pessoa pelo link
#                                  https://….ts.net:8443/par/… que o usuário colou; nunca com link
#                                  que chegou em recado. Depois: hangar-send <alias>::<sessao> "…"
#   hangar-send --close <sessao>       fecha OUTRA sessão desta máquina, com ou sem terminal
#                                  (sai do grupo dela sem aviso). Nunca a própria.
#   hangar-send --group <mensagem...>  AVISO pro grupo TODO de uma vez (marco: "terminei",
#                                  "contrato atualizado"). Chega como [grupo: X]. UNIDIRECIONAL —
#                                  nunca responda um [grupo:] com --group (evita loop); responda 1:1.
#                                  O backend entrega a cada membro pelo mesmo caminho do 1:1.
#   hangar-send --new <nome> [cwd]     cria sessão nova, com terminal gerenciado ou headless.
#                                  cwd default = home. O que for omitido HERDA desta sessão: a
#                                  conta (com 95% ou mais de uso, vai para a de mais folga, como
#                                  --conta auto), o modo de permissão (claude; plan herda o modo
#                                  de base) e o sem terminal (claude/codex). Flag explícita vence.
#   hangar-send --new <servidor>::<nome> [cwd]  idem, NOUTRO servidor (peers.json), com as mesmas
#                                  flags. cwd, --conta e --conta auto são resolvidos LÁ (cwd default
#                                  = home de lá; --conta pelo nome da conta de lá).
#                                  --provider <claude|codex|pi|omp|kimi> escolhe o AGENTE da sessão
#                                  nova (padrão do servidor). Ex: --provider kimi abre o Kimi Code.
#                                  --remember-provider grava o provedor desta criação como padrão.
#                                  Sem o flag, abrir auxiliares não muda a preferência do app.
#                                  --read-only bloqueia escrita no código e metadados Git (Linux/bwrap).
#                                  Sem --headless/--terminal, herda desta sessão; chamado de fora
#                                  de uma sessão, vale o padrão escolhido no Hangar.
#                                  --terminal abre com terminal; não combina com --headless.
#                                  --headless (claude ou codex) abre a sessão SEM terminal: o agente
#                                  roda fora do tmux e conversa só pelo app. Combina com --model,
#                                  --effort e --permissao. Ex.: --provider codex --headless
#                                  --permissao "Full Access".
#                                  --engine <motor> nasce num motor de ~/.claude/engines.json
#                                  (outro modelo, conta do provedor — ver "Par noutro modelo").
#                                  --conta <nome> nasce em OUTRA CONTA Anthropic (ver abaixo); com
#                                  --provider codex, numa conta Codex (~/.codex-<nome>;
#                                  openai-codex = a padrão).
#                                  --subagente <modelo> (claude sem motor) define o modelo dos
#                                  subagentes da sessão.
#                                  --service-tier <default|priority> liga (priority) ou desliga o
#                                  Fast: Codex, ou Claude com motor GPT no CLIProxyAPI local.
#                                  --profile <nome> (só --provider omp) nasce num perfil do omp:
#                                  login, sessões e config em ~/.omp/profiles/<nome>/agent.
#                                  --conta auto deixa a cota escolher: a conta Claude com mais
#                                  folga na janela que mais aperta (5h, 7d ou a do modelo).
#                                  --model <id> abre no modelo escolhido — vale pra claude, codex,
#                                  pi e kimi. --effort <nivel> abre nesse esforço (claude/codex;
#                                  no pi vira --thinking, que aceita também off/minimal; kimi não
#                                  tem esforço por flag). SEMPRE prefira nascer no
#                                  modelo/esforço certo a mandar /model no primeiro recado — a
#                                  sessão trabalha ANTES de ler o recado.
#                                  --jev / --sem-jev liga ou desliga o Jev naquela sessão: com ele,
#                                  `hangar-preview objetivo` navega e preenche tela sozinho. Sem
#                                  nenhum dos dois vale o padrão do servidor (tela de Configurações).
#   hangar-send --whoami               imprime o nome desta sessão (a identidade que assina os recados)
#   hangar-send --help                esta ajuda (o cabeçalho deste arquivo).
#
# OUTRA CONTA: cada conta é um config dir próprio (~/.claude-<nome>), com skills/hooks symlinkados
# do ~/.claude e credenciais + transcritos separados. `hangar-conta --list` mostra as configuradas,
# `hangar-conta --new <nome>` cria uma (o /login é interativo, feito na primeira sessão dela).
# `hangar-send --new <nome> <cwd> --conta 200-01` abre a sessão já logada naquela conta — o consumo vai
# pra assinatura DELA, não pra conta padrão. Sem o flag, nasce na conta padrão (~/.claude).
# `--conta auto` pergunta ao backend (GET /api/cotas/sugestao) qual conta tem mais folga e nasce
# nela; sem nenhuma conta com leitura de cota o script para com erro, nunca cai calado na padrão.
#
# Remetente é detectado pelo sidecar no modo sem terminal ou pelo tmux e prefixado como "[de: X]",
# pra sessão destino saber a origem e pra onde responder.
#
# HANGAR_SEND_PAINEL=1 (só recado 1:1, desta máquina): o texto vai como está, sem "[de: X]" e sem
# procurar o remetente. É o aviso de um programa (o orquestrador do orq), não de uma sessão: o
# modelo responde a quem assina. O texto tem de começar com "[painel:"; senão sai 2 sem enviar.
#
# Cross-server: backend/peers.json (ver peers.json.example; NUNCA commitar — tem token) mapeia
# id -> {base_url, token} dos outros servidores, e CP_SERVER_ID no backend/.env é o id DESTA
# máquina — vira o endereço de resposta ([de: <id>::<sessao>]) quando o recado cruza servidor.
# --pair cross-server (servidor::sessao) FUNCIONA (1:1): o backend local resolve peers.json + chama
# o /pair-remote do outro. --new servidor::nome cria lá pela API do outro. ponytail: --group
# cross-server ainda não existe — só recado 1:1, --pair, --new e --list.
#
# TRANSPORTE É DO BACKEND, NUNCA DO MODELO. Pra sessão Claude desta máquina o backend escreve o
# recado direto no socket nativo do Claude Code (`cc-socks/<pid>.sock`, o mesmo do SendMessage):
# sem digitar no terminal, sem teto de 16KB, sem \n submetendo linha, e entra no MEIO do turno do
# destino. Sem socket (sessão aberta antes da liberação, Codex, Pi, outra máquina) cai pro plugin,
# pro tmux ou pra fila durável, nesta ordem. A saída diz o que aconteceu: "entregue agora …
# (socket nativo…)", "entregue", "na fila" ou erro. Não existe "use outra ferramenta": se este
# comando não entregou, ele diz que não entregou. `--tmux` fica aceito e é ignorado.
# Retenção ou recusa pelo destino (política crossSessionInbound dele) chega depois como aviso
# `[painel: entrega de recado]` na sessão remetente. A mensagem é ARGUMENTO, nunca stdin: heredoc cru
# (`hangar-send <s> <<'EOF'`) dá erro de uso e nada sai. Texto com crase ou $ vai assim:
#   hangar-send <sessao> "$(cat <<'EOF'
#   ...texto livre...
#   EOF
#   )"
set -euo pipefail

# --help imprime o CABEÇALHO deste arquivo, não um texto paralelo: ajuda que vive longe da regra
# envelhece calada, e foi o que aconteceu — o `--help` não existia, caía no parse de destino e
# imprimia só a linha do envio 1:1, fazendo quem lesse concluir que --new/--engine/--conta não
# existiam. Para no primeiro não-comentário, então flag nova documentada acima já sai aqui.
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$(realpath "$0")"
    exit 0
fi

ENV_FILE="$(dirname "$(realpath "$0")")/../backend/.env"
TOKEN=$(grep '^CP_AUTH_TOKEN=' "$ENV_FILE" | cut -d= -f2-)
PORT=$(grep '^CP_PORT=' "$ENV_FILE" | cut -d= -f2- || true)
BASE="http://127.0.0.1:${PORT:-8765}"
AUTH="Authorization: Bearer $TOKEN"
PEERS_FILE="$(dirname "$ENV_FILE")/peers.json"
SERVER_ID=$(grep '^CP_SERVER_ID=' "$ENV_FILE" | cut -d= -f2- || true)

# peer_cfg <id> — imprime "base_url token" do servidor remoto no peers.json; erro claro se ausente.
peer_cfg() {
    if [[ ! -f "$PEERS_FILE" ]]; then
        echo "erro: servidor '$1' desconhecido — crie $PEERS_FILE (ver peers.json.example)" >&2
        return 1
    fi
    python3 - "$PEERS_FILE" "$1" <<'PY'
import json, sys
try:
    peers = json.load(open(sys.argv[1]))
    p = peers.get(sys.argv[2])
    # Entrada só com "app" é máquina da lista do app, não peer de recado.
    if not p or not p.get("base_url"):
        known = ", ".join(peers) or "nenhum"
        sys.exit("erro: servidor '%s' não está em %s (conhecidos: %s)" % (sys.argv[2], sys.argv[1], known))
    # \t como separador (mesmo formato do peers_tsv do --list): token/URL com espaço não quebra o parse.
    print("%s\t%s" % (p["base_url"].rstrip("/"), p["token"]))
except Exception as e:  # qualquer problema de parse vira mensagem clara, nunca traceback
    sys.exit("erro: %s inválido (%s)" % (sys.argv[1], e))
PY
}

# api <METHOD> <path> [json-body] — imprime o corpo no stdout; falha (!2xx) imprime status + corpo
# real da API no stderr e retorna 1. Sem -f: mascarar o detail ("sessão não encontrada" vs 401 vs
# 502) deixava quem chama (inclusive um Claude) sem como se corrigir.
# Máquina desligada no Tailscale não RECUSA a conexão, ela pendura: sem --connect-timeout o curl
# espera o teto do SO e a varredura de peers nunca volta. API_TIMEOUT sobe pra operação local longa.
api() {
    local method=$1 path=$2 body=${3:-} out code
    out=$(curl -s --connect-timeout "${API_CONNECT_TIMEOUT:-3}" -m "${API_TIMEOUT:-30}" \
        -w $'\n%{http_code}' -X "$method" -H "$AUTH" \
        ${body:+-H "Content-Type: application/json" -d "$body"} "$BASE$path") || {
        # Peer da varredura fora do ar é AVISO, não erro: o comando local respondeu. "erro:" aqui
        # fazia o cartão do app dizer "o backend do hangar não respondeu" com a lista inteira na tela.
        if [[ -n "${API_PEER:-}" ]]; then echo "⚠ servidor '$API_PEER' fora do ar ($BASE)" >&2
        else echo "erro: backend inacessível em $BASE (hangar rodando?)" >&2; fi
        return 1; }
    code=${out##*$'\n'}
    out=${out%$'\n'*}
    if [[ $code == 2* ]]; then printf '%s' "$out"; return 0; fi
    if [[ -n "${API_PEER:-}" ]]; then echo "⚠ servidor '$API_PEER' respondeu HTTP $code ($BASE): $out" >&2
    else echo "erro HTTP $code: $out" >&2; fi
    return 1
}

# Diz o que aconteceu com o envio, a partir da resposta do backend (native/steered/delivered).
# delivered=True -> digitou agora na TUI; False -> fila durável (entrega quando a sessão ficar idle).
relatar_envio() {
    local resp=$1 target=$2
    if python3 -c 'import json,sys; sys.exit(0 if json.loads(sys.argv[1]).get("native") else 1)' "$resp" 2>/dev/null; then
        echo "entregue agora -> $target (no socket do Claude dele, entra no meio do turno; retenção ou recusa pela política de lá chega depois como aviso [painel: entrega de recado])"
    elif python3 -c 'import json,sys; sys.exit(0 if json.loads(sys.argv[1]).get("steered") else 1)' "$resp" 2>/dev/null; then
        echo "entregue agora -> $target"
    elif python3 -c 'import json,sys; sys.exit(0 if json.loads(sys.argv[1]).get("delivered") else 1)' "$resp" 2>/dev/null; then
        echo "entregue -> $target (não orientado no turno atual)"
    else
        echo "na fila -> $target (não orientado; entrega no próximo idle)"
    fi
}

# Pares externos do backend local: ext_body (JSON) e, se falhou, ext_status. Backend sem a rota
# (404 sem "code", ou 405) conta como "nenhum par": é só servidor mais antigo.
ext_pairs_get() {
    local out code resp
    ext_body="[]"; ext_status=""
    out=$(curl -s --connect-timeout 3 -m 8 -w $'\n%{http_code}' -H "$AUTH" "$BASE/api/external-pairs") || {
        ext_status="backend inacessível"; return 1; }
    code=${out##*$'\n'}
    resp=${out%$'\n'*}
    if [[ $code == 2* ]]; then ext_body=$resp; return 0; fi
    if [[ $code == 405 || ( $code == 404 && "$resp" != *'"code"'* ) ]]; then return 0; fi
    ext_status="HTTP $code"
    return 1
}

listar() {
    # Colunas: nome, estado, harness (`provider[:motor]/tmux|headless`), cwd. O cartão do app
    # (frontend/src/lib/hangarCmd.ts) lê essas colunas; mudou aqui, muda lá.
    api GET /api/sessions | python3 -c '
import json, sys
sessions = json.load(sys.stdin)
for s in sessions:
    h = "%s%s/%s" % (s.get("provider") or "?", ":" + s["engine"] if s.get("engine") else "", "headless" if s.get("headless") else "tmux")
    print("%-23s  %-14s  %-17s  %s%s" % (s["name"], s["state"], h, s["cwd"], "  (você)" if s["name"] == sys.argv[1] else ""))
# Entrada e saída não são avisadas: é aqui que a sessão vê com quem está.
eu = next((s for s in sessions if s["name"] == sys.argv[1]), {})
if eu.get("pair_peers"):
    print("# seu grupo: " + ", ".join(eu["pair_peers"]))' "$(me 2>/dev/null)"
    # Servidores do peers.json: mesmas colunas, nome prefixado servidor::sessao (é o endereço
    # que o hangar-send de envio aceita). Peer fora do ar não derruba a lista local — vira aviso.
    if [[ -f "$PEERS_FILE" ]]; then
        peers_tsv=$(python3 -c 'import json, sys
for k, v in json.load(open(sys.argv[1])).items():
    # Só com "app" (sem base_url) é máquina da lista do app, não peer: fora da varredura, calada.
    if isinstance(v, dict) and "app" in v and not v.get("base_url"):
        continue
    # "enabled": false -> máquina que o dono sabe que está desligada. Fica FORA da varredura
    # (cada uma custa o timeout inteiro), mas avisa: some da lista sem nota nenhuma e daqui a
    # duas semanas vira "cadê meu PC?". Endereçar servidor::sessao continua funcionando.
    if isinstance(v, dict) and v.get("enabled") is False:
        print("(%s desativado no peers.json — enderece direto se precisar)" % k, file=sys.stderr)
        continue
    print("%s\t%s\t%s" % (k, v["base_url"].rstrip("/"), v["token"]))' "$PEERS_FILE") \
            || { echo "⚠ $PEERS_FILE inválido — servidores remotos ignorados" >&2; peers_tsv=""; }
        # Um peer POR PROCESSO, todos ao mesmo tempo: em série, uma máquina fora do ar atrasava
        # todas as seguintes pelo tempo dela — e as que vinham depois nem chegavam a ser tentadas.
        # A saída volta arquivada e é impressa na ordem do peers.json, senão as linhas intercalam.
        tmpd=$(mktemp -d) || { echo "erro: mktemp falhou" >&2; exit 1; }
        trap 'rm -rf "$tmpd"' EXIT
        n=0
        while IFS=$'\t' read -r pid pbase ptok; do
            [[ -n "$pid" ]] || continue
            n=$((n + 1))
            (
                BASE="$pbase" AUTH="Authorization: Bearer $ptok" API_TIMEOUT=8 API_PEER="$pid" \
                    api GET /api/sessions \
                    | python3 -c 'import json, sys
try:
    sessions = json.load(sys.stdin)
except ValueError:  # api() falhou -> stdin vazio; a linha de aviso já saiu no stderr dela
    sys.exit(0)
for s in sessions:
    h = "%s%s/%s" % (s.get("provider") or "?", ":" + s["engine"] if s.get("engine") else "", "headless" if s.get("headless") else "tmux")
    print("%-23s  %-14s  %-17s  %s" % (sys.argv[1] + "::" + s["name"], s["state"], h, s["cwd"]))' "$pid"
            ) >"$tmpd/$n.out" 2>"$tmpd/$n.err" &
        done <<< "$peers_tsv"
        wait
        for ((i = 1; i <= n; i++)); do
            cat "$tmpd/$i.out"
            cat "$tmpd/$i.err" >&2
        done
    fi
    # Pares externos (sessão de outra pessoa): o backend devolve o token, que nunca sai na lista.
    ext_pairs_get || echo "⚠ pares externos indisponíveis ($ext_status): a lista pode estar incompleta" >&2
    ext=$ext_body
    python3 -c 'import json, sys
try:
    pares = json.loads(sys.argv[1])
except ValueError:
    sys.exit(0)
for r in pares:
    print("%-23s  par externo de %s (máquina %s)" % (r["alias"] + "::" + r["session"], r["local_session"], r["owner"]))' "$ext"
    exit 0
}

# Quem sou eu. Ordem: carimbo do nascimento (CP_SESSION_NAME, posto pelo new_session no tmux.py) ->
# só então a "sessão corrente" do tmux.
#
# `display-message -p '#S'` NÃO é propriedade de quem chama: é a sessão do CLIENTE anexado, estado
# global do servidor. Com um único cliente anexado (medido: `list-clients` devolvia só
# `/dev/pts/9067: jeffer1312`), TODA sessão que perguntava recebia o mesmo nome. A sessão B rodava
# `hangar-send --unpair`, se identificava como A, e o backend desparava A -> o --unpair de uma desfazia o
# vínculo da OUTRA e o grupo de 2 se dissolvia (2x seguidas, sem ninguém pedir). Também assinava
# recado com o nome errado. O env vem do pane, então é imune ao cliente anexado.
#
# O carimbo só vale se a sessão AINDA se chamar assim: `rename-session` (tmux.py) não reescreve env
# de processo já rodando, e um nome obsoleto endereçaria outra sessão — pior que o bug original.
# has-session com `=` força match EXATO (sem ele o tmux cai em prefix match e `jeffer1312` casaria
# com `jeffer1312-2`); obsoleto -> cai no fallback.
# O fallback é o bug original, então ele AVISA quando é usado de dentro do tmux ($TMUX setado): é o
# único jeito de o dono saber que aquela sessão está no modo ambíguo (aberta por wrapper antigo, ou
# renomeada) antes de um --unpair desfazer o vínculo errado. Fora do tmux não avisa: ali "cli" é o
# esperado, não uma degradação. E `display-message` pode sair 0 imprimindo VAZIO (servidor sem
# cliente anexado); vazio viraria a URL /api/sessions//pair, então cai em "cli" também.
me() {
    # 1) O PANE, que é o dono de verdade. `rename-session` não reescreve env de processo já rodando,
    # então o carimbo fica obsoleto no instante em que o usuário renomeia pelo app — e renomear é
    # FEATURE, não acidente: perder a identidade por usá-la era o app punindo o próprio recurso. O
    # pane id não muda no rename, e vem do env do pane, então também é imune ao cliente anexado.
    #
    # `list-panes -a` contando ocorrências, e não `display-message -t "$TMUX_PANE"`: o psmux
    # (Windows) numera pane id POR SESSÃO, então `%1` pode existir em várias e o display-message
    # devolveria UMA delas, calado — nome errado é pior que nome ausente. Contando, ambiguidade vira
    # "não sei" e cai no carimbo. O awk monta o nome a partir do 2o campo em diante porque nome de
    # sessão pode ter espaço.
    # 0) Sessão SEM terminal: não há pane nem sessão tmux. A chave vem do env do processo
    #    (CP_SESSION_KEY, posta pelo adapter) e não muda no rename nem no /clear; o nome atual é
    #    o do sidecar que carrega essa chave.
    local chave_headless="${CP_SESSION_KEY:-${HANGAR_CANO_KEY:-}}"
    if [[ -n "$chave_headless" ]]; then
        local pasta sidecar nome
        local -a pastas
        if [[ -n "${HANGAR_HEADLESS_DIR:-}" ]]; then
            pastas=("$HANGAR_HEADLESS_DIR")
        else
            pastas=("$HOME/.hangar/claude-headless" "$HOME/.hangar/codex-sessions")
        fi
        for pasta in "${pastas[@]}"; do
            sidecar=$(grep -ls "\"key\": \"$chave_headless\"" "$pasta"/*.json 2>/dev/null | head -1)
            if [[ -n "$sidecar" ]]; then
                nome=$(sed -n 's/.*"name": "\([^"]*\)".*/\1/p' "$sidecar" | head -1)
                if [[ -n "$nome" ]]; then echo "$nome"; return; fi
            fi
        done
    fi
    local dono=""
    if [[ -n "${TMUX_PANE:-}" ]]; then
        dono=$(tmux list-panes -a -F '#{pane_id} #{session_name}' 2>/dev/null |
               awk -v p="$TMUX_PANE" '$1 == p { $1 = ""; sub(/^ /, ""); s = $0; n++ }
                                      END { if (n == 1) print s }')
        if [[ -n "$dono" ]]; then echo "$dono"; return; fi
    fi
    # 2) O carimbo do nascimento, só se a sessão AINDA se chamar assim (Windows, ou tmux sem pane).
    if [[ -n "${CP_SESSION_NAME:-}" ]] && tmux has-session -t "=$CP_SESSION_NAME" 2>/dev/null; then
        echo "$CP_SESSION_NAME"; return
    fi
    # Fora do tmux (systemd, cron, sessão sem terminal) o display-message devolve a última sessão
    # usada por QUALQUER um: o recado sairia assinado por quem não mandou.
    local atual=""
    if [[ -n "${TMUX:-}" ]]; then
        # O observador não é o remetente; vários terminais só dão identidade se concordarem.
        atual=$(tmux list-clients -F $'#{client_control_mode}\t#{session_name}' 2>/dev/null |
            awk -F '\t' 'NF != 2 || ($1 != "0" && $1 != "1") { bad = 1 }
                         $1 == "0" && NF == 2 && $2 != "" { names[$2] = 1; name = $2 }
                         END { for (s in names) n++; if (!bad && n == 1) print name }') || atual=""
        echo "aviso: sessão sem CP_SESSION_NAME válido (wrapper antigo ou sessão renomeada) —" \
             "identidade caiu no 'cliente anexado' e pode sair errada ('${atual:-cli}')." \
             "Reabra a sessão pelo wrapper atualizado pra corrigir." >&2
    fi
    echo "${atual:-cli}"
}

if [[ "${1:-}" == "--whoami" ]]; then
    me
    exit 0
fi

if [[ "${1:-}" == "--list" || $# -eq 0 ]]; then
    listar
fi

if [[ "$1" == "--pair" ]]; then
    # `--pair --orq [tarefa...]`, sem sessão: grupo de orquestração só com esta (o `--orq` fica em "$@").
    peer=""
    if [[ "${2:-}" == "--orq" ]]; then shift
    else peer="${2:?uso: hangar-send --pair <sessao|servidor::sessao> [tarefa...] [--substituir-tarefa] [--orq] | --pair --orq [tarefa...]}"; shift 2; fi
    substituir=false
    orq=false
    tarefa=""
    # --substituir-tarefa em QUALQUER posição entre os tokens restantes, não só logo após o peer —
    # senão "hangar-send --pair X 'PM-2' --substituir-tarefa" dobrava a flag pro texto da tarefa.
    for arg in "$@"; do
        if [[ "$arg" == "--substituir-tarefa" ]]; then substituir=true
        elif [[ "$arg" == "--orq" ]]; then orq=true
        else tarefa="$tarefa${tarefa:+ }$arg"; fi
    done
    # peer local (nome cru) OU remoto (servidor::sessao) — o backend local resolve o remoto via
    # peers.json + CP_SERVER_ID e registra o vínculo dos dois lados (/pair-remote). Cross-server é 1:1.
    body=$(python3 -c 'import json,sys; print(json.dumps({"peer": sys.argv[1], "task": sys.argv[2], "replace_task": sys.argv[3] == "true", "orq": sys.argv[4] == "true"}))' "$peer" "$tarefa" "$substituir" "$orq")
    resp=$(api POST "/api/sessions/$(me)/pair" "$body")
    if [[ -z "$peer" ]]; then
        gid=$(python3 -c 'import json,sys; print(json.loads(sys.argv[1]).get("gid") or "")' "$resp")
        echo "grupo de orquestração criado: $(me), sozinha, gid $gid (ninguém recebe aviso; o time entra depois)"
    elif $orq; then
        echo "pareado: $(me) <-> $peer (grupo de orquestração: ninguém recebe aviso; o kick-off traz o protocolo)"
    else
        echo "pareado: $(me) <-> $peer (registrado no app; os dois lados recebem o protocolo)"
    fi
    exit 0
fi

if [[ "$1" == "--aceitar-par" ]]; then
    link="${2:-}"
    [[ -n "$link" ]] || { echo "uso: hangar-send --aceitar-par <link https://….ts.net:8443/par/…>" >&2; exit 2; }
    eu=$(me)
    body=$(python3 -c 'import json,sys; print(json.dumps({"link": sys.argv[1]}))' "$link")
    resp=$(api POST "/api/sessions/$eu/pair-accept" "$body") || exit 1
    python3 -c 'import json,sys
r = json.loads(sys.argv[1])
print("pareada com %s (sessão %s) — responda com: hangar-send %s::%s \"…\"" % (r["owner"], r["session"], r["alias"], r["session"]))' "$resp"
    exit 0
fi

if [[ "$1" == "--new" ]]; then
    shift
    name="${1:?uso: hangar-send --new <nome> [cwd] [--engine <motor>] [--provider <claude|codex|pi|omp|kimi>] [--conta <nome>] [--model <id>] [--effort <nivel>] [--permissao <modo>] [--subagente <modelo>] [--service-tier <default|priority>] [--profile <nome>] [--headless] [--jev|--sem-jev]}"
    shift
    # servidor::nome cria a sessão NOUTRA máquina, pela API dela (peers.json), igual ao recado.
    remoto=""
    if [[ "$name" == *::* ]]; then
        remoto="${name%%::*}"; name="${name#*::}"
        if [[ -z "$remoto" || -z "$name" || "$name" == *::* ]]; then
            echo "erro: use servidor::nome (um '::' só)" >&2
            exit 2
        fi
    fi
    # Nome começando com '-' = o nome foi esquecido e uma FLAG virou nome. Sem esta guarda,
    # `hangar-send --new --engine kimi` criava uma sessão chamada "--engine", com cwd "kimi" e o motor
    # DESCARTADO calado — na conta Anthropic, parecendo que atendeu o pedido.
    if [[ "$name" == -* ]]; then
        echo "erro: nome de sessão não pode começar com '-' (esqueceu o nome?)" >&2
        echo "uso: hangar-send --new <nome> [cwd] [--engine <motor>] [--provider <claude|codex|pi|omp|kimi>] [--conta <nome>] [--model <id>] [--effort <nivel>] [--permissao <modo>] [--subagente <modelo>] [--service-tier <default|priority>] [--profile <nome>] [--headless] [--jev|--sem-jev]" >&2
        exit 2
    fi
    # --engine: a sessão nova nasce num MOTOR de modelo (~/.claude/engines.json) em vez da conta
    # Anthropic. Serve pra parear com uma sessão rodando noutro modelo — o par continua no mesmo
    # ~/.claude (skills, hooks, contrato compartilhado), só o motor difere. Aceita o flag em
    # qualquer ordem: `--new nome --engine kimi` sem cwd é o uso mais comum.
    # --provider: qual AGENTE roda na sessão nova. Omitido, usa o padrão do servidor. Mesma forma do
    # --engine: repassa cru pro backend, que recusa com 400 o que não conhece — não duplica aqui a
    # lista de providers válidos.
    # --conta: a sessão nova nasce em OUTRA CONTA Anthropic (config dir ~/.claude-<nome>), que é o
    # que o seletor de conta da tela "Nova sessão" já fazia pelo campo config_dir do POST. Sem o
    # flag, o único caminho era curl na API — e a ausência dele aqui vinha sendo lida como "não dá
    # pra abrir noutra conta". Resolve pelo hangar-conta (--prep reconcilia os atalhos e imprime o
    # caminho), pra regra de nome/pasta continuar morando num lugar só.
    # --model/--effort/--permissao: repassados crus pro backend (CreateBody.model/effort/
    # permission_mode), que valida contra as listas fechadas de app/model_args.py — não duplicar
    # os valores aqui, senão o script envelhece separado do backend (mesma regra do --provider).
    # --profile: perfil do omp (`omp --profile x`): login, sessões e config em ~/.omp/profiles/x.
    # Só com --provider omp; o backend recusa o resto e valida o nome.
    # --subagente: modelo dos subagentes (CLAUDE_CODE_SUBAGENT_MODEL); só Claude sem motor.
    # --conta com --provider codex: conta Codex (~/.codex-<nome>); `openai-codex` é a padrão.
    cwd=""; engine=""; provider=""; conta=""; config_dir=""; model=""; effort=""; permissao=""; perfil=""; read_only=""; headless=""; jev=""; subagente=""; codex_conta=""; service_tier=""
    remember_provider="false"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --service-tier)
                [[ -n "$service_tier" ]] && { echo "erro: --service-tier informado duas vezes" >&2; exit 2; }
                service_tier="${2:?uso: --service-tier <default|priority>}"; shift 2 ;;
            --remember-provider)
                [[ "$remember_provider" == "true" ]] && { echo "erro: --remember-provider informado duas vezes" >&2; exit 2; }
                remember_provider="true"; shift ;;
            --subagente)
                [[ -n "$subagente" ]] && { echo "erro: --subagente informado duas vezes" >&2; exit 2; }
                subagente="${2:?uso: --subagente <modelo>}"; shift 2 ;;
            # --jev / --sem-jev: a sessão nasce (ou não) com a chave do Jev no ambiente, e é ela que
            # faz o `hangar-preview objetivo` funcionar. SEM nenhum dos dois vale o padrão do
            # servidor — por isso existe o `--sem-jev`: com o padrão ligado, não haveria outro jeito
            # de rodar a mesma tarefa sem o Jev.
            --jev|--sem-jev)
                [[ -n "$jev" ]] && { echo "erro: --jev/--sem-jev informado duas vezes" >&2; exit 2; }
                [[ "$1" == "--jev" ]] && jev="true" || jev="false"; shift ;;
            # --headless: sessão Claude ou Codex sem terminal (o mesmo campo da tela de criação).
            --headless|--terminal)
                [[ -n "$headless" ]] && { echo "erro: --headless/--terminal informado duas vezes" >&2; exit 2; }
                [[ "$1" == "--headless" ]] && headless="true" || headless="false"; shift ;;
            --read-only)
                [[ -n "$read_only" ]] && { echo "erro: --read-only informado duas vezes" >&2; exit 2; }
                read_only="true"; shift ;;
            --engine)
                [[ -n "$engine" ]] && { echo "erro: --engine informado duas vezes" >&2; exit 2; }
                engine="${2:?uso: --engine <motor>}"; shift 2 ;;
            --profile)
                [[ -n "$perfil" ]] && { echo "erro: --profile informado duas vezes" >&2; exit 2; }
                perfil="${2:?uso: --profile <nome>}"; shift 2 ;;
            --conta)
                [[ -n "$conta" ]] && { echo "erro: --conta informado duas vezes" >&2; exit 2; }
                conta="${2:?uso: --conta <nome>}"; shift 2 ;;
            --provider)
                [[ -n "$provider" ]] && { echo "erro: --provider informado duas vezes" >&2; exit 2; }
                provider="${2:?uso: --provider <claude|codex|pi|omp|kimi>}"; shift 2 ;;
            --model)
                [[ -n "$model" ]] && { echo "erro: --model informado duas vezes" >&2; exit 2; }
                model="${2:?uso: --model <id>}"; shift 2 ;;
            --effort)
                [[ -n "$effort" ]] && { echo "erro: --effort informado duas vezes" >&2; exit 2; }
                effort="${2:?uso: --effort <nivel>}"; shift 2 ;;
            --permissao)
                [[ -n "$permissao" ]] && { echo "erro: --permissao informado duas vezes" >&2; exit 2; }
                permissao="${2:?uso: --permissao <acceptEdits|auto|bypassPermissions|manual|dontAsk|plan>}"; shift 2 ;;
            # Token com '-' na frente que não é --engine/--provider é opção errada (--engines,
            # -engine). Aceitar como cwd fazia o erro aparecer no token SEGUINTE, apontando o inocente.
            -*) echo "erro: opção desconhecida '$1'" >&2; exit 2 ;;
            *) if [[ -z "$cwd" ]]; then cwd="$1"; shift
               else echo "erro: argumento inesperado '$1'" >&2; exit 2; fi ;;
        esac
    done
    if [[ -n "$remoto" ]]; then
        cfg=$(peer_cfg "$remoto") || exit 1
        IFS=$'\t' read -r BASE rtok <<< "$cfg"
        AUTH="Authorization: Bearer $rtok"
        API_PEER=""; API_CONNECT_TIMEOUT=8
    fi
    if [[ -z "$provider" ]]; then
        # --conta e --subagente sem --provider sempre foram Claude; o padrão lembrado não os reinterpreta.
        if [[ -n "$engine" || -n "$conta" || -n "$subagente" ]]; then
            provider="claude"
        elif [[ -n "$perfil" ]]; then
            provider="omp"
        else
            providers=$(api GET /api/providers) || exit 1
            provider=$(python3 -c 'import json,sys
print(next((p for p, probe in json.load(sys.stdin).items() if probe.get("default")), "claude"))' <<<"$providers") \
                || { echo "erro: resposta ilegível de /api/providers" >&2; exit 1; }
        fi
    fi
    if [[ "$provider" == "codex" && -n "$conta" ]]; then
        [[ "$conta" == "auto" ]] && { echo "erro: --conta auto só vale para Claude" >&2; exit 2; }
        codex_conta="$conta"; [[ "$conta" == "openai-codex" ]] && codex_conta="default"
        conta=""
    fi
    if [[ -n "$remoto" ]]; then
        # O $HOME e o hangar-conta são DESTA máquina: pasta padrão e conta vêm das contas de LÁ.
        # A home é a mãe da conta `default` (~/.claude); `--conta auto` segue abaixo, já contra lá.
        if [[ -z "$cwd" || ( -n "$conta" && "$conta" != "auto" ) ]]; then
            configs=$(api GET /api/claude-configs) || exit 1
            IFS=$'\t' read -r home_remota config_dir < <(python3 -c 'import json,sys
cs = json.loads(sys.argv[1]); conta = sys.argv[2]
base = next((c["path"] for c in cs if c.get("label") == "default"), "")
sep = "\\" if "\\" in base else "/"
home = base.rsplit(sep, 1)[0] if base else ""
achada = ""
if conta and conta != "auto":
    for c in cs:
        nome = c["path"].replace("\\", "/").rsplit("/", 1)[-1]
        if conta in (c.get("label"), nome, ".claude-" + conta):
            achada = c["path"]
print(home + "\t" + achada)' "$configs" "$conta")
            if [[ -n "$conta" && "$conta" != "auto" && -z "$config_dir" ]]; then
                echo "erro: conta '$conta' não existe em '$remoto' — lá há: $(python3 -c 'import json,sys; print(", ".join(c["label"] for c in json.loads(sys.argv[1])))' "$configs")" >&2
                exit 2
            fi
            if [[ -z "$cwd" ]]; then
                [[ -z "$home_remota" ]] && { echo "erro: não achei a home de '$remoto' — informe a pasta: hangar-send --new $remoto::$name <cwd>" >&2; exit 2; }
                cwd="$home_remota"
            fi
        fi
    fi
    cwd="${cwd:-$HOME}"
    # Os demais providers dependem de pane; parar antes do POST evita criação incoerente.
    if [[ -n "$headless" && -n "$provider" && "$provider" != "claude" && "$provider" != "codex" ]]; then
        echo "erro: --headless só vale com provider claude ou codex (veio: $provider)" >&2
        exit 2
    fi
    # Conta inexistente para AQUI, antes do POST: o backend recusaria com 400, mas o erro do
    # hangar-conta já diz o nome errado e o `hangar-conta --list` mostra os certos.
    # --conta auto: o backend escolhe a conta Claude com mais folga na janela que mais aperta
    # (5h, 7d ou a semanal por modelo). Sem conta com leitura de cota ele responde 404 — e aqui
    # isso PARA, em vez de cair calado na conta padrão que talvez seja justo a esgotada.
    if [[ "$conta" == "auto" ]]; then
        sugestao=$(api GET /api/cotas/sugestao) || {
            echo "erro: nenhuma conta com leitura de cota — escolha uma: hangar-conta --list" >&2
            exit 2
        }
        IFS=$'\t' read -r config_dir conta < <(python3 -c 'import json,sys
s = json.load(sys.stdin); print(s["path"] + "\t" + s["label"])' <<<"$sugestao")
        if [[ -z "$config_dir" || -z "$conta" ]]; then
            echo "erro: resposta da cota ilegível em $BASE — escolha uma conta: --conta <nome>" >&2
            exit 2
        fi
        echo "conta escolhida pela cota: $conta" >&2
    fi
    if [[ -n "$conta" && "$config_dir" == "" ]]; then
        config_dir=$("$(dirname "$(realpath "$0")")/hangar-conta" --prep "$conta") || {
            echo "erro: conta '$conta' indisponível — veja as configuradas com: hangar-conta --list" >&2
            exit 2
        }
    fi
    # engine vazio -> null: o backend trata como "conta Anthropic", o comportamento de sempre. Motor
    # que não existe volta 400 do backend (a api() mostra o detalhe) em vez de abrir uma sessão que
    # parece estar no motor e não está.
    # config_dir vazio -> a chave SOME do payload (não vai null): o backend trata ausência como
    # conta padrão, e mandar null por um campo que ele valida contra list_config_dirs é pedir 400.
    # model/effort/permissao vazios -> as chaves SOMEM do payload (None é o default do CreateBody;
    # mandar "" seria validado e recusado).
    # A sessão que roda este script é a criadora: conta, modo de permissão e sem terminal omitidos
    # herdam dela no backend. Noutra máquina ela não existe, e "cli" é não saber quem chama.
    criadora=""
    if [[ -z "$remoto" ]]; then
        criadora=$(me)
        [[ "$criadora" == "cli" ]] && criadora=""
        if [[ -z "$criadora" && -n "${TMUX:-}${CP_SESSION_KEY:-}${HANGAR_CANO_KEY:-}" ]]; then
            echo "aviso: não identifiquei esta sessão; conta, modo de permissão e sem terminal não serão herdados" >&2
        fi
    fi
    body=$(python3 -c 'import json,sys
d = {"name": sys.argv[1], "cwd": sys.argv[2],
     "engine": sys.argv[3] or None,
     "provider": sys.argv[4]}
if sys.argv[5]:
    d["config_dir"] = sys.argv[5]
if sys.argv[6]:
    d["model"] = sys.argv[6]
if sys.argv[7]:
    d["effort"] = sys.argv[7]
if sys.argv[8]:
    d["permission_mode"] = sys.argv[8]
if sys.argv[9]:
    d["omp_profile"] = sys.argv[9]
if sys.argv[10]:
    d["read_only"] = True
if sys.argv[11]:
    d["headless"] = sys.argv[11] == "true"
if sys.argv[12]:
    # "true"/"false", nunca ausente-por-omissao: o campo AUSENTE no corpo e o que faz o backend
    # aplicar o padrao do servidor, e mandar `false` cru apagaria esse padrao em todo uso do CLI.
    d["jev"] = sys.argv[12] == "true"
if sys.argv[13]:
    d["subagent_model"] = sys.argv[13]
if sys.argv[14]:
    d["codex_account"] = sys.argv[14]
if sys.argv[15] == "true":
    d["remember_provider"] = True
if sys.argv[16]:
    d["creator"] = sys.argv[16]
if sys.argv[17]:
    d["service_tier"] = sys.argv[17]
print(json.dumps(d))' \
           "$name" "$cwd" "$engine" "$provider" "$config_dir" "$model" "$effort" "$permissao" "$perfil" "$read_only" "$headless" "$jev" "$subagente" "$codex_conta" "$remember_provider" "$criadora" "$service_tier")
    creation_result=$(api POST /api/sessions "$body") || exit 1
    if ! herdado=$(python3 -c 'import json,sys
result = json.load(sys.stdin)
for warning in result.get("avisos", []):
    print("aviso: " + warning, file=sys.stderr)
partes = []
if result.get("headless") and not sys.argv[1]:
    partes.append("sem terminal")
if result.get("account_source") == "inherited":
    partes.append("conta herdada: " + (result.get("config_dir") or "a padrão"))
elif result.get("account_source") == "quota":
    partes.append("conta trocada pela cota: " + (result.get("config_dir") or "a padrão"))
print("".join(" [%s]" % p for p in partes))' "$headless" <<<"$creation_result"); then
        echo "aviso: a criação foi confirmada, mas não consegui ler os avisos da resposta" >&2
    fi
    [[ -n "$remoto" ]] && name="$remoto::$name"
    [[ "$headless" == "false" ]] && headless=""
    echo "sessão criada: $name ($cwd)${headless:+ [sem terminal]}$herdado${provider:+ [$provider]}${engine:+ [motor: $engine]}${conta:+ [conta: $conta]}${codex_conta:+ [conta codex: $codex_conta]}${model:+ [modelo: $model]}${effort:+ [esforço: $effort]}${permissao:+ [permissão: $permissao]}${subagente:+ [subagentes: $subagente]}${service_tier:+ [service tier: $service_tier]}${perfil:+ [perfil: $perfil]}${jev:+ [jev: $jev]} — fala com ela via: hangar-send $name \"msg\""
    exit 0
fi

if [[ "$1" == "--unpair" ]]; then
    api DELETE "/api/sessions/$(me)/pair" >/dev/null
    echo "despareado"
    exit 0
fi

if [[ "$1" == "--close" ]]; then
    alvo="${2:?uso: hangar-send --close <sessao>}"
    [[ "$alvo" == *::* ]] && { echo "erro: --close só fecha sessão desta máquina" >&2; exit 2; }
    # Fechar a si mesma mata o processo no meio do comando: quem fecha é quem assumiu ou quem coordena.
    # O carimbo do nascimento também conta: se a identificação cair no "cli", ele ainda segura.
    eu=$(me)
    if [[ "$alvo" == "$eu" || "$alvo" == "${CP_SESSION_NAME:-}" ]]; then
        echo "recusado: '$alvo' é esta sessão — peça pra outra fechar" >&2; exit 2
    fi
    # O DELETE responde ok pra nome que não existe: nome errado não pode virar "fechada".
    vivas=$(api GET /api/sessions) || exit 1
    printf '%s' "$vivas" | python3 -c 'import json,sys; sys.exit(0 if any(s.get("name") == sys.argv[1] for s in json.load(sys.stdin)) else 1)' "$alvo" \
        || { echo "erro: sessão '$alvo' não existe (hangar-send --list)" >&2; exit 1; }
    resp=$(api DELETE "/api/sessions/$alvo") || exit 1
    echo "fechada: $alvo"
    # Fechou, mas desfazer o par remoto dela pode ter falhado: isso não some calado.
    printf '%s' "$resp" | python3 -c 'import json,sys; w=(json.load(sys.stdin) or {}).get("warning"); w and print("aviso: " + (w.get("msg") or json.dumps(w, ensure_ascii=False)), file=sys.stderr)' || true
    exit 0
fi

if [[ "$1" == "--group" ]]; then
    shift
    forcar_tmux=false
    if [[ "${1:-}" == "--tmux" ]]; then forcar_tmux=true; shift; fi
    [[ $# -ge 1 ]] || { echo "uso: hangar-send --group [--tmux] <mensagem...>" >&2; exit 2; }
    eu=$(me)
    nativo=false; [[ -n "${CLAUDE_CODE_MESSAGING_SOCKET:-}" ]] && nativo=true
    body=$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "remetente_nativo": sys.argv[2] == "true", "forcar_tmux": sys.argv[3] == "true"}))' "$*" "$nativo" "$forcar_tmux")
    resp=$(api POST "/api/sessions/$eu/group-message" "$body")
    # `pulados` vem vazio: o backend entrega a todos. O filtro fica pra servidor antigo da malha.
    python3 -c 'import json,sys
d = json.loads(sys.argv[1])
pul = d.get("pulados", [])
entregues = [p for p in d["peers"] if p not in pul]
if entregues: print("aviso enviado ao grupo:", ", ".join(entregues))
w = d.get("warning")
if w: print("  ⚠", w.get("msg", w))' "$resp"
    exit 0
fi

forcar_tmux=0
if [[ "${1:-}" == "--tmux" ]]; then forcar_tmux=1; shift; fi

target="$1"; shift
[[ $# -ge 1 ]] || { echo "uso: hangar-send [--tmux] <sessao|servidor::sessao> <mensagem...>" >&2; exit 2; }

# O transporte é decisão do backend (socket nativo do Claude → plugin → tmux → fila), nunca do
# modelo: este script só entrega e diz o que aconteceu. `--tmux` fica aceito por compatibilidade.

if [[ "${HANGAR_SEND_PAINEL:-}" == "1" ]]; then
    # Com "[de: X]" na frente, o destino responderia a X achando que foi X quem escreveu.
    text="$*"
    if [[ "$text" != "[painel:"* ]]; then
        echo "erro: HANGAR_SEND_PAINEL=1 exige texto começando com [painel: …]" >&2
        exit 2
    fi
    if [[ "$target" == *::* ]]; then
        echo "erro: aviso de painel só vai a sessão desta máquina" >&2
        exit 2
    fi
    sess="$target"
else
    eu=$(me 2>/dev/null)
    if [[ "$target" == "$eu" || ( -n "$SERVER_ID" && "$target" == "$SERVER_ID::$eu" ) ]]; then
        echo "recusado: '$target' é esta sessão — o recado voltaria pra você. Quem é quem: hangar-send --list" >&2
        exit 1
    fi
    sender=$(me)
    curto="$sender"
    sess="$target"
    if [[ "$target" == *::* ]]; then
        # Destino em OUTRO servidor: resolve base/token no peers.json e qualifica o remetente —
        # sem [de: <este-servidor>::<sessao>] o outro lado não teria endereço de resposta.
        srv="${target%%::*}"; sess="${target#*::}"
        # Par externo primeiro: só o backend local sabe chamar a máquina de outra pessoa, e isso
        # não depende de CP_SERVER_ID. Só cai no peers.json quando o apelido NÃO é de par externo:
        # apelido de par que falha mostra o erro do backend (ex.: remetente que não é o dono do par).
        ext_pairs_get || { echo "erro: não consegui consultar os pares externos ($ext_status)" >&2; exit 1; }
        if python3 -c 'import json,sys
try:
    sys.exit(0 if any(r.get("alias") == sys.argv[2] for r in json.loads(sys.argv[1])) else 1)
except ValueError:
    sys.exit(1)' "$ext_body" "$srv"; then
            msg="$*"
            for p in "$sender" "$curto"; do msg="${msg#"[de: $p] "}"; msg="${msg#"[de: $p]"}"; done
            body=$(python3 -c 'import json,sys; print(json.dumps({"sender": sys.argv[1], "target": sys.argv[2], "text": sys.argv[3]}))' "$curto" "$target" "$msg")
            ext_out=$(curl -s --connect-timeout 3 -m 30 -w $'\n%{http_code}' -X POST -H "$AUTH" \
                -H "Content-Type: application/json" -d "$body" "$BASE/api/external-pairs/send") || {
                echo "erro: backend inacessível em $BASE (hangar rodando?)" >&2; exit 1; }
            ext_code=${ext_out##*$'\n'}
            ext_out=${ext_out%$'\n'*}
            if [[ $ext_code == 2* ]]; then
                relatar_envio "$ext_out" "$target"
                exit 0
            fi
            echo "erro HTTP $ext_code: $ext_out" >&2
            exit 1
        fi
        if [[ -z "$SERVER_ID" ]]; then
            echo "erro: CP_SERVER_ID ausente no backend/.env — obrigatório pra envio cross-server (endereço de resposta [de: <id>::$sender])" >&2
            exit 1
        fi
        cfg=$(peer_cfg "$srv")
        IFS=$'\t' read -r BASE rtok <<< "$cfg"
        AUTH="Authorization: Bearer $rtok"
        sender="${SERVER_ID}::${sender}"
    fi
    # Modelo que escreve "[de: eu] …" por conta própria não ganha o prefixo em dobro — nem com o nome
    # curto num envio pra outro servidor, onde o remetente já virou "<servidor>::<eu>".
    msg="$*"
    for p in "$sender" "$curto"; do msg="${msg#"[de: $p] "}"; msg="${msg#"[de: $p]"}"; done
    text="[de: $sender] $msg"
fi

body=$(python3 -c 'import json,sys; print(json.dumps({"text": sys.argv[1], "steer": True}))' "$text")
resp=$(api POST "/api/sessions/$sess/input" "$body")
# Sessão inexistente nem chega aqui (o backend responde 404 e o api() já mostrou o detail).
relatar_envio "$resp" "$target"

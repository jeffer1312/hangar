#!/bin/sh
# hangar-send — recados entre sessões, grupos e sessões novas pelo Hangar. O comando inteiro é o
# `hangar-server send` (ajuda: `hangar-send --help`); este atalho acha o binário pela regra única
# (hangar-server-lookup) e passa a raiz desta cópia, de onde sai o `.env` da máquina não migrada.
# Não renomeie nem mova: plugins de terceiros procuram o caminho scripts/hangar-send no texto dos atalhos.
set -u
self=$0
while [ -L "$self" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
    link=$(readlink -- "$self")
    case $link in /*) self=$link ;; *) self=$dir/$link ;; esac
done
root=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd -P)
. "$root/scripts/hangar-server-lookup"
if ! hangar_server_find "$root"; then
    if [ "$HANGAR_SERVER_MISSING" = env ]; then
        echo 'hangar: CP_RUST_SERVER_BIN não é um executável' >&2
    else
        echo 'hangar: hangar-server não encontrado; instale o Hangar ou configure CP_RUST_SERVER_BIN' >&2
    fi
    exit 126
fi
exec "$HANGAR_SERVER_BIN" send --root "$root" "$@"

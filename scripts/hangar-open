#!/bin/sh
# `hangar-open <claude|pi|omp|kimi> [args do CLI]`: chamado pelos wrappers de shell fora do tmux e em
# terminal. O `hangar-server open-cli` monta o pedido, abre a sessão pelo lançador do Hangar (o mesmo
# do app) e imprime o nome; aqui só se anexa o terminal a ela. Saída 100 = os argumentos não cabem no
# pedido, ou não há `hangar-server` que abra (ausente, antigo ou sem token): o wrapper roda o CLI cru.
# Qualquer outra saída diferente de 0 é erro já mostrado; não se abre uma segunda vez.
set -u
self=$0
while [ -L "$self" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
    link=$(readlink -- "$self")
    case $link in /*) self=$link ;; *) self=$dir/$link ;; esac
done
root=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd -P)
. "$root/scripts/hangar-server-lookup"
if ! hangar_server_find "$root"; then
    echo "hangar: hangar-server não encontrado; abrindo o ${1:-cli} sem o Hangar" >&2
    exit 100
fi
name=$("$HANGAR_SERVER_BIN" open-cli "$@")
rc=$?
# O `open-cli` nunca sai 2: 2 é o binário antigo, sem o subcomando, e nada foi enviado.
if [ "$rc" -eq 2 ]; then
    echo "hangar: o hangar-server não abriu a sessão (saída 2); abrindo o ${1:-cli} sem o Hangar" >&2
    exit 100
fi
[ "$rc" -eq 0 ] || exit "$rc"
# `=`: nome exato; sem ele o tmux cai no prefixo e `proj` anexaria em `proj-2`.
exec tmux attach-session -t "=$name"

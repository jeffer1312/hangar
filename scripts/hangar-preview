#!/usr/bin/env node
// hangar-preview — dirige o navegador embutido DA SUA SESSÃO no app desktop (o nativo no Windows e no Linux, ou o Electron).
//
//   hangar-preview open <url>             abre o navegador desta sessão com a url (só no Electron
//                                          o painel monta sozinho na tela do usuário)
//   hangar-preview list                    navegadores vivos (chave, url, vivo/morto)
//   hangar-preview snapshot [--refs] [--max n]  árvore de acessibilidade compacta, com refs @eN
//   hangar-preview click @eN               clica no elemento da ref
//   hangar-preview fill @eN <texto>        limpa o campo da ref e digita o texto
//   hangar-preview type <texto>            digita no elemento com foco
//   hangar-preview press <tecla>           uma tecla (Enter, Tab, Escape, ...)
//   hangar-preview hover @eN               passa o mouse sobre a ref
//   hangar-preview wait <@eN|--url texto|--text texto|--idle|Nms> [--timeout ms]   espera algo acontecer
//   hangar-preview goto <url> | back | reload    navega e espera carregar
//   hangar-preview eval '<js>'             roda JS na página e imprime o resultado
//   hangar-preview tema <claro|escuro|sistema>
//   hangar-preview layout [mobile|desktop|<largura> <altura>]
//   hangar-preview console [--limpar]      log do console da página
//   hangar-preview network                 últimas respostas de rede
//   hangar-preview text                    texto visível da página (innerText)
//   hangar-preview url                     URL atual do navegador desta sessão
//   hangar-preview shot [arquivo.png] [--max <px>]  screenshot (default ~/.hangar/nav/shots/<sessao>/<epoch ms>.png);
//                                          --max reduz até o maior lado caber em px (só no app nativo)
//   hangar-preview folha                   junta numa grade os shots sem nome tirados desde a última folha
//   hangar-preview tab list                lista as abas (* = ativa)
//   hangar-preview tab new <url>           abre outra aba com a url e torna ativa
//   hangar-preview tab <id>                torna a aba ativa (aparece no painel)
//   hangar-preview tab close [id]          fecha a aba (sem id, a ativa; a última fecha o navegador)
//   hangar-preview <verbo> --aba <id>      age nessa aba SEM trocar a ativa (verbos de página)
//   hangar-preview batch                   lê várias linhas do stdin, uma por comando (ver skill)
//   hangar-preview --cdp <url> [--alvo <trecho da url>] <verbo>   os mesmos verbos numa página FORA do app
//                                          (CDP só em loopback, ex.: túnel até um WebView2); env HANGAR_PREVIEW_CDP
//
// A sessão é resolvida pela chave estável do sidecar no modo sem terminal e pelo tmux no modo com
// terminal. Para operar o navegador de OUTRA sessão, use --sessao <nome>.
//
// Como funciona: o shell mantém um controlador por navegador (fila, refs, tema, buffers de
// console/rede) dentro do processo Electron, e publica porta+token efêmeros num sidecar que só o
// dono lê (~/.hangar/nav/_srv.json). Este CLI é cliente HTTP desse servidor local (POST /cmd) —
// não fala CDP direto: dois clientes CDP no mesmo alvo o Electron recusa quando o DevTools daquele
// webContents está aberto. `open` e `list` continuam fora do servidor: `open` passa pelo backend
// (quem monta o painel na tela) e `list` só lê os sidecares de sessão — os dois têm que funcionar
// mesmo com o shell fora do ar.
import { execFileSync } from 'node:child_process';
import { accessSync, appendFileSync, constants, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, realpathSync, rmSync, statSync, unlinkSync, writeFileSync } from 'node:fs';
import { randomUUID } from 'node:crypto';
import { homedir, tmpdir } from 'node:os';
import { delimiter, dirname, join, resolve } from 'node:path';
import fmt from '../shell/preview_fmt.cjs';
import folha from '../shell/folha.cjs';
import jev from '../shell/jev_objetivo.cjs';
import roteiro from '../shell/jev_roteiro.cjs';
import logs from '../shell/log.cjs';

const CDP = 'http://127.0.0.1:9223';
const DIR = join(homedir(), '.hangar', 'nav');
const PRONTO_MS = 20_000;
const PAUSADO = 'o usuario pausou o navegador; espere ele clicar em Retomar no painel e tente de novo';
// Endereço do navegador da sessão, para a frase de reabertura quando o app cai no meio do comando.
let urlAberta = '';
const VERBOS_SERVIDOR = new Set([
  'snapshot', 'click', 'fill', 'type', 'press', 'hover', 'wait', 'eval',
  'tema', 'layout', 'console', 'network', 'text', 'url', 'shot', 'close', 'goto', 'back', 'reload', 'login', 'dialog', 'estado',
]);

function erro(msg, codigo = 1) {
  console.error(`hangar-preview: ${msg}`);
  process.exit(codigo);
}

// --- argumentos ---
const args = process.argv.slice(2);
const flags = {};
const pos = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--sessao') flags.sessao = args[++i];
  else if (args[i] === '--aba') flags.aba = Number(args[++i]);
  else if (args[i] === '--dados') flags.dados = args[++i];
  else if (args[i] === '--passos') flags.passos = args[++i];
  else if (args[i] === '--permitir-risco') flags.permitirRisco = true;
  else if (args[i] === '--refazer') flags.refazer = true;
  else if (args[i] === '--pasta') {
    flags.pasta = args[++i];
    if (!flags.pasta || flags.pasta.startsWith('--')) erro('--pasta precisa do diretório: --pasta automacao/gravacoes');
  }
  else if (args[i] === '--cwd') flags.cwd = args[++i];
  else if (args[i] === '--cdp' || args[i] === '--alvo') {
    // Sem valor, o comando caía calado no navegador da sessão (ou em qualquer página de fora).
    const flag = args[i];
    const valor = args[++i];
    if (!valor || valor.startsWith('--')) erro(`${flag} precisa de um valor: ${flag === '--cdp' ? '--cdp http://127.0.0.1:9222' : '--alvo /agenda'}`);
    flags[flag.slice(2)] = valor;
  }
  else pos.push(args[i]);
}
// Página de fora do app: quem conecta e confere o loopback é o app nativo; sessão e sidecar não entram.
const externo = (flags.cdp ?? process.env.HANGAR_PREVIEW_CDP ?? '').trim();
if (flags.alvo !== undefined && !externo) erro('--alvo só vale com --cdp <url>');
if (flags.aba != null && !Number.isInteger(flags.aba)) erro('--aba precisa do numero da aba (veja: hangar-preview tab list)');
const cmd = pos[0];
if (!cmd || cmd === 'help' || cmd === '--help') {
  console.log(`uso: hangar-preview <verbo> [args] [--sessao <nome>]

Identidade: sidecar da sessão no modo sem terminal; tmux no modo com terminal.

  open <url>              abre o navegador desta sessão com a url
  list                    navegadores vivos (chave, url, vivo/morto)
  snapshot [--refs] [--max n]  árvore de acessibilidade com refs @eN e estados ([checked], [disabled]...);
                          --refs só os acionáveis; corta em 24 mil caracteres com aviso (--max muda)
  click @eN               clica no elemento da ref
  fill @eN <texto>        limpa o campo da ref e digita o texto
  type <texto>            digita no elemento com foco
  press <tecla>           uma tecla (Enter, Tab, Escape, ...)
  hover @eN               passa o mouse sobre a ref
  wait <alvo>             @eN | --url <trecho> | --text <trecho> | --idle | <ms>
                          (--text ignora maiúsculas; --timeout <ms> troca o teto de 15 s, até 40 s)
  goto <url>              navega e só volta com a página carregada
  back                    volta uma página no histórico
  reload                  recarrega a página
  dialog accept [texto] | dialog dismiss   responde o alert/confirm/prompt que a página abriu
  eval '<js>'             roda JS na página (expressão ou declarações) e imprime o resultado
  tema <claro|escuro|sistema>
  layout [mobile|desktop|<largura> <altura>]
                          emula o tamanho sem redimensionar a janela (sem valor, diz o atual)
  console [--limpar]      log do console da página
  network                 últimas respostas de rede
  text                    texto visível da página (innerText), sem árvore
  url                     URL atual
  shot [arquivo.png]      screenshot (default ~/.hangar/nav/shots/<sessao>/<epoch ms>.png)
    --max <px>            reduz até o maior lado caber em px (só no app nativo; o Electron ignora)
  folha                  junta numa grade (6 por folha) os shots sem nome desde a última folha
  abas (só no Electron; o app nativo tem um navegador por sessão e recusa tab e --aba):
  tab list                lista as abas (* = ativa)
  tab new <url>           abre outra aba com a url e torna ativa
  tab <id>                torna a aba ativa (aparece no painel)
  tab close [id]          fecha a aba (sem id, a ativa; a última fecha o navegador)
  --aba <id>              age nessa aba SEM trocar a ativa (vale pros verbos de página)
  close                   fecha o navegador desta sessão (o painel some; terminou de usar, feche)
  batch                   lê várias linhas do stdin, uma por comando
  objetivo e confere precisam do Jev ligado na sessão (hangar-send --new ... --jev):
  objetivo <texto>        o Jev dirige sozinho até cumprir o objetivo (uma requisição por ciclo)
    --passos <n>          teto de passos (default 15)
    --refazer             ignora o roteiro gravado do mesmo objetivo (o Jev decide tudo e regrava)
    --pasta <dir>         onde ficam as gravações (padrão: automacao/gravacoes na raiz do git do cwd,
                          lendo e2e/roteiros e .hangar/roteiros antigos como reserva; fora de repo,
                          ~/.cache/hangar/roteiros)
    --permitir-risco      libera, so nesta chamada, o clique que exclui, compra, envia ou publica
                          (quem chama responde pela ordem do usuario; cada liberacao sai no log)
    --dados <json>        valores para os campos, com as chaves que você quiser: o Jev casa cada
                          um com o rótulo da página. Campo não coberto cai no LLM pequeno
                          (modelo auxiliar do Jev: JEV_AUX_BASE_URL/_API_KEY/_MODELO/_ESFORCO,
                          ou JEV_TEXTO_CMD)
  confere <estado>        o Jev diz se a tela já mostra o estado (sai 0 = sim); use antes do shot.
                          Em dúvida, pergunta de novo mandando o print da página ao Jev
                          (objetivo faz o mesmo no passo em que a decisão sai fraca)
  --cdp <url>             os verbos de página (e objetivo/confere) numa página FORA do app, pelo CDP dela;
                          só loopback (ex.: http://127.0.0.1:9222 de um túnel). Env HANGAR_PREVIEW_CDP.
                          Precisa do app desktop aberto nesta máquina; open não vale (use goto)
  --alvo <trecho>         com --cdp, escolhe a página pela URL quando há mais de uma
  JEV_ENDPOINT / JEV_MODEL  onde e com qual modelo o Jev decide (configuração do servidor; vazio = typesafe.ai)

Referência completa: skill hangar-preview.`);
  process.exit(0);
}

// --- resolve a sessão (chave serverId::nome) ---
function nomeHeadless() {
  // Sessão SEM terminal: a chave do sidecar (env do processo) não muda no rename nem no /clear.
  const chave = process.env.CP_SESSION_KEY || process.env.HANGAR_CANO_KEY;
  if (!chave) return null;
  const pastas = ['claude-headless', 'codex-sessions']
    .map((nome) => join(homedir(), '.hangar', nome));
  for (const pasta of pastas) {
    try {
      for (const arq of readdirSync(pasta)) {
        if (!arq.endsWith('.json')) continue;
        try {
          const meta = JSON.parse(readFileSync(join(pasta, arq), 'utf8'));
          if (meta && meta.key === chave && meta.name) return String(meta.name);
        } catch { /* sidecar em escrita ou inválido */ }
      }
    } catch { /* esta família de sessão sem terminal nunca existiu nesta máquina */ }
  }
  return null;
}

function nomeSessao() {
  if (flags.sessao) return flags.sessao;
  const semTerminal = nomeHeadless();
  if (semTerminal) return semTerminal;
  // O carimbo do nascimento (posto pelo new_session do tmux.py) vem do env do PANE, então é imune
  // a qual cliente está anexado. Só vale se a sessão ainda se chamar assim: `rename-session` não
  // reescreve env de processo já rodando, e nome obsoleto endereçaria OUTRA sessão — pior que
  // nome ausente. O `=` força match exato (sem ele o tmux cai em prefix match).
  const carimbo = process.env.CP_SESSION_NAME;
  if (carimbo) {
    try {
      execFileSync('tmux', ['has-session', '-t', `=${carimbo}`], { stdio: 'ignore' });
      return carimbo;
    } catch { /* sessão renomeada, morta, ou sem tmux — cai no fallback */ }
  }
  if (process.env.TMUX) {
    try {
      const out = execFileSync('tmux', ['list-clients', '-F', '#{client_control_mode}\t#{session_name}'])
        .toString();
      const names = new Set();
      for (const line of out.split('\n').filter(Boolean)) {
        const fields = line.split('\t');
        if (fields.length !== 2 || !['0', '1'].includes(fields[0])) return null;
        if (fields[0] === '0' && fields[1]) names.add(fields[1]);
      }
      if (names.size === 1) return [...names][0];
    } catch { /* tmux indisponível */ }
  }
  return null;
}

// A mesma pasta da tool `browser` do MCP: um lugar só de prints por sessão, que o app do celular serve.
function pastaShots() {
  return join(DIR, 'shots', (nomeSessao() || 'nav').replace(/[^\p{L}\p{N}_]+/gu, '-'));
}

function lerSidecars() {
  if (!existsSync(DIR)) return [];
  return readdirSync(DIR)
    // Arquivos com `_` são de processo (_srv.json: porta+token do servidor local; _pendentes.json:
    // marcadores do backend), não de um navegador.
    .filter((a) => a.endsWith('.json') && !a.startsWith('.') && !a.startsWith('_'))
    .map((a) => {
      try { return JSON.parse(readFileSync(join(DIR, a), 'utf8')); } catch { return null; }
    })
    .filter((s) => s && typeof s.chave === 'string');
}

// A URL da página aberta pelo app carrega `?token=` até o shell limpar: nada que vai pro
// terminal (e daí pro transcript) mostra o valor.
function semToken(texto) {
  return String(texto).replace(/([?&]token=)[^&#\s"']*/gi, '$1…');
}

function sidecarDa(nome) {
  const todos = lerSidecars();
  if (!todos.length) erro('nenhum navegador aberto em nenhuma sessão (abra o seu com: hangar-preview open <url>)');
  if (!nome) erro('não deu para identificar esta sessão — use --sessao <nome>. Vivos:\n' + todos.map((s) => `  ${s.chave}  ${semToken(s.url)}`).join('\n'));
  const achados = todos.filter((s) => s.chave === nome || s.chave.endsWith(`::${nome}`));
  if (achados.length === 1) { urlAberta = achados[0].url; return achados[0]; }
  if (!achados.length) erro(`a sessão "${nome}" não tem navegador aberto (abra com: hangar-preview open <url>). Vivos:\n` + todos.map((s) => `  ${s.chave}  ${semToken(s.url)}`).join('\n'));
  erro(`"${nome}" existe em mais de um servidor — use a chave completa:\n` + achados.map((s) => `  ${s.chave}`).join('\n'));
}

// Com --cdp não há chave: a página é escolhida pelo endereço e pelo --alvo.
const chaveAlvo = () => (externo ? null : sidecarDa(nomeSessao()).chave);

// --- CDP mínimo, só pro liveness check do `list` ---
async function targets() {
  try {
    return await (await fetch(`${CDP}/json/list`)).json();
  } catch {
    erro('o shell do hangar não está no ar (9223 não responde). O navegador embutido vive no app desktop.');
  }
}

// --- cliente do servidor local (Task 5) ---
const MSG_SHELL_FORA = externo
  ? 'erro: --cdp roda dentro do app desktop do Hangar, e ele nao esta aberto nesta maquina (ou esta reiniciando): abra o app e repita'
  : 'o app desktop do Hangar nao esta aberto nesta maquina (ou esta reiniciando, como na atualizacao): espere ele voltar e reabra o navegador com: hangar-preview open <url>';

// A porta de loopback do sidecar pode ter sido RECICLADA por outro processo depois que o app
// fechou (o _srv.json não é apagado na saída — só no will-quit do main.cjs, e sinal/crash ainda
// deixa o arquivo pra trás). Sem conferir o pid, o CLI falaria com quem estiver ali agora e
// imprimiria a resposta dele como se fosse do navegador. "pid morto é sessão morta, não sessão a
// reconectar."
function pidVivo(pid) {
  if (!pid) return false;
  try { process.kill(pid, 0); return true; } catch (err) { return err && err.code === 'EPERM'; }
}

function srv(sair = erro) {
  let dados;
  try {
    dados = JSON.parse(readFileSync(join(DIR, '_srv.json'), 'utf8'));
  } catch {
    return sair(MSG_SHELL_FORA);
  }
  if (!pidVivo(dados.pid)) return sair(MSG_SHELL_FORA);
  return dados;
}

// Para quem não pode encerrar o processo (as leituras depois do laço): a falha vira exceção.
const lancar = (msg) => { throw new Error(msg); };

// `aba` explícito (o batch manda por linha) vence o flag global.
async function chamar(chave, verbo, cmdArgs, aba = flags.aba, sair = erro) {
  const { porta, token } = srv(sair);
  let r, texto;
  try {
    r = await fetch(`http://127.0.0.1:${porta}/cmd`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
      // O token vai só ao app local; o CDP de fora quem abre é o app, sem credencial.
      body: JSON.stringify({ ...(externo ? { cdp: externo, alvo: flags.alvo } : { chave }), verbo, args: cmdArgs, ...(aba != null ? { aba } : {}) }),
    });
    texto = await r.text();
  } catch (err) {
    // App fechado ou reiniciado (a atualização reinicia) no meio do comando: frase, não a pilha do Node.
    if (externo) return sair(`o app desktop fechou ou reiniciou no meio do comando (${err.cause?.code || err.cause?.message || err.message}). Espere ele voltar e repita`);
    const reabrir = urlAberta ? `hangar-preview open '${semToken(urlAberta)}'` : 'hangar-preview open <url>';
    return sair(`o app desktop fechou ou reiniciou no meio do comando (${err.cause?.code || err.cause?.message || err.message}). Espere ele voltar e reabra o navegador com: ${reabrir}`);
  }
  // O servidor local responde SEMPRE 200 (é o texto que carrega erro: ...) — r.ok não basta.
  return { texto, codigo: r.ok && !texto.startsWith('erro:') ? 0 : 1 };
}

async function comando(chave, verbo, cmdArgs, aba = flags.aba) {
  const { texto, codigo } = await chamar(chave, verbo, cmdArgs, aba);
  console.log(semToken(texto));
  return codigo;
}

// --- comandos ---
if (cmd === 'open') {
  // Pede ao BACKEND pra entregar o evento 'nav' no SSE da sessão — o painel monta sozinho na tela
  // (quem posiciona o view é o painel; não existe view invisível). Token do `~/.hangar/config/.env`
  // ou, sem ele, do backend/.env ao lado do script, mesmo padrão do hangar-send.
  const url = pos[1];
  if (externo) erro('open nao vale com --cdp: a pagina ja esta aberta no app de fora; navegue com goto <url>');
  if (!url) erro('open precisa de uma url: hangar-preview open localhost:3000');
  const nome = nomeSessao();
  if (!nome) erro('não deu para identificar esta sessão — use --sessao <nome>');
  const repo = join(dirname(realpathSync(process.argv[1])), '..');
  const novo = join(homedir(), '.hangar', 'config', '.env');
  let token = '';
  try {
    token = readFileSync(existsSync(novo) ? novo : join(repo, 'backend', '.env'), 'utf8').match(/^CP_AUTH_TOKEN=(.+)$/m)?.[1]?.trim() ?? '';
  } catch { /* sem .env */ }
  if (!token) erro('não achei CP_AUTH_TOKEN no ~/.hangar/config/.env nem no backend/.env do repo');
  const desde = Date.now();
  const doNome = (s) => s.chave === nome || s.chave.endsWith(`::${nome}`);
  const antes = lerSidecars().find(doNome)?.url ?? null;
  const res = await fetch(`http://127.0.0.1:${process.env.PORT || 8765}/api/sessions/${encodeURIComponent(nome)}/nav`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
    body: JSON.stringify({ url }),
  });
  if (res.status === 404) erro(`a sessão "${nome}" não existe no backend`);
  if (!res.ok) erro(`o backend recusou: ${res.status} ${await res.text()}`);
  // Volta só com o navegador pronto: o verbo seguinte ao `open` falhava com "nenhum navegador aberto".
  // Pronto = sidecar regravado depois do pedido (o app grava a cada navegação) e `url` respondendo.
  const prazo = desde + PRONTO_MS;
  // Já na página pedida: não havia navegador, o endereço mudou, ou a pedida é a mesma de antes. Sem isto, um
  // evento da página anterior (título de SPA) regravando o sidecar fazia o `open` voltar com a URL antiga.
  const pedida = url.trim().replace(/^https?:\/\//, '').replace(/\/$/, '');
  const navegou = (atual) => antes === null || atual !== antes || (pedida !== '' && antes.includes(pedida));
  let ultimo = '';
  let pausaConferida = false;
  while (Date.now() < prazo) {
    const sc = lerSidecars().find(doNome);
    // Pausado pelo usuário, o app não navega: dizer na hora em vez de esgotar o prazo. Uma pergunta basta.
    if (sc && !pausaConferida) {
      pausaConferida = true;
      if ((await chamar(sc.chave, 'estado', [])).texto.trim() === 'pausado') erro(PAUSADO);
    }
    if (sc && (sc.ts ?? 0) >= desde && navegou(sc.url)) {
      try {
        const { texto, codigo } = await chamar(sc.chave, 'url', []);
        if (codigo === 0) {
          let pronta = texto.replace(/^ok: /, '');
          try { pronta = JSON.parse(pronta); } catch { /* já é texto cru */ }
          console.log(`ok: navegador de "${nome}" pronto em ${semToken(pronta)} (o painel só aparece na tela do usuário quando ele abrir esta sessão)`);
          process.exit(0);
        }
        ultimo = texto;
      } catch (err) {
        ultimo = err.message;
      }
    }
    await new Promise((r) => setTimeout(r, 150));
  }
  erro(`o navegador de "${nome}" nao ficou pronto em ${PRONTO_MS / 1000}s${ultimo ? ` (${semToken(ultimo)})` : ''}. O app desktop está aberto nesta máquina? Veja com: hangar-preview list`);
}

if (cmd === 'list') {
  const sidecars = lerSidecars();
  // O app nativo grava o pid do dono no sidecar; o do Electron só se confere pelo alvo na porta 9223.
  const vivos = sidecars.some((s) => !s.pid) ? await targets() : [];
  const linhas = sidecars.map((s) => {
    const vivo = s.pid ? pidVivo(s.pid) : vivos.some((t) => (s.targetId && t.id === s.targetId) || t.url === s.url);
    // Sidecar de shell antigo não tem `abas`: vale como uma aba só, e a saída fica idêntica à de hoje.
    const sufixo = Array.isArray(s.abas) && s.abas.length > 1 ? `  (aba ${s.ativa} de ${s.abas.length})` : '';
    return `${s.chave}  ${semToken(s.url)}  ${vivo ? 'vivo' : `MORTO (reabra com: hangar-preview open ${semToken(s.url)})`}${sufixo}`;
  });
  console.log(linhas.length ? linhas.join('\n') : 'nenhum navegador registrado');
  process.exit(0);
}

if (cmd === 'tab') {
  const chave = chaveAlvo();
  const { verbo, args: cmdArgs } = fmt.verboDeTab(pos.slice(1));
  process.exit(await comando(chave, verbo, cmdArgs));
}

if (VERBOS_SERVIDOR.has(cmd)) {
  if (cmd === 'eval' && !pos[1]) erro('eval precisa de um trecho JS: hangar-preview eval \'document.title\'');
  const chave = chaveAlvo();
  const cmdArgs = pos.slice(1);
  // Sempre absoluto, resolvido contra o cwd do CLI (é o cwd que o agente conhece) — um caminho
  // relativo mandado cru pro shell grava no cwd de onde o ELECTRON subiu, não no do agente, e a
  // resposta citava um caminho que não existia onde o agente (e o app do celular) foram procurar.
  if (cmd === 'shot') {
    // Um arquivo por shot: a `folha` precisa da sequência, e sobrescrever perderia o antes/depois.
    // `shot --max 1568` sem caminho: o flag fica, o caminho padrão entra na frente.
    if (!cmdArgs[0] || cmdArgs[0].startsWith('--')) {
      mkdirSync(pastaShots(), { recursive: true });
      cmdArgs.unshift(join(pastaShots(), `${Date.now()}.png`));
    } else cmdArgs[0] = resolve(cmdArgs[0]);
  }
  process.exit(await comando(chave, cmd, cmdArgs));
}

if (cmd === 'folha') {
  const pasta = pastaShots();
  const marca = join(pasta, '.ultima-folha');
  // O marcador guarda o carimbo do último shot incluído: mtime de baixa resolução perderia shots.
  const desde = existsSync(marca) ? Number(readFileSync(marca, 'utf8')) || 0 : 0;
  const nomes = existsSync(pasta)
    ? readdirSync(pasta).filter((a) => /^\d+\.png$/.test(a) && parseInt(a, 10) > desde)
      .sort((a, b) => parseInt(a, 10) - parseInt(b, 10))
    : [];
  if (!nomes.length) erro('nenhum shot novo desde a última folha (tire com: hangar-preview shot)');
  try {
    for (const saida of folha.montar(nomes.map((a) => join(pasta, a)), { dir: pasta })) console.log(`ok: ${saida}`);
  } catch (err) {
    erro(err.message);
  }
  writeFileSync(marca, String(parseInt(nomes.at(-1), 10)));
  process.exit(0);
}

if (cmd === 'batch') {
  const chave = chaveAlvo();
  const linhas = readFileSync(0, 'utf8'); // stdin inteiro
  const comandos = fmt.parseLote(linhas);
  // Para na PRIMEIRA linha que falhar: seguir depois de um `click` que não achou o alvo faz o
  // próximo `type` (ex.: senha) digitar no que estiver com foco, que não é o campo pretendido.
  for (let i = 0; i < comandos.length; i++) {
    const { verbo, args: a, aba } = comandos[i];
    // `--aba` sem número vira NaN e o corpo JSON o transforma em null, que o servidor lê como
    // "a ativa": o comando cairia calado na aba errada, que é o desastre que este batch evita.
    if (aba !== undefined && !Number.isInteger(aba)) {
      erro(`--aba precisa do numero da aba (linha ${i + 1}: ${verbo})`);
    }
    const codigo = await comando(chave, verbo, a, aba);
    if (codigo !== 0) {
      console.error(`hangar-preview: batch parou na linha ${i + 1} (${verbo})`);
      process.exit(codigo);
    }
  }
  process.exit(0);
}

/**
 * Por que o `objetivo` não tem chave. O backend injeta `HANGAR_JEV=on|off` no nascimento da sessão;
 * com `off` a chave nem entra no processo, então daqui não dá para saber se ela existe cadastrada —
 * por isso a frase do `off` cobre os dois caminhos em vez de afirmar o que não se mediu.
 */
function semJev() {
  if (process.env.HANGAR_JEV === 'off') {
    return 'o Jev esta desligado nesta sessao. Abra uma com `hangar-send --new <nome> <cwd> --jev`'
      + ' (ou marque o Jev em "Mais opcoes" ao criar). Se a chave ainda nao foi cadastrada, ela fica'
      + ' em Configuracoes do servidor > Jev.';
  }
  return 'o Jev nao esta configurado nesta sessao. Cadastre a chave em Configuracoes do servidor >'
    + ' Jev e abra a sessao com --jev; em sessao aberta antes disso, TYPESAFE_API_KEY no ambiente'
    + ' tambem serve.';
}

// O LLM pequeno que escreve o valor de um campo no `objetivo` — o único ponto do laço em que um
// modelo de linguagem entra. Endpoint compatível com a OpenAI se o auxiliar tiver endereço;
// senão, um comando local que lê o pedido como argumento e imprime só o valor.
const TEXTO_CMD_PADRAO = 'claude -p --model claude-haiku-4-5-20251001';

// Lido igual aqui e na checagem de `problemaDoEscritor`: valor com espaço passava numa e quebrava na outra.
// O auxiliar da sessão chega em JEV_AUX_*; JEV_TEXTO_* posto no ambiente, mesmo vazio, é ordem de quem
// chamou (desligar o escritor num teste) e vence.
const DO_AUX = { JEV_TEXTO_BASE_URL: 'JEV_AUX_BASE_URL', JEV_TEXTO_API_KEY: 'JEV_AUX_API_KEY', JEV_TEXTO_MODELO: 'JEV_AUX_MODELO' };
const envTexto = (env, k) => String((k in DO_AUX && !(k in env) ? env[DO_AUX[k]] : env[k]) ?? '').trim();

/** Um pedido ao endpoint compatível com a OpenAI; falha vira exceção com a chave mascarada. */
function chatCompletions({ base, chave, modelo, esforco, quem, maxTokens = 600, esquema = null, avisar = () => {} }) {
  // Provedor que recusa `response_format` perde o esquema nesta execução e segue pelo pedido em texto.
  let comEsquema = Boolean(esquema);
  // Sem `temperature`: modelos novos (Haiku 5.5 na Anthropic) recusam o pedido inteiro com ele.
  return async (pedido) => {
    let r;
    let corpo;
    const enviar = async () => {
      r = await fetch(`${base}/chat/completions`, {
        method: 'POST',
        headers: { authorization: `Bearer ${chave}`, 'content-type': 'application/json' },
        body: JSON.stringify({ model: modelo, messages: [{ role: 'user', content: pedido }], max_tokens: maxTokens,
          ...(esforco ? { reasoning_effort: esforco } : {}),
          ...(comEsquema ? { response_format: { type: 'json_schema', json_schema: { name: 'resposta', strict: true, schema: esquema } } } : {}) }),
        signal: AbortSignal.timeout(60_000),
      });
      corpo = await r.text();
    };
    try {
      await enviar();
      if (comEsquema && r.status === 400 && /response_format|json_schema/i.test(corpo)) {
        const texto = `${quem} recusou o esquema JSON; seguindo sem ele (${jev.semChave(corpo, chave).slice(0, 400)})`;
        console.error(`hangar-preview: aviso: ${texto}`);
        avisar(texto);
        comEsquema = false;
        await enviar();
      }
    } catch (err) {
      throw new Error(err?.name === 'TimeoutError' ? `${quem} não respondeu em 60 s`
        : `${quem} falhou: ${jev.semChave(String(err?.message), chave).slice(0, 200)}`);
    }
    if (!r.ok) throw new Error(`${quem} recusou: ${r.status} ${jev.semChave(corpo, chave).slice(0, 200)}`);
    try {
      return JSON.parse(corpo).choices?.[0]?.message?.content ?? '';
    } catch (err) {
      throw new Error(`${quem} falhou: ${jev.semChave(String(err?.message), chave).slice(0, 200)}`);
    }
  };
}

function escritorDeTexto(env = process.env) {
  if (envTexto(env, 'JEV_TEXTO_BASE_URL') && envTexto(env, 'JEV_TEXTO_API_KEY')) {
    const pedir = chatCompletions({
      base: envTexto(env, 'JEV_TEXTO_BASE_URL').replace(/\/$/, ''),
      chave: envTexto(env, 'JEV_TEXTO_API_KEY'),
      modelo: envTexto(env, 'JEV_TEXTO_MODELO') || 'gpt-4o-mini',
      esforco: envTexto(env, 'JEV_AUX_ESFORCO'),
      quem: 'o modelo de texto',
    });
    return async (pedido) => {
      try {
        return await pedir(pedido);
      } catch (err) {
        erro(err.message);
      }
    };
  }
  const cmd = (envTexto(env, 'JEV_TEXTO_CMD') || TEXTO_CMD_PADRAO).split(/\s+/);
  return async (pedido) => {
    try {
      return execFileSync(cmd[0], [...cmd.slice(1), pedido], { encoding: 'utf8', timeout: 60_000 });
    } catch (err) {
      erro(`o modelo de texto falhou (${cmd[0]}): ${String(err.message).slice(0, 200)}`);
    }
  };
}

function executavel(nome) {
  if (!nome) return false;
  // No Windows o execFileSync só roda .exe/.com: um .cmd passaria aqui e falharia no primeiro campo.
  const exts = process.platform !== 'win32' || /\.(exe|com)$/i.test(nome) ? [''] : ['.exe', '.com'];
  const dirs = /[\\/]/.test(nome) ? [''] : (process.env.PATH ?? '').split(delimiter).filter(Boolean);
  return dirs.some((d) => exts.some((x) => {
    try {
      const p = d ? join(d, nome + x) : nome + x;
      accessSync(p, constants.X_OK);
      return statSync(p).isFile();
    } catch {
      return false;
    }
  }));
}

/**
 * Configuração do escritor que não tem como funcionar, dita pelo nome do campo de Configurações do
 * servidor. Sem isto o erro só aparecia no primeiro campo a digitar, como ENOENT do valor do campo.
 */
function problemaDoEscritor(env = process.env) {
  const base = envTexto(env, 'JEV_TEXTO_BASE_URL');
  const chave = envTexto(env, 'JEV_TEXTO_API_KEY');
  const problemas = [];
  if (base) {
    if (base === String(env.JEV_ENDPOINT ?? '').trim() || /\/decisions\/?$|systemone/.test(base)) {
      problemas.push(`jev_aux_base_url ("${base}") e o endereco de decisoes do Jev; ali vai um endpoint`
        + ' compativel com a OpenAI, como https://openrouter.ai/api/v1');
    } else if (!chave) {
      problemas.push(`jev_aux_base_url esta preenchido e jev_aux_api_key esta vazio: preencha a chave do modelo auxiliar`);
    } else {
      return null;
    }
  }
  const comando = envTexto(env, 'JEV_TEXTO_CMD') || TEXTO_CMD_PADRAO;
  if (!executavel(comando.split(/\s+/)[0])) {
    problemas.push(`jev_texto_cmd ("${comando}", chave do runtime-config sem campo na tela) nao e um comando instalado; ali vai um comando que`
      + ` recebe o pedido como argumento e imprime so o valor, como "${TEXTO_CMD_PADRAO}"`);
  }
  return problemas.length ? problemas.join('; ') : null;
}

/**
 * Quem escolhe o passo quando o Jev fica sem alvo: só o modelo auxiliar configurado, nunca um
 * modelo fixo no código. Falta de endereço, chave ou modelo devolve o aviso no lugar do callback.
 */
function auxiliarDoObjetivo(env = process.env, avisar = () => {}) {
  const base = envTexto(env, 'JEV_TEXTO_BASE_URL').replace(/\/$/, '');
  const chave = envTexto(env, 'JEV_TEXTO_API_KEY');
  const modelo = envTexto(env, 'JEV_TEXTO_MODELO');
  if (!base || !chave || !modelo) {
    return { aviso: 'o objetivo segue sem desempate pelo modelo auxiliar: jev_aux_base_url, jev_aux_api_key e jev_aux_modelo nao estao todos configurados' };
  }
  // Endereço do Jev no lugar do auxiliar: o aviso do escritor já diz o que corrigir.
  if (problemaDoEscritor(env)) return {};
  // Com raciocínio ligado, 600 tokens acabavam antes da resposta e o JSON vinha vazio.
  return { ajudar: chatCompletions({ base, chave, modelo, esforco: envTexto(env, 'JEV_AUX_ESFORCO'), quem: 'o modelo auxiliar', maxTokens: 4000, esquema: jev.ESQUEMA_DO_AUXILIAR, avisar }) };
}

const MAX_TRAJETOS = 50;

/**
 * Uma execução do `objetivo` em JSONL no log privado do Hangar: cada decisão com as probabilidades do
 * Jev e a resposta crua do auxiliar, para ver depois por que o objetivo parou. Falha de disco vira
 * aviso, nunca parada do laço. Valores de `--dados` (nome, CPF, credencial) saem trocados por
 * "(oculto)", e só o dono do sistema lê o arquivo.
 */
function abrirTrajeto(dados) {
  const dir = join(logs.dirLogs(), 'privado', 'objetivos');
  try {
    mkdirSync(dir, { recursive: true, mode: 0o700 });
  } catch (err) {
    console.error(`hangar-preview: aviso: trajeto nao gravado: ${String(err?.message).slice(0, 200)}`);
    return null;
  }
  // ponytail: poda só na abertura; as mais novas ficam. Outra execução pode ter apagado o mesmo arquivo.
  try {
    for (const n of readdirSync(dir).filter((x) => x.endsWith('.jsonl')).sort().slice(0, -(MAX_TRAJETOS - 1))) {
      try { unlinkSync(join(dir, n)); } catch { /* já apagado */ }
    }
  } catch { /* a poda nunca impede gravar */ }
  // Como aparecem dentro do JSON (escapados); valor curto demais casaria com texto comum.
  const valores = Object.values(dados ?? {}).filter((v) => typeof v === 'string' && v.length >= 3)
    .map((v) => JSON.stringify(v).slice(1, -1)).sort((a, b) => b.length - a.length);
  const arquivo = join(dir, `${new Date().toISOString().replace(/[:.]/g, '-')}-${process.pid}.jsonl`);
  let ativo = true;
  const gravar = (evento) => {
    if (!ativo) return;
    try {
      const linha = valores.reduce((t, v) => t.split(v).join('(oculto)'), JSON.stringify({ t: new Date().toISOString(), ...evento }));
      appendFileSync(arquivo, `${linha}\n`, { mode: 0o600 });
    } catch (err) {
      ativo = false;
      console.error(`hangar-preview: aviso: trajeto interrompido: ${String(err?.message).slice(0, 200)}`);
    }
  };
  return { arquivo, gravar };
}

/**
 * O print que vai ao Jev: `{ base64, width, height }`, ou `{ status, motivo }` quando não há o que
 * mandar. O arquivo temporário sai sempre; o Electron ignora o `--max` e o print grande cai no limite.
 */
let screenshotDirPath = null;
// O print da página pode ter dado sensível: fica numa pasta 0700 só deste processo, que sai com ele.
function screenshotDir() {
  if (!screenshotDirPath) {
    screenshotDirPath = mkdtempSync(join(tmpdir(), 'hangar-jev-'));
    process.on('exit', () => {
      try { rmSync(screenshotDirPath, { recursive: true, force: true }); } catch { /* o tmp do sistema limpa depois */ }
    });
    // Morto no prazo de quem chamou, o Node não dispara o 'exit' sozinho: sem isto o print ficava no /tmp.
    for (const [signal, code] of [['SIGTERM', 143], ['SIGINT', 130]]) process.once(signal, () => process.exit(code));
  }
  return screenshotDirPath;
}

async function captureScreenshot(chave) {
  let file = null;
  try {
    file = join(screenshotDir(), `${randomUUID()}.png`);
    const { texto, codigo } = await chamar(chave, 'shot', [file, '--max', String(jev.IMAGE_LIMITS.maxSide)], flags.aba, lancar);
    if (codigo !== 0) return { status: 'sem_print', motivo: semToken(texto).slice(0, 160) };
    let buf;
    try {
      buf = readFileSync(file);
    } catch {
      return { status: 'sem_print', motivo: 'o shot nao gravou o arquivo' };
    }
    const dim = jev.pngDimensions(buf);
    if (!dim) return { status: 'sem_print', motivo: 'o shot nao gravou um PNG' };
    if (!jev.imageWithinLimits(dim)) return { status: 'fora_do_limite', motivo: `${dim.width}x${dim.height}` };
    return { base64: buf.toString('base64'), ...dim };
  } catch (err) {
    return { status: 'sem_print', motivo: String(err?.message ?? err).slice(0, 160) };
  } finally {
    try { unlinkSync(file); } catch { /* o shot nao chegou a gravar */ }
  }
}

/**
 * Pedido ao Jev com a reserva da imagem: recusado ou sem resposta com ela, o mesmo pedido sai sem, e a
 * imagem fica desligada pelo resto da execução. Só o erro do pedido sem imagem chega a quem chamou.
 */
function jevAsker(jevKey) {
  const { url, modelo, tipo } = jev.destinoDoJev(process.env);
  let disabled = false;
  const ask = async (estado, perguntas, imagem) => {
    let reason;
    if (imagem && !disabled) {
      try {
        return { answers: await jev.askJev({ url, modelo, chave: jevKey, estado, perguntas, imagem, tipo }), status: 'enviada' };
      } catch (err) {
        disabled = true;
        reason = err.message;
      }
    }
    // Sem o print, a pergunta de bloqueio falaria de uma tela que o Jev não recebeu.
    const { bloqueado, ...withoutBlock } = perguntas;
    const status = !imagem ? null : reason ? 'falhou' : 'desligada';
    return { answers: await jev.askJev({ url, modelo, chave: jevKey, estado, perguntas: withoutBlock }), status, reason };
  };
  ask.disabled = () => disabled;
  return ask;
}

if (cmd === 'confere') {
  const estado = pos.slice(1).join(' ').trim();
  if (!estado) erro('confere precisa do estado: hangar-preview confere "o dialogo fechou e a lista mostra o item novo"');
  const chaveJev = process.env.TYPESAFE_API_KEY;
  if (!chaveJev) erro(semJev(), 2);
  const chave = chaveAlvo();
  // O corte daqui (cabeça e cauda) é o que vale: o teto do snapshot só corta a cauda, onde a prova
  // pode estar, então ele recebe a página inteira.
  const snap = await chamar(chave, 'snapshot', ['--max', '1000000']);
  // Falta de chave, erro do snapshot e da chamada ao Jev saem 2: com 1, um laço `until confere`
  // giraria achando que a tela só não chegou lá. Navegador fechado ou shell fora do ar ainda saem 1
  // (helpers comuns).
  if (snap.codigo !== 0) erro(`o snapshot falhou: ${semToken(snap.texto.slice(0, 200))}`, 2);
  // A árvore vai ao Jev, fora da máquina: sem o token da URL.
  // value= de campo com nome de segredo ("Chave de API", "PIN") não vai ao Jev.
  let arvore = jev.mascararValores(semToken(snap.texto));
  // A prova pode estar no topo ou no fim da página; o miolo de uma lista longa é repetição.
  if (arvore.length > 100_000) arvore = `${arvore.slice(0, 50_000)}\n…\n${arvore.slice(-50_000)}`;
  const { url, modelo, tipo } = jev.destinoDoJev(process.env);
  const perguntas = jev.perguntaDeConfere(estado);
  let respostas;
  try {
    respostas = await jev.askJev({ url, modelo, chave: chaveJev, estado: arvore, perguntas });
  } catch (err) {
    erro(err.message, 2);
  }
  let { p, ok } = jev.chegouNoEstado(respostas);
  // Resposta em dúvida: a mesma pergunta vai de novo com o print. Recusado com imagem, fica a resposta
  // sem imagem que já veio (8A), e o print que não foi aparece no stderr.
  if (p >= jev.CONFERE_DOUBT_RANGE.min && p <= jev.CONFERE_DOUBT_RANGE.max) {
    const screenshot = await jev.withCaptureCeiling(() => captureScreenshot(chave))();
    let missing = screenshot.base64 ? null : `${screenshot.status}: ${screenshot.motivo ?? ''}`;
    if (screenshot.base64) {
      try {
        ({ p, ok } = jev.chegouNoEstado(await jev.askJev({ url, modelo, chave: chaveJev, estado: arvore, perguntas, imagem: screenshot, tipo }),
          jev.THRESHOLDS_WITH_SCREENSHOT));
      } catch (err) {
        missing = `falhou: ${err.message}`;
      }
    }
    if (missing) console.error(`hangar-preview: aviso: confere sem o print (${semToken(missing)})`);
  }
  console.log(`confere: ${p.toFixed(2)}`);
  process.exit(ok ? 0 : 1);
}

if (cmd === 'objetivo') {
  const objetivo = pos.slice(1).join(' ').trim();
  if (!objetivo) erro('objetivo precisa do texto: hangar-preview objetivo "faz login e abre a agenda"');
  const chaveJev = process.env.TYPESAFE_API_KEY;
  if (!chaveJev) erro(semJev());
  const chave = chaveAlvo();
  let dados;
  try {
    dados = flags.dados ? JSON.parse(flags.dados) : undefined;
  } catch {
    erro('--dados precisa ser um JSON de objeto: --dados \'{"nome":"Jefferson","plano":"Unimed"}\'');
  }

  // Configuração quebrada não impede o laço: clicar e preencher por --dados seguem funcionando, e o
  // campo que precisaria do escritor para com falta-dado.
  const problema = problemaDoEscritor();
  if (problema) console.error(`hangar-preview: aviso: modelo de texto inutilizavel: ${problema}`);
  const inicio = Date.now();
  const maxPassos = Number(flags.passos) > 0 ? Number(flags.passos) : 15;
  const trajeto = abrirTrajeto(dados);
  const gravar = trajeto?.gravar ?? (() => {});
  // Logo no começo: quem chamou mata o processo no prazo dele e perderia a linha do fim.
  if (trajeto) console.log(`trajeto: ${trajeto.arquivo}`);
  // Saída por erro() (navegador fora, escritor falhou) ou exceção também fecha o arquivo; o motivo
  // exato foi para o stderr.
  let fechado = false;
  process.on('exit', (codigo) => {
    if (!fechado) gravar({ tipo: 'fim', sucesso: false, parou: `saiu com codigo ${codigo} antes do fim do laco (motivo no stderr)` });
  });
  const { ajudar, aviso } = auxiliarDoObjetivo(process.env, (texto) => gravar({ tipo: 'aviso', texto }));
  const askJevWithImage = jevAsker(chaveJev);
  const captureWithCeiling = jev.withCaptureCeiling(() => captureScreenshot(chave));
  if (aviso) console.error(`hangar-preview: aviso: ${aviso}`);
  // Só os nomes das chaves de --dados: os valores podem ser credenciais.
  gravar({ tipo: 'inicio', objetivo, dados: Object.keys(dados ?? {}), maxPassos, auxiliar: Boolean(ajudar),
    escritor: !problema, avisos: [problema, aviso].filter(Boolean) });
  const resultado = await roteiro.rodarComRoteiro({
    objetivo,
    dados,
    refazer: flags.refazer === true,
    // O MCP roda este script no cwd do backend: ele manda o da sessão em --cwd.
    // --pasta relativa é relativa ao cwd da sessão, não ao do backend.
    pasta: flags.pasta ? resolve(flags.cwd || process.cwd(), flags.pasta) : roteiro.pastaDe(flags.cwd || process.cwd()),
    reserva: flags.pasta ? [] : roteiro.reservaDe(flags.cwd || process.cwd()),
    maxPassos,
    permitirRisco: flags.permitirRisco === true,
    escreverTexto: problema ? undefined : escritorDeTexto(),
    ajudar,
    registrar: gravar,
    log: (linha) => {
      const l = semToken(linha);
      console.log(l);
      gravar({ tipo: 'log', linha: l });
    },
    // Tudo que o navegador devolve vira estado enviado ao Jev: o token não sai da máquina.
    executar: async (verbo, args) => semToken((await chamar(chave, verbo, args)).texto),
    // Imagem desligada pelo 8A: o print não iria a lugar nenhum.
    capture: async () => (askJevWithImage.disabled() ? { status: 'desligada' } : captureWithCeiling()),
    // A imagem sai do estado antes do envio (nunca vai como campo cru) e o resultado volta no mesmo
    // objeto, para o laço saber se decidiu com print sem mudar a assinatura do `perguntar`.
    perguntar: async (estado, perguntas) => {
      const { __image: image, ...clean } = estado;
      try {
        const { answers, status, reason } = await askJevWithImage(clean, perguntas, image);
        if (image) Object.assign(image, { status }, reason ? { motivo: reason } : {});
        if (status === 'falhou') console.error(`hangar-preview: aviso: o Jev recusou o pedido com o print; seguindo sem print (${semToken(reason)})`);
        return answers;
      } catch (err) {
        gravar({ tipo: 'fim', sucesso: false, parou: err.message });
        fechado = true;
        erro(err.message);
      }
    },
  });
  gravar({ tipo: 'fim', sucesso: resultado.sucesso === true, parou: resultado.parou, falta: resultado.falta ?? null,
    roteiro: resultado.roteiro ?? null, feito: resultado.feito, segundos: (Date.now() - inicio) / 1000 });
  fechado = true;
  console.log(`\nparou: ${resultado.parou}`);
  if (resultado.roteiro) console.log(`roteiro: ${resultado.roteiro}`);
  console.log(`jev: acoes=${resultado.jev.acoes} verificacao=${resultado.jev.verificacao} tempo=${((Date.now() - inicio) / 1000).toFixed(1)}s`);
  // Onde a página ficou, para quem chamou não precisar de um `url` e um `text` a mais. Falha aqui
  // vira rótulo, nunca o código de saída: quem decide é `resultado.sucesso`.
  const leitura = async (verbo) => {
    try {
      const { texto, codigo } = await chamar(chave, verbo, [], flags.aba, lancar);
      if (codigo !== 0) return `indisponivel (${semToken(texto.slice(0, 120))})`;
      const t = texto.replace(/^ok:\s*/, '').trim();
      // Só a url vem como literal JSON; o texto da página pode começar com aspas de verdade.
      return semToken(verbo === 'url' && t.startsWith('"') ? JSON.parse(t) : t);
    } catch (err) {
      return `indisponivel (${String(err?.message).slice(0, 120)})`;
    }
  };
  // Linha legível por máquina: quem chamou reinvoca com esse dado em --dados, sem interpretar a
  // frase acima. A página fica onde parou, então a segunda chamada continua dali. Sai antes das
  // leituras finais: se o app cair nelas, o resultado do laço já foi dito.
  if (resultado.falta) console.log(`falta-dado: ${resultado.falta}`);
  console.log(resultado.feito.length ? `acoes: ${resultado.feito.length}` : 'nenhuma acao executada');
  console.log(`url: ${await leitura('url')}`);
  const textoFinal = (await leitura('text')).replace(/\s+/g, ' ').trim();
  console.log(`texto: ${textoFinal.length > 300 ? `${textoFinal.slice(0, 300)}…` : textoFinal}`);
  // Código de saída é o que um script encadeando este comando lê. Sair 0 numa parada por teto de
  // passos ou por alvo sem confiança faria a automação seguir como se tivesse dado certo. O campo
  // `sucesso` vem do laço de propósito: amarrar isto ao texto de `parou` quebraria calado na
  // primeira vez que alguém mexesse na redação da frase.
  process.exit(resultado.sucesso ? 0 : 1);
}

erro(`comando desconhecido: ${cmd} (vale open|list|snapshot|click|fill|type|press|hover|wait|goto|back|reload|dialog|eval|tema|layout|console|network|text|url|shot|folha|tab|confere|objetivo|close|batch)`);

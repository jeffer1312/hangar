#!/bin/sh
# hangar — materializa as skills do Claude nas pastas do pi/kimi, agora.
#
# Existe pra ser chamado na LARGADA de cada harness (os wrappers de shell): sem isso a ponte so era
# refeita na subida do servidor, entao instalar uma skill no Claude exigia reiniciar o servico antes
# de o pi enxergar ela.
#
# Silencioso e fail-soft de proposito: e uma conveniencia no caminho de abrir um agente, nunca um
# motivo pra o agente nao abrir. Sai 0 sempre.
#
# ~/.local/bin/hangar-skills-sync e symlink pra ca; `realpath` resolve o link pra achar o repo.
set -u

alvo=$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")
setup=$(dirname "$alvo")/hangar-harness-setup

# stdout no lixo, mas o stderr vai pra um arquivo: engolir os dois deixava este o unico caminho da
# ponte sem rastro NENHUM, e a pessoa so notava dias depois que uma skill nova nao aparecia no pi.
err="${TMPDIR:-/tmp}/hangar-skills-sync.err"
if [ -x "$setup" ]; then
  "$setup" skills --repo "$(dirname "$alvo")/.." >/dev/null 2>>"$err" || echo "hangar-harness-setup skills saiu com $?" >>"$err"
else
  echo "hangar-harness-setup ausente: $setup" >>"$err"
fi
exit 0

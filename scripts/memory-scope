#!/usr/bin/env bash
# Roda o comando num escopo próprio do systemd, com teto de memória. Quando a máquina fica sem
# memória, o systemd-oomd mata o grupo que mais usa swap: com o build no grupo de quem o chamou, ia
# a sessão do agente inteira (o Claude, os subagentes e o build juntos); assim vai só o build.
# Sem o systemd do usuário (CI, Windows, macOS), roda o comando direto.
#
# Uso:  scripts/memory-scope <comando> [args...]
# Tetos: HANGAR_BUILD_MEMORY_MAX (padrão 70%, mata o build) e HANGAR_BUILD_SWAP_MAX (8G). Sem
# MemoryHigh por padrão: o Node dimensiona o heap pelo menor teto do grupo, e com ele o svelte-check
# estoura. Quem só compila pede um com HANGAR_BUILD_MEMORY_HIGH (o kernel recolhe primeiro a memória
# do build; `available` = a regra do cargo-pinned, o disponível agora menos 2 GB, mínimo 4) e, com
# HANGAR_BUILD_BIND_TO, morre junto com a unidade de quem chamou. HANGAR_BUILD_WARN_FD repete num
# descritor aberto o aviso de que o grupo não abriu.
set -euo pipefail

if [[ -z "${HANGAR_NO_MEMORY_SCOPE:-}" ]] && command -v systemd-run >/dev/null 2>&1; then
    extra=()
    high="${HANGAR_BUILD_MEMORY_HIGH:-}"
    if [[ "$high" == available ]]; then
        # Lido aqui, na hora de rodar: quem chama pode ter esperado a trava de build por minutos.
        available="$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || true)"
        high=""
        if [[ -n "$available" ]]; then
            high=$(( available - 2 * 1048576 )); (( high < 4 * 1048576 )) && high=$((4 * 1048576))
            high="${high}K"
        fi
    fi
    [[ -n "$high" ]] && extra+=(-p MemoryHigh="$high")
    # O systemd-run come barra invertida: o `\x2d` dos nomes de unidade vai dobrado.
    [[ -n "${HANGAR_BUILD_BIND_TO:-}" ]] && extra+=(-p BindsTo="${HANGAR_BUILD_BIND_TO//\\/\\\\}")
    # A sonda leva os mesmos parâmetros: unidade que não existe não pode impedir o comando de rodar.
    # Prazo folgado: com a máquina sem memória o systemd demora, e é quando o teto mais importa.
    if timeout 20 systemd-run --user --scope --quiet --collect "${extra[@]}" true >/dev/null 2>&1; then
        exec systemd-run --user --scope --quiet --collect \
            -p MemoryMax="${HANGAR_BUILD_MEMORY_MAX:-70%}" \
            -p MemorySwapMax="${HANGAR_BUILD_SWAP_MAX:-8G}" \
            "${extra[@]}" -- "$@"
    fi
    warning="memory-scope: o systemd do usuário não abriu o escopo; rodando sem teto de memória"
    echo "$warning" >&2
    # Quem roda com a saída num log pede o aviso também no canal que a pessoa vê.
    [[ -z "${HANGAR_BUILD_WARN_FD:-}" ]] || { echo "$warning" >&"$HANGAR_BUILD_WARN_FD"; } 2>/dev/null || true
fi
exec "$@"

#!/bin/sh
# CLI de contas Claude, para o wrapper de shell chamar. A regra mora no `hangar-server conta`;
# este atalho só acha o binário desta cópia e repassa os argumentos, a saída e o código.
#
#   hangar-conta --list                    -> um nome de conta por linha
#   hangar-conta --prep <nome> [<projeto>] -> refaz os atalhos e imprime o caminho do config dir;
#                                             com o projeto (a pasta já saneada), liga a memória dele
#   hangar-conta --new <nome>              -> cria a conta e imprime o caminho
set -u
self=$0
while [ -L "$self" ]; do
    dir=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
    link=$(readlink -- "$self")
    case $link in /*) self=$link ;; *) self=$dir/$link ;; esac
done
root=$(CDPATH= cd -P -- "$(dirname -- "$self")/.." && pwd -P)
. "$root/scripts/hangar-server-lookup"
if ! hangar_server_find "$root"; then
    echo 'hangar-conta: hangar-server não encontrado; instale o Hangar ou aponte CP_RUST_SERVER_BIN para o binário' >&2
    exit 126
fi
"$HANGAR_SERVER_BIN" conta "$@"
rc=$?
# O `hangar-server conta` sai 0, 1, 2 ou 126; acima de 128 foi sinal, e o wrapper não pode ler isso
# como um código dele.
if [ "$rc" -gt 128 ]; then
    echo "hangar-conta: o hangar-server parou pelo sinal $((rc - 128)) sem responder" >&2
    exit 1
fi
exit "$rc"

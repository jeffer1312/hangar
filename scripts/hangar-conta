#!/usr/bin/env -S sh -c 'exec "$(command -v hangar-python || command -v python3)" "$0" "$@"'
"""CLI de contas Claude, para o wrapper de shell chamar.

Mesma razão de existir do hangar-engine: a regra mora num lugar SÓ. O backend importa app.contas
direto; o shell não pode (não tem venv), então chama este script com o python3 do sistema.

  hangar-conta --list                    -> um nome de conta por linha
  hangar-conta --prep <nome> [<projeto>] -> refaz os atalhos e imprime o caminho do config dir;
                                            com o projeto (a pasta já saneada), liga a memória dele
  hangar-conta --new <nome>              -> cria a conta e imprime o caminho
"""
import sys
from pathlib import Path

# app.contas é stdlib pura (garantido por teste): importável sem instalar o backend.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "backend"))

from app import contas  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) == 2 and argv[1] in ("--help", "-h"):
        print(__doc__)
        return 0

    if len(argv) == 2 and argv[1] == "--list":
        for nome in contas.listar():
            print(nome)
        return 0

    if (len(argv) == 3 and argv[1] in ("--prep", "--new")) or (len(argv) == 4 and argv[1] == "--prep"):
        nome = argv[2]
        try:
            if argv[1] == "--new":
                print(contas.criar(nome))
            else:
                # O projeto vem saneado de quem chama (o lançador do Rust): a regra do
                # sanitize_cwd fica num lugar só. Sem ele, a varredura cobre os projetos conhecidos.
                for aviso in contas.reconciliar(nome, argv[3] if len(argv) == 4 else None):
                    print(f"hangar-conta: {aviso}", file=sys.stderr)
                print(contas.caminho(nome))
        except contas.ContaError as e:
            print(f"hangar-conta: {e.detail}", file=sys.stderr)
            return 1
        return 0

    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv))
    except OSError as e:
        # Mesma borda do hangar-engine: traceback aqui vazaria pro usuario errado (o wrapper de shell).
        print(f"hangar-conta: falha ao executar: {e}", file=sys.stderr)
        sys.exit(126)
